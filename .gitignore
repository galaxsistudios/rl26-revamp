# Whitelist: ignore everything, then allow only mods/, tools/ and the stats submodule.
# Anything extracted, decompiled, built or backed up from the game stays local.
/*
!/.gitignore
!/mods/
!/tools/
!/.gitmodules
!/rl26-revamped-stats
# kits captured or painted for rll4-legacy-kits (top/shorts/socks.png, preview,
# export.json): small, and the only copy of each capture; and the community
# RLL4-layout jerseys as lossless PNG (the .dds originals stay local, *.dds below)
!/resources/
/resources/*
!/resources/custom-kits/
!/resources/old-jerseys/

# Python caches
__pycache__/
*.pyc

# Game-derived binary assets (extracted/edited retail textures)
*.dds
revamp_install.json
_captures/
