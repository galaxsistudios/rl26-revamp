<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"      
	xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
	xmlns:paEx="clr-namespace:paNoesisExtensions" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
	xmlns:GenericControls="clr-namespace:GenericControls"
    xmlns:controls="clr-namespace:Workspace.Controls">

    <!-- Merged Dictionaries -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls/baScreenControl.xaml"/>
        <ResourceDictionary Source="Controls/baFillControl.xaml"/>
        <ResourceDictionary Source="Controls/BackgroundControl.xaml"/>
        <ResourceDictionary Source="Controls/ScrollingControl.xaml"/>
        <ResourceDictionary Source="Controls/AnimatedItemsControl.xaml"/>
        <ResourceDictionary Source="TooltipIcons/XboxOne.xaml"/>
        <ResourceDictionary Source="TooltipIcons/PS4.xaml"/>
        <ResourceDictionary Source="TooltipIcons/PS5.xaml"/>
        <ResourceDictionary Source="TooltipIcons/NintendoSwitch.xaml"/>
        <ResourceDictionary Source="TooltipIcons/PC.xaml"/>
        <ResourceDictionary Source="Styles/DefaultStyles_BigAnt.xaml"/>
        <ResourceDictionary Source="Styles/TextStyles_BigAnt.xaml"/>
        <ResourceDictionary Source="Styles/Style_Tooltips.xaml"/>
        <ResourceDictionary Source="StyleThemes/NoesisTheme.Brushes.DarkBlue.xaml"/>
        <!--<ResourceDictionary Source="StyleThemes/NoesisTheme.Colors.Dark.xaml"/>
        <ResourceDictionary Source="StyleThemes/NoesisTheme.DarkBlue.xaml"/>-->
        <ResourceDictionary Source="HUDCommonStyles.xaml"/>
        <ResourceDictionary Source="PlatformIcons.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!-- Converter Definitions -->
    <paEx:paLocalisationConverter x:Key="localise"/>
    <paEx:paDynamicResourceConverter x:Key="dynamicResource"/>
    <paEx:paCompetitionLogoConverter x:Key="competitionLogoConverter"/>
    <paEx:paGridLengthConverter x:Key="GridLengthConverter"/>
    <paEx:paSecondsToTimeStringConverter x:Key="SecondsToTimeStringConverter"/>
    <paEx:paBackgroundToTextColourConverter x:Key="BackgroundToTextColourConverter"/>
    <!--<paEx:paBooleanToVisibilityInvertedConverter x:Key="BooleanToVisibilityInvertedConverter"/>-->
    <!-- <paEx:paLocaliseAndParseInlinesConverter x:Key="localiseAndParseInlinesConverter"/> -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <paEx:paBooleanToVisibilityConverter x:Key="BooleanToVisibilityConverterHidden"
                                         TrueValue="Visible"
                                         FalseValue="Hidden" />
    <paEx:paBooleanToVisibilityConverter x:Key="BooleanToVisibilityInvertedConverter"
                                         TrueValue="Collapsed"
                                         FalseValue="Visible" />
    <paEx:paUppercaseConverter x:Key="UppercaseConverter"/>
    <paEx:paComparisonMultiValueConverter x:Key="ComparisonMultiValueConverter"/>
    <paEx:paColorToSolidColorBrushValueConverter  x:Key="ColorToSolidColorBrushConverter" />
    <paEx:paCombiningConverter x:Key="UppercaseLocalise"
                               Converter1="{StaticResource localise}"
                               Converter2="{StaticResource UppercaseConverter}"/>
    <paEx:paStringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

    <!-- Safe Area Style Definition -->
    <Style TargetType="GenericControls:SafeArea">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GenericControls:SafeArea">
                    <Viewbox RenderTransformOrigin="0.5,0.5">
                        <Grid Margin="{TemplateBinding SafeMargin}">
                            <Viewbox RenderTransformOrigin="0.5,0.5">
                                <Canvas Height="1080" Width="1920">
                                    <Grid Height="1080" Width="1920">
                                        <Grid>
                                            <ContentPresenter Content="{TemplateBinding Content}"/>
                                        </Grid>
                                    </Grid>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="[Button Tabs]" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ControlTemplate.Resources>
                        <Geometry x:Key="UnderlineGeometry">M 0, 0 L 500, 0 z</Geometry>
                        <Storyboard x:Key="Button animation">
                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="ContentHost">
                                <EasingColorKeyFrame KeyTime="0" Value="White"/>
                                <EasingColorKeyFrame KeyTime="0:0:0.1" Value="#FF38C8E6"/>
                            </ColorAnimationUsingKeyFrames>
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid x:Name="LayoutRoot" Height="Auto" Width="Auto" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" Margin="0.002,0,0.001,0.174">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="ContentHost">
                                            <EasingColorKeyFrame KeyTime="0" Value="#FF38C8E6"/>
                                            <EasingColorKeyFrame KeyTime="0:0:0.1" Value="White"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <Storyboard AutoReverse="False">
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="ContentHost">
                                            <EasingColorKeyFrame KeyTime="0" Value="White"/>
                                            <EasingColorKeyFrame KeyTime="0:0:0.1" Value="#FF38C8E6"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentHost" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RenderTransformOrigin="0.5,0.5" Width="Auto" Margin="15,5,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Match_Options_Button" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontSize" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Opacity)" Storyboard.TargetName="Highlight">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Opacity)" Storyboard.TargetName="FrenchOpen_Highlight">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Opacity)" Storyboard.TargetName="MutuaMadrid_Highlight">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Opacity)" Storyboard.TargetName="HalleOpen_Highlight">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Opacity)" Storyboard.TargetName="ATPCup_Highlight">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Opacity)" Storyboard.TargetName="Bg">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver"/>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBox.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="ContentHost">
                                            <EasingColorKeyFrame KeyTime="0" Value="White"/>
                                            <EasingColorKeyFrame KeyTime="0:0:0.017" Value="#64808080"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="LayoutRoot" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False">
                            <Rectangle x:Name="Bg" Fill="#66000000" Stroke="#7FFFFFFF"/>
                            <Rectangle x:Name="Highlight" Opacity="0" Stroke="White" StrokeThickness="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="1.299,0.445" StartPoint="-0.336,0.445">
                                        <GradientStop Color="#FF073B6A" Offset="0"/>
                                        <GradientStop Color="#FF073B6A" Offset="1"/>
                                        <GradientStop Color="#FF0569C3" Offset="0.500"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="FrenchOpen_Highlight" Visibility="{Binding isFrenchOpen, FallbackValue=Hidden}" Opacity="0" Stroke="White" StrokeThickness="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="1.299,0.445" StartPoint="-0.336,0.445">
                                        <GradientStop Color="#FF004030" Offset="0"/>
                                        <GradientStop Color="#FF004030" Offset="1"/>
                                        <GradientStop Color="#FF00644B" Offset="0.500"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="MutuaMadrid_Highlight" Visibility="{Binding isMutuaMadridOpen, FallbackValue=Hidden}" Opacity="0" Stroke="White" StrokeThickness="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="1.299,0.445" StartPoint="-0.336,0.445">
                                        <GradientStop Color="#FFC35615" Offset="0"/>
                                        <GradientStop Color="#FFA64911" Offset="1"/>
                                        <GradientStop Color="#FFC35615" Offset="0.500"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="HalleOpen_Highlight" Visibility="{Binding isHalleOpen, FallbackValue=Hidden}" Opacity="0" Stroke="White" StrokeThickness="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="1.299,0.445" StartPoint="-0.336,0.445">
                                        <GradientStop Color="#FF006A3C" Offset="0"/>
                                        <GradientStop Color="#FF006A3C" Offset="1"/>
                                        <GradientStop Color="#FF006A3C" Offset="0.500"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="ATPCup_Highlight" Visibility="{Binding isATPCup, FallbackValue=Hidden}" Opacity="0" Stroke="White" StrokeThickness="2">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="1.299,0.445" StartPoint="-0.336,0.445">
                                        <GradientStop Color="Red" Offset="0"/>
                                        <GradientStop Color="#FFA64911" Offset="1"/>
                                        <GradientStop Color="Red" Offset="0.500"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="ContentHost" 
                                        DataContext="{TemplateBinding Content}" Text="{Binding Converter={StaticResource localise}, TargetNullValue=Content}" Foreground="White" RenderTransformOrigin="0.5,0.5" TextAlignment="Center" 
                                       FontSize="{TemplateBinding FontSize}" Margin="0,10" Padding="0,12,0,0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrainingTileContentHolder" TargetType="{x:Type ListBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <StackPanel
							IsItemsHost="True"
							Orientation="Vertical"
							IsEnabled="True"
							ScrollViewer.CanContentScroll="False"
							KeyboardNavigation.DirectionalNavigation="Cycle"
						/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="PlayerIndicatorControl">
        <Canvas>
            <Canvas>
                <Grid Height="42" Width="42" Canvas.Left="{Binding XPos}" Canvas.Top="{Binding YPos}">
                    <Ellipse Stroke="White">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding Colour}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock TextWrapping="Wrap" FontSize="24" TextAlignment="Center" Text="{Binding Label}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Canvas>
        </Canvas>
    </ControlTemplate>

    <!-- Inventory Slot Template -->
    <ControlTemplate x:Key="CardListItemTemplate" TargetType="{x:Type ListBoxItem}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="Card_Small_Selected">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="BG_Highlight">
                    <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="Card_Small_Unselected">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="BG_Highlight">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
        <Grid x:Name="Card_Small" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Rectangle x:Name="BG_Standard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RadiusX="5" RadiusY="5" Opacity="0.5">
                <Rectangle.Fill>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF2B2B2B" Offset="0"/>
                        <GradientStop Color="#FF1F1D1D" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="BG_Outline" Stroke="#FF0F0F0F" StrokeThickness="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RadiusX="5" RadiusY="5" Opacity="0.5"/>
            <Rectangle x:Name="BG_Highlight" Stroke="White" StrokeThickness="4" Margin="-3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0" RadiusX="5" RadiusY="5"/>
            <Grid x:Name="Opacity_Grid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="{Binding MasterOpacity}">
                <Grid x:Name="Inactive_Grid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid Margin="0" Width="75" Height="75">
                        <Canvas VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,55,55" Visibility="Hidden">
                            <Ellipse HorizontalAlignment="Left" Height="53.333" VerticalAlignment="Top" Width="53.334" Stroke="#4CFFFFFF" StrokeThickness="0.5" Fill="#33000000"/>
                            <Path Fill="White" HorizontalAlignment="Left" Height="15.166" StrokeThickness="0.5" VerticalAlignment="Top" Data="M4.5916441,-5.256618E-18 L5.8243555,5.256618E-18 5.8243555,4.5916498 10.415999,4.5916498 10.415999,5.82435 5.8243555,5.82435 5.8243555,10.415999 4.5916441,10.415999 4.5916441,5.82435 -5.2569647E-18,5.82435 5.2569647E-18,4.5916498 4.5916441,4.5916498 z" RenderTransformOrigin="0.500000006225985,0.500000028200048" Stretch="Fill" Width="15.165" Opacity="0.3" Canvas.Left="19.086" Canvas.Top="19.054">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="90"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Grid>
                </Grid>
                <Grid x:Name="Active_Grid"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Visible">
                    <Grid x:Name="Backgrounds_Grid" Margin="7.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Rectangle x:Name="Image_Type_BG" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Binding_Image_Type_BG}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Image_Club_BG" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Binding_Club_BG_Image}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Centre_Image" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,10">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Binding_Centre_Image}" Stretch="Uniform"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <Grid x:Name="Foreground_Grid" Margin="7.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.025*"/>
                            <ColumnDefinition Width="0.275*"/>
                            <ColumnDefinition Width="0.410*"/>
                            <ColumnDefinition Width="0.275*"/>
                            <ColumnDefinition Width="0.015*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.025*"/>
                            <RowDefinition Height="0.2*"/>
                            <RowDefinition Height="0.64*"/>
                            <RowDefinition Height="0.175*"/>
                            <RowDefinition Height="0.05*"/>
                        </Grid.RowDefinitions>
                        <Rectangle x:Name="Favourite_Icon" Visibility="{Binding Binding_Player_FavouriteVisibility}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Binding_Player_Favourite_Icon}" Stretch="Uniform" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Grid x:Name="Duplicate_Count_Section" Visibility="{Binding Binding_DuplicateSectionVisibility}" Grid.Column="3" Grid.Row="1" >
                            <Rectangle x:Name="Duplciate_Background" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Binding_DuplicateBg_Image}" Stretch="Uniform"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="Duplicate_Text" Text="{Binding Binding_DuplicateText, FallbackValue=88}" Padding="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Foreground="White" Style="{DynamicResource HeaderMidStyle}" FontSize="8"/>
                        </Grid>
                    </Grid>
                    <!--<TextBlock x:Name="CardSeriesText" Text="{Binding Binding_Card_Series, FallbackValue=2023 BIG ANT LEAGUE}" Padding="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" TextAlignment="Center" Foreground="Black" Style="{DynamicResource DataMidStyle}" FontSize="5"/>-->
                    <Grid x:Name="Overall_Grid" Margin="5,20,0,50" Visibility="{Binding Binding_PlayerStats_Visibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.05*"/>
                            <ColumnDefinition Width="0.2*"/>
                            <ColumnDefinition Width="0.75*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.25*"/>
                            <RowDefinition Height="0.2*"/>
                            <RowDefinition Height="0.3*"/>
                            <RowDefinition Height="0.25*"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="Player_OverallNumber_Area" Grid.Column="1" Grid.Row="0" Margin="0,0,0,0" MinHeight="10">
                            <TextBlock x:Name="Player_OverallNumber" Text="{Binding Binding_Player_Overall, FallbackValue=55}" Padding="0,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" TextAlignment="Center" Foreground="Black" Style="{DynamicResource HeaderMidStyle}" FontSize="18"/>
                        </Grid>
                        <Grid x:Name="Player_PositionText_Area" Grid.Column="1" Grid.Row="1" Margin="0,0,0,0" MinHeight="6">
                            <TextBlock x:Name="Player_PositionText" Text="{Binding Binding_Player_Position, FallbackValue=FWD}" Padding="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" TextAlignment="Center" Foreground="Black" Style="{DynamicResource HeaderSmallStyle}" FontSize="9"/>
                        </Grid>
                        <Grid Grid.Column="1" Grid.Row="2" Margin="0,0,0,0" MinHeight="8">
                            <Rectangle x:Name="Player_Shield_Icon">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Binding_Club_Image}" Stretch="Uniform"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <Grid Grid.Column="1" Grid.Row="3" Margin="0,0,0,0" MinHeight="8">
                            <Rectangle x:Name="Player_Archetype_Icon">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Binding_Player_Archetype_Icon}" Stretch="Uniform"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <Grid x:Name="Contracts_Grid" Margin="0,0,0,8" VerticalAlignment="Bottom" Visibility="{Binding Binding_ContractsInfo_Visibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.05*"/>
                            <ColumnDefinition Width="0.3*"/>
                            <ColumnDefinition Width="0.3*"/>
                            <ColumnDefinition Width="0.3*"/>
                            <ColumnDefinition Width="0.05*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.1*"/>
                            <RowDefinition Height="0.2*"/>
                            <RowDefinition Height="0.7*"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="Bronze_Uses_Bar" Grid.Column="1" Grid.Row="1" Margin="5,0,5,0" MinHeight="5">
                            <Rectangle Fill="#FF695032"/>
                        </Grid>
                        <Grid x:Name="Bronze_Uses_Text" Grid.Column="1" Grid.Row="2" Margin="0,0,0,0" MinHeight="12">
                            <TextBlock x:Name="BronzeUsesText" Text="{Binding Binding_Bronze_Contracts, FallbackValue=5}" Padding="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" TextAlignment="Center" Foreground="Black" Style="{DynamicResource DataSmallStyle}" FontSize="12"/>
                        </Grid>
                        <Grid x:Name="Gold_Uses_Bar" Grid.Column="2" Grid.Row="1" Margin="5,0,5,0" MinHeight="5">
                            <Rectangle Fill="#FFD2AF73"/>
                        </Grid>
                        <Grid x:Name="Gold_Uses_Text" Grid.Column="2" Grid.Row="2" Margin="0,0,0,0" MinHeight="12">
                            <TextBlock x:Name="GoldUsesText" Text="{Binding Binding_Gold_Contracts, FallbackValue=5}" Padding="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" TextAlignment="Center" Foreground="Black" Style="{DynamicResource DataSmallStyle}" FontSize="12"/>
                        </Grid>
                        <Grid x:Name="Emerald_Uses_Bar" Grid.Column="3" Grid.Row="1" Margin="5,0,5,0" MinHeight="5">
                            <Rectangle Fill="#FF00827D"/>
                        </Grid>
                        <Grid x:Name="Emerald_Uses_Text" Grid.Column="3" Grid.Row="2" Margin="0,0,0,0" MinHeight="12">
                            <TextBlock x:Name="EmeraldUsesText" Text="{Binding Binding_Emerald_Contracts, FallbackValue=5}" Padding="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" TextAlignment="Center" Foreground="Black" Style="{DynamicResource DataSmallStyle}" FontSize="12"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding CardHighlighted}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource Card_Small_Selected}"/>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource Card_Small_Unselected}"/>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Inventory Slot Style -->
    <Style x:Key="CardListItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Template" Value="{StaticResource CardListItemTemplate}"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsEnabled" Value="True"/>
        <Setter Property="Margin" Value="5,9,5,10"/>
        <Setter Property="MinHeight" Value="147.5"/>
        <Setter Property="noesis:StyleInteraction.Triggers">
            <Setter.Value>
                <noesis:StyleTriggerCollection>
                    <b:EventTrigger EventName="MouseEnter">
                        <noesis:SetFocusAction/>
                    </b:EventTrigger>
                </noesis:StyleTriggerCollection>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardListItemStyle_Hover" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Template" Value="{StaticResource CardListItemTemplate}"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsEnabled" Value="True"/>
        <Setter Property="MinHeight" Value="135"/>
        <Setter Property="noesis:StyleInteraction.Triggers">
            <Setter.Value>
                <noesis:StyleTriggerCollection>
                    <b:EventTrigger EventName="MouseEnter">
                        <noesis:SetFocusAction/>
                    </b:EventTrigger>
                </noesis:StyleTriggerCollection>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="Panel_Button" TargetType="{x:Type Button}">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Base">
                                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Outline">
                                <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.017" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="Base">
                                <EasingColorKeyFrame KeyTime="0" Value="#FF0569C3"/>
                                <EasingColorKeyFrame KeyTime="0:0:0.017" Value="#80000000"/>
                            </ColorAnimationUsingKeyFrames>
                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="Outline">
                                <EasingColorKeyFrame KeyTime="0" Value="White"/>
                                <EasingColorKeyFrame KeyTime="0:0:0.017" Value="White"/>
                            </ColorAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.StrokeThickness)" Storyboard.TargetName="Outline">
                                <EasingDoubleKeyFrame KeyTime="0" Value="2"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.017" Value="2"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Outline">
                                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.017" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Base">
                                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.017" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Base_Copy">
                                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.017" Value="100"/>
                            </DoubleAnimationUsingKeyFrames>
                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="Base_Copy">
                                <EasingColorKeyFrame KeyTime="0" Value="Black"/>
                                <EasingColorKeyFrame KeyTime="0:0:0.017" Value="#FF0569C3"/>
                            </ColorAnimationUsingKeyFrames>
                            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="Outline">
                                <EasingColorKeyFrame KeyTime="0" Value="White"/>
                                <EasingColorKeyFrame KeyTime="0:0:0.017" Value="White"/>
                            </ColorAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.StrokeThickness)" Storyboard.TargetName="Outline">
                                <EasingDoubleKeyFrame KeyTime="0" Value="2"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.017" Value="2"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Rectangle x:Name="Base" Fill="#7F000000" Height="Auto" Stroke="{x:Null}" VerticalAlignment="Stretch" Width="Auto"/>
            <Rectangle x:Name="Base_Copy" Height="Auto" Stroke="{x:Null}" VerticalAlignment="Stretch" Width="Auto" Opacity="0" Fill="Black"/>
            <Rectangle x:Name="Outline" Fill="{x:Null}" Height="Auto" Stroke="#FF48A4FF" VerticalAlignment="Stretch" Width="Auto" Opacity="0"/>
        </Grid>
    </ControlTemplate>


    <ControlTemplate x:Key="_ListBoxItemTemplate" TargetType="ListBoxItem">
        <Border Name="_Border" Padding="0" BorderThickness="2" SnapsToDevicePixels="true" Background="Transparent">
            <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="_Border" Property="Background" Value="{Binding HighlightBackgroundColour, FallbackValue=#FF0569C3}"/>
                <Setter TargetName="_Border" Property="BorderBrush" Value="White"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="false">
                <Setter TargetName="_Border" Property="Background" Value="{x:Null}"/>
                <Setter TargetName="_Border" Property="BorderBrush" Value="{x:Null}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="_ListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="noesis:StyleInteraction.Triggers">
            <Setter.Value>
                <noesis:StyleTriggerCollection>
                    <b:DataTrigger Binding="{TemplateBinding ListBoxItem.IsSelected}" Value="True">
                        <noesis:SetFocusAction/>
                    </b:DataTrigger>
                </noesis:StyleTriggerCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="Template" Value="{StaticResource _ListBoxItemTemplate}"/>
        <Setter Property="Margin" Value="5,0,5,0"/>
    </Style>

    <ControlTemplate x:Key="_ListBoxItemTemplateSolid" TargetType="ListBoxItem">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="Focused"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="MouseOver"/>
                    <VisualState x:Name="Pressed"/>
                    <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Unselected">
                    </VisualState>
                    <VisualState x:Name="Selected"/>
                    <VisualState x:Name="SelectedUnfocused">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Opacity)" Storyboard.TargetName="Highlight">
                                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Rectangle x:Name="BackgroundColour" Fill="Black" Opacity="{Binding m_backgroundOpacity, Mode=OneWay, FallbackValue=1}" />
            <Rectangle x:Name="Highlight" Fill="#FF0569C3" Stroke="White" StrokeThickness="3" Opacity="0"/>
            <ContentPresenter/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="_ListBoxItemSolidStyle" TargetType="ListBoxItem">
        <Setter Property="noesis:StyleInteraction.Triggers">
            <Setter.Value>
                <noesis:StyleTriggerCollection>
                    <b:DataTrigger Binding="{TemplateBinding ListBoxItem.IsSelected}" Value="True">
                        <noesis:SetFocusAction/>
                    </b:DataTrigger>
                </noesis:StyleTriggerCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="Template" Value="{StaticResource _ListBoxItemTemplateSolid}"/>
        <Setter Property="Margin" Value="5,0,5,0"/>
    </Style>

    <!-- Slider -->
    <ControlTemplate x:Key="SliderThumbHorizontalTop" TargetType="{x:Type Thumb}">
        <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center">
            <Path x:Name="grip" Data="M 0,6 C0,6 5.5,0 5.5,0 5.5,0 11,6 11,6 11,6 11,18 11,18 11,18 0,18 0,18 0,18 0,6 0,6 z" Fill="{StaticResource SliderThumb.Static.Background}" Stretch="Fill" SnapsToDevicePixels="True" Stroke="{StaticResource SliderThumb.Static.Border}" StrokeThickness="1" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Fill" TargetName="grip" Value="{StaticResource SliderThumb.MouseOver.Background}"/>
                <Setter Property="Stroke" TargetName="grip" Value="{StaticResource SliderThumb.MouseOver.Border}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="true">
                <Setter Property="Fill" TargetName="grip" Value="{StaticResource SliderThumb.Pressed.Background}"/>
                <Setter Property="Stroke" TargetName="grip" Value="{StaticResource SliderThumb.Pressed.Border}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Fill" TargetName="grip" Value="{StaticResource SliderThumb.Disabled.Background}"/>
                <Setter Property="Stroke" TargetName="grip" Value="{StaticResource SliderThumb.Disabled.Border}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="SliderThumbHorizontalBottom" TargetType="{x:Type Thumb}">
