    <ControlTemplate x:Key="SliderThumbHorizontalDefault" TargetType="{x:Type Thumb}">
        <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center" Margin="0,7,0,-7">
            <Path x:Name="grip" Data="M0,0 C0,0 11,0 11,0 11,0 5.4851642,17.810849 5.4851642,17.810849 5.4851642,17.810849 0,0 0,0 z" Fill="#FF5B608A" Stretch="Fill" SnapsToDevicePixels="True" StrokeThickness="1" VerticalAlignment="Center" Height="11" Margin="0,3,0,4"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
