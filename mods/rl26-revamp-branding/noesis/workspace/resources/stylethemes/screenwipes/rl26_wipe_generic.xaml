<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    
    <!--Wipe Colors-->
    <Color x:Key="Color.Wipe.Primary">#000000</Color>
    <Color x:Key="Color.Wipe.Secondary">#1E6FD9</Color>
    <Color x:Key="Color.Wipe.Tertiary">#ffffff</Color>
    <Color x:Key="Color.Wipe.Quaternary">#000000</Color>
    
    <!--Wipe Image Sources-->
    <ImageSource x:Key="CenterLogo">../../../Images/WipeThemes/rll_logo.png</ImageSource>
    <ImageBrush x:Key="CenterLogoBrush" ImageSource="{StaticResource CenterLogo}" Stretch="Uniform"/>

    <!--Wipe Brushes-->
    <SolidColorBrush x:Key="WipePrimaryFillColorBrush" Color="{StaticResource Color.Wipe.Primary}"/>
    <SolidColorBrush x:Key="WipeSecondaryFillColorBrush" Color="{StaticResource Color.Wipe.Secondary}"/>
    <SolidColorBrush x:Key="WipeTertiaryFillColorBrush" Color="{StaticResource Color.Wipe.Tertiary}"/>
    <SolidColorBrush x:Key="WipeQuaternaryFillColorBrush" Color="{StaticResource Color.Wipe.Quaternary}"/>

    <ControlTemplate TargetType="Control" x:Key="LeftAccent" />
    <ControlTemplate TargetType="Control" x:Key="RightAccent" />
</ResourceDictionary>