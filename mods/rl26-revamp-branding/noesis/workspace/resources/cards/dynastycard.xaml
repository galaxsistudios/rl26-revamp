    <!--#endregion-->

    <!--#region Card details templates -->

    <DataTemplate x:Key="EmptyLayout"
                  x:Name="EmptyLayout">
    </DataTemplate>

    <!--
        Basic layout:
        card back
        card item
        card frame
    -->
    <DataTemplate x:Key="BasicLayout"
                  x:Name="BasicLayout">
        <Canvas Width="416"
                Height="650">
            <Image Width="416"
                   Height="650"
                   Source="{Binding CardData.CardBackImage}" />
            <Image Width="416"
                   Height="650"
                   Source="{Binding CardData.ItemImage}" />
            <Image Width="416"
                   Height="650"
                   Source="{Binding CardData.CardFrameImage}" />
        </Canvas>
    </DataTemplate>

    <!--
        Basic layout:
        card back
        card item
        card frame
    -->
    <DataTemplate x:Key="BasicLayoutSmall"
                  x:Name="BasicLayoutSmall">
        <Viewbox Width="100"
                 Height="148">
            <Grid Width="432"
                  Height="632">
                <Image Source="{Binding CardData.CardBackImage}"
                       Clip="{StaticResource MaskBackingPath}" />
                <Grid>
                    <Image  Source="{Binding CardData.PlayerImage}" />
                </Grid>
                <!--<Image  Width="432" Height="632" Source="{Binding CardData.CardFrameImage}" Clip="{StaticResource MaskFramePath}"/>-->
                <!--Left roles-->
                <!-- For Testing against the blank cards.-->
                <Grid Name="Roles"
                      Height="60"
                      Width="432"
                      Margin="0 -50 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="FieldRoleText"
                               Grid.Column="0"
                               d:Text="F-ROLE"
                               Text="{Binding FieldRoleAbbr}"
                               Style="{StaticResource Display_XL}"
                               VerticalAlignment="Center"
                               Foreground="White"
                               TextAlignment="Center"
                               Padding="5,0,5,0"
                               Visibility="{Binding ShowFieldRoles, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue='Hidden'}">
                        <TextBlock.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="#00FFFFFF" />
                                <GradientStop Color="#33FFFFFF"
                                              Offset="0.5" />
                                <GradientStop Color="#00FFFFFF"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Background>
                    </TextBlock>

                    <TextBlock Name="AssignedRoleText"
                               Grid.Column="1"
                               Style="{StaticResource Display_XL}"
                               d:Text="A-ROLE"
                               Text="{Binding AssignedRoleAbbr}"
                               Foreground="Black"
                               TextAlignment="Center"
                               Padding="5,0,5,0"
                               Visibility="{Binding ShowAssignedRoles, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue='Hidden'}" />
                </Grid>
            </Grid>
        </Viewbox>
    </DataTemplate>

    <!--
        Player layout:
        first and last name text
        role text
        skill names and values text
        overall value text
        
        club icon
        archetype icon
    -->
    <DataTemplate x:Key="PlayerLayout"
                  x:Name="PlayerLayout">
        <Grid x:Name="PlayerCanvas"
              Width="432"
              Height="632">
            <Grid.Resources>
                <Style x:Key="OVRStyle"
                       TargetType="TextBlock"
                       BasedOn="{StaticResource ProTeamCardOVR}">
                    <Setter Property="Foreground"
                            Value="{Binding CardData.TextColour, Converter={StaticResource ColorToSolidColorBrushConverter}}" />
                    <Setter Property="Effect"
                            Value="{StaticResource DropShadowEffect}" />
                    <!--<Setter Property="FontSize" Value="75"/>-->
                </Style>
                <Style x:Key="RoleLargeStyle"
                       TargetType="TextBlock"
                       BasedOn="{StaticResource ProTeamCardRole}">
                    <Setter Property="Foreground"
                            Value="White" />
                    <Setter Property="Effect"
                            Value="{StaticResource DropShadowEffect}" />
                    <!--<Setter Property="FontSize" Value="25"/>-->
                </Style>
                <Style x:Key="StatsVal"
                       TargetType="TextBlock"
                       BasedOn="{StaticResource ProTeamCardStats}">
                    <Setter Property="Foreground"
                            Value="{Binding CardData.TextColour, Converter={StaticResource ColorToSolidColorBrushConverter}}" />
                    <Setter Property="Effect"
                            Value="{StaticResource DropShadowEffect}" />
                    <!--<Setter Property="FontSize" Value="28"/>-->
                </Style>
                <Style x:Key="StatsText"
                       TargetType="TextBlock"
                       BasedOn="{StaticResource ProTeamCardStatsSubtitle}">
