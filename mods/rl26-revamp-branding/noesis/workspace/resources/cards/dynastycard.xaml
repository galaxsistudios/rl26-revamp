                        </DataTrigger>
                        <DataTrigger Binding="{Binding CardType}"
                                     Value="{x:Static enums:DynastyCardTemplateTypes.rewardSmall}">
                            <Setter Property="ContentTemplate"
                                    Value="{StaticResource RewardSmallLayout}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </DataTemplate>
</ResourceDictionary>