    <!--
		Stadium card small Layout:
		Stadium Name
	-->
    <DataTemplate x:Key="StadiumLayout"
                  x:Name="StadiumLayout">


        <Grid Width="432"
              Height="632">
            <!-- Card background, item image, frame -->
            <Path Data="{StaticResource MaskBackingPath}">
                <Path.Fill>
                    <ImageBrush ImageSource="{Binding CardData.CardBackImage}" />
                </Path.Fill>
            </Path>

            <Grid Clip="{StaticResource MaskBackingPath}">

                <Image Source="{Binding CardData.ItemImage}"
                       Clip="{StaticResource StadiumClippingPath}" />
            </Grid>
            <Path  Data="{StaticResource MaskFramePath}">
                <Path.Fill>
                    <ImageBrush ImageSource="{Binding CardData.CardFrameImage}" />
                </Path.Fill>
            </Path>

            <!-- Stadium name text-->
            <StackPanel HorizontalAlignment="Left"
                        Margin="35,100">
                <Image Source="{Binding CardData.ItemIcon}"
                       Width="50"
                       Height="50"
                       Visibility="Collapsed" />
                <StackPanel RenderTransformOrigin="0.5,0.5"
                            VerticalAlignment="Center"
                            Margin="0,10">
                    <TextBlock Name="StadiumName"
                               TextWrapping="WrapWithOverflow"
                               Width="200"
                               Margin="0,5,0,0"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="20"
                               Style="{StaticResource ProTeamCardFirstName}"
                               d:Text="StadiumName"
                               Text="{Binding CardData.DescriptionString, Converter={StaticResource UppercaseConverter}}"
                               Effect="{StaticResource DropShadowEffect}" />
                    <StackPanel.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </StackPanel.LayoutTransform>
