    <DataTemplate x:Key="MTConsumable"
                  x:Name="MTConsumable">
        <Grid Width="432"
              Height="632">
            <!-- Card background, item image, frame -->
            <Image Source="{Binding CardData.CoinImage}" />

            <Grid VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- Value text -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,20">
                    <TextBlock Grid.Column="0"
                               Name="ValueText"
                               d:Text="2222"
                               Text="{Binding CardData.Value}"
                               VerticalAlignment="Center"
                               FontSize="50"
                               Margin="10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource Display_L}">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="White"
                                                          ShadowDepth="0"
                                                          BlurRadius="15"
                                                          Opacity="0" />
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                 Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SB">
                                                <Storyboard AutoReverse="True"
                                                            RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Effect).(DropShadowEffect.Opacity)"
                                                                     From="0"
                                                                     To="0.7"
                                                                     Duration="0:0:0.7" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>

                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SB" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Image Grid.Column="2"
                           Margin="10,0"
                           Source="{Binding CardData.TypeImage}"
                           Width="90"
                           Height="90" />
                </StackPanel>

                <StackPanel VerticalAlignment="Top"
                            Grid.Row="1"
                            HorizontalAlignment="Center">
                    <!-- Price text -->
                    <!--BasePrice-->
                    <Grid Visibility="{Binding CardData.IsOnSale, Converter={StaticResource BooleanToVisibilityConverter}}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="0,0,20,0"
                          Opacity="0.6">
                        <TextBlock Name="BasePriceText"
                                   Style="{StaticResource DynastyBold}"
                                   d:Text="22.55AUD"
                                   Text="{Binding CardData.BasePrice}"
                                   FontSize="22"
                                   Foreground="White" />
                        <Rectangle Fill="White"
                                   Height="2"
                                   Margin="0,2.5,0,0" />
                    </Grid>
                    <TextBlock Name="PriceText"
                               Style="{StaticResource DynastyBold}"
                               d:Text="12.23AUD"
                               Text="{Binding CardData.Price}"
                               FontSize="36"
                               Foreground="White" />
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

