    <DataTemplate x:Key="DynastyShards">
        <ItemsControl ItemsSource="{Binding DynastyShards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <DataTemplate.Resources>
                        <SineEase x:Key="Ease"
                                     EasingMode="EaseInOut" />

                        <Storyboard x:Key="ShardUnlock"   Duration="0:0:06">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="effect" Storyboard.TargetProperty="Brightness">
                                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.3" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="0" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="0.3"  EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:2.4" Value="0" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:2.7" Value="0.3"  EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.0" Value="0" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.2" Value="0.3"  EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="0" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.7" Value="0.3"  EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.9" Value="0" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:4.3" Value="0.3"  EasingFunction="{StaticResource Ease}"/>
                            </DoubleAnimationUsingKeyFrames> 
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="effect" Storyboard.TargetProperty="Saturation">
                                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1.6" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="1.6"  EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:2.4" Value="1" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:2.7" Value="1.6"  EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.0" Value="1" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.2" Value="1.6"  EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="1" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.7" Value="1.6"  EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:3.9" Value="1" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:4.3" Value="1.6"  EasingFunction="{StaticResource Ease}"/>
                            </DoubleAnimationUsingKeyFrames> 
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shard"
                                                           Storyboard.TargetProperty="Opacity">
                                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:4.3" Value="1"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:4.7" Value="0" EasingFunction="{StaticResource Ease}" /> 
                            </DoubleAnimationUsingKeyFrames> 
                        </Storyboard>

                        <Storyboard x:Key="ShardDuplicate">  
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="effect" Storyboard.TargetProperty="Saturation">
                                <EasingDoubleKeyFrame KeyTime="0" Value="0"/> 
                            </DoubleAnimationUsingKeyFrames>
                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ShardRoot" Storyboard.TargetProperty="(Grid.Effect).(noesis:TintEffect.Color)">
                                <EasingColorKeyFrame KeyTime="0"
                                                     Value="#ff8a00"/> 
                            </ColorAnimationUsingKeyFrames> 
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shard"
                                                           Storyboard.TargetProperty="Opacity">
                                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>  
                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>  
                                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0.9" EasingFunction="{StaticResource Ease}"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0" EasingFunction="{StaticResource Ease}" />  
                                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="0" EasingFunction="{StaticResource Ease}" />  
                                <EasingDoubleKeyFrame KeyTime="0:0:2.0" Value="0.9" EasingFunction="{StaticResource Ease}" />  
                                <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="0" EasingFunction="{StaticResource Ease}" />  
                                <EasingDoubleKeyFrame KeyTime="0:0:2.8" Value="0" EasingFunction="{StaticResource Ease}" />  
                                <EasingDoubleKeyFrame KeyTime="0:0:3.3" Value="0.9" EasingFunction="{StaticResource Ease}" />  
                                <EasingDoubleKeyFrame KeyTime="0:0:3.8" Value="0" EasingFunction="{StaticResource Ease}" />  
                            </DoubleAnimationUsingKeyFrames> 
                        </Storyboard>
                    </DataTemplate.Resources>
                    <Grid Visibility="{Binding Visibility}" x:Name="ShardRoot">
                        
                        <Image x:Name="Shard"
                               Source="{Binding TextureSource}">
                            <Image.Effect>
                                <Extensions:paAdjustmentEffect x:Name="effect"/>
                            </Image.Effect>
                        </Image>

                        <Grid.Effect>
                            <noesis:TintEffect  x:Name="tinteffect" Color="White"/>
                        </Grid.Effect>
                        <!--<Label Content="{Binding IsUnlockedFirstTime}" />-->
                        <b:Interaction.Triggers>
                            <b:DataTrigger Binding="{Binding IsUnlockedFirstTime}"
                                           Value="True">
                                <b:ControlStoryboardAction Storyboard="{StaticResource ShardUnlock}" ControlStoryboardOption="Play"/>
                            </b:DataTrigger>
                            <b:DataTrigger Binding="{Binding IsWholeCardUnlockedFirstTime}"
                                           Value="True">
                                <b:ControlStoryboardAction Storyboard="{StaticResource ShardUnlock}" ControlStoryboardOption="Play"/>
                            </b:DataTrigger>
                            <b:DataTrigger Binding="{Binding DuplicateAddInProgress}"
                                           Value="True">
                                <b:ControlStoryboardAction Storyboard="{StaticResource ShardDuplicate}" ControlStoryboardOption="Play"/>
                            </b:DataTrigger>
                        </b:Interaction.Triggers>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

