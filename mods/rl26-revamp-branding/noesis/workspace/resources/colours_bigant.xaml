<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d">

    <!-- ALL COLOURS AND SOLIDCOLORBRUSHES TO BE DEFINED HERE -->


    <!--RUGBY LEAGUE-->
    <Color x:Key="RLWhiteCol">#FFFDF5FC</Color>
    <Color x:Key="RLWhite80Col">#B2FDF5FC</Color>
    <Color x:Key="RLWhite70Col">#B2FDF5FC</Color>
    <Color x:Key="RLWhite50Col">#80FDF5FC</Color>
    <Color x:Key="RLWhite30Col">#4CFDF5FC</Color>
    <Color x:Key="RLWhite05Col">#0CFDF5FC</Color>
    <Color x:Key="RLBlackCol">#FF080808</Color>
    <Color x:Key="RLBlack30Col">#4C080808</Color>
    <Color x:Key="RLBlack50Col">#7F080808</Color>
    <Color x:Key="RLBlack70Col">#B2080808</Color>
    <Color x:Key="RLBlack80Col">#CC080808</Color>
    <Color x:Key="RLBlack90Col">#E5080808</Color>
    <Color x:Key="RLGreenCol">#FF1E6FD9</Color>
    <Color x:Key="RLGreen10Col">#1A1E6FD9</Color>
    <Color x:Key="RLDarkGreenCol">#FF0C2E59</Color>
    <Color x:Key="ButtonBorderBrushCol">#FF303030</Color>
    <Color x:Key="DynastyGoldCol">#DEB06B</Color>
    <Color x:Key="DynastyPurpleCol">#7617E9</Color>
    <Color x:Key="BATransparentCol">#00000000</Color>

    <SolidColorBrush x:Key="RLWhite"
                     Color="{StaticResource RLWhiteCol}" />
    <SolidColorBrush x:Key="RLWhite80"
                     Color="{StaticResource RLWhiteCol}"
                     Opacity="0.8" />
    <SolidColorBrush x:Key="RLWhite70"
                     Color="{StaticResource RLWhite70Col}" />
    <SolidColorBrush x:Key="RLWhite50"
                     Color="{StaticResource RLWhite50Col}" />
    <SolidColorBrush x:Key="RLWhite30"
                     Color="{StaticResource RLWhite30Col}" />
    <SolidColorBrush x:Key="RLWhite05"
                     Color="{StaticResource RLWhite05Col}" />
    <SolidColorBrush x:Key="RLBlack"
                     Color="{StaticResource RLBlackCol}" />
    <SolidColorBrush x:Key="RLBlack30"
                     Color="{StaticResource RLBlack30Col}" />
    <SolidColorBrush x:Key="RLBlack50"
                     Color="{StaticResource RLBlack50Col}" />
    <SolidColorBrush x:Key="RLBlack70"
                     Color="{StaticResource RLBlack70Col}" />
    <SolidColorBrush x:Key="RLBlack80"
                     Color="{StaticResource RLBlack80Col}" />
    <SolidColorBrush x:Key="RLBlack90"
                     Color="{StaticResource RLBlack90Col}" />
    <SolidColorBrush x:Key="RLGreen"
                     Color="{StaticResource RLGreenCol}" />
    <SolidColorBrush x:Key="RLGreen10"
                     Color="{StaticResource RLGreen10Col}" />
    <SolidColorBrush x:Key="RLDarkGreen"
                     Color="{StaticResource RLDarkGreenCol}" />
    <SolidColorBrush x:Key="ButtonBorderBrush"
                     Color="{StaticResource ButtonBorderBrushCol}" />
    <SolidColorBrush x:Key="DynastyGold"
                     Color="{StaticResource DynastyGoldCol}" />
    <SolidColorBrush x:Key="DynastyPurple"
                     Color="{StaticResource DynastyPurpleCol}" />

    <LinearGradientBrush x:Key="RLTextGradient"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="White"
                      Offset="0.45" />
        <GradientStop Color="#CECECE"
                      Offset="1" />
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="RLGradientV"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="{StaticResource RLGreenCol}"
                      Offset="0" />
        <GradientStop Color="{StaticResource RLDarkGreenCol}"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RLGradientH"
                         StartPoint="0,0.5"
                         EndPoint="1,0.5">
        <GradientStop Color="{StaticResource RLGreenCol}"
                      Offset="0" />
        <GradientStop Color="{StaticResource RLDarkGreenCol}"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DynastyGradient"
                         StartPoint="0,0.5"
                         EndPoint="1,0.5">
        <GradientStop Color="#F9CF94"
                      Offset="0" />
        <GradientStop Color="#C59343"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DynastyGradientVertical"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="#F9CF94"
                      Offset="0" />
        <GradientStop Color="#C59343"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DynastyGradientNew" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#926329" />
        <GradientStop Offset="0.1" Color="#BA812F" />
        <GradientStop Offset="0.3" Color="#D8B65C" />
        <GradientStop Offset="0.5" Color="#F2D4A0" />
        <GradientStop Offset="0.7" Color="#D8B65C" />
        <GradientStop Offset="0.9" Color="#BA812F" />
        <GradientStop Offset="1" Color="#926329" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DynastyGradientNewVertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#926329" />
        <GradientStop Offset="0.1" Color="#BA812F" />
        <GradientStop Offset="0.3" Color="#D8B65C" />
        <GradientStop Offset="0.5" Color="#F2D4A0" />
        <GradientStop Offset="0.7" Color="#D8B65C" />
        <GradientStop Offset="0.9" Color="#BA812F" />
        <GradientStop Offset="1" Color="#926329" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DynastyGradientHorizontalLineNew" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource BATransparentCol}" />
        <GradientStop Offset="0.1" Color="#BA812F" />
        <GradientStop Offset="0.3" Color="#D8B65C" />
        <GradientStop Offset="0.5" Color="#F2D4A0" />
        <GradientStop Offset="0.7" Color="#D8B65C" />
        <GradientStop Offset="0.9" Color="#BA812F" />
        <GradientStop Offset="1" Color="{StaticResource BATransparentCol}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DynastyPurpleOutline" StartPoint="0.4,0" EndPoint="0.6,1">
        <GradientStop Offset="0" Color="#7617E9" />
        <GradientStop Offset="0.2" Color="#47268B" />
        <GradientStop Offset="0.4" Color="#FF351775" />
        <GradientStop Offset="0.6" Color="#FF351775" />
        <GradientStop Offset="0.8" Color="#47268B" />
        <GradientStop Offset="1" Color="#7617E9" />
    </LinearGradientBrush>

    <!-- Scroll Bar -->
    <SolidColorBrush x:Key="ScrollBar.Static.Background"
                     Color="#F0F0F0" />
    <SolidColorBrush x:Key="ScrollBar.Static.Border"
                     Color="#F0F0F0" />
    <SolidColorBrush x:Key="ScrollBar.Static.Glyph"
                     Color="#606060" />
    <SolidColorBrush x:Key="ScrollBar.Static.Thumb"
                     Color="#CDCDCD" />
    <SolidColorBrush x:Key="ScrollBar.Pressed.Glyph"
                     Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb"
                     Color="#606060" />
    <SolidColorBrush x:Key="ScrollBar.Pressed.Background"
                     Color="#606060" />
    <SolidColorBrush x:Key="ScrollBar.Pressed.Border"
                     Color="#606060" />
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Glyph"
                     Color="#000000" />
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb"
                     Color="#A6A6A6" />
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Background"
                     Color="#DADADA" />
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Border"
                     Color="#DADADA" />
    <SolidColorBrush x:Key="ScrollBar.Disabled.Glyph"
                     Color="#BFBFBF" />
    <SolidColorBrush x:Key="ScrollBar.Disabled.Background"
                     Color="#F0F0F0" />
    <SolidColorBrush x:Key="ScrollBar.Disabled.Border"
                     Color="#F0F0F0" />

    <!-- Slider -->
    <SolidColorBrush x:Key="SliderThumb.Static.Foreground"
                     Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Background"
                     Color="#FFDCECFC" />
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Border"
                     Color="#FF7Eb4EA" />
    <SolidColorBrush x:Key="SliderThumb.Pressed.Background"
                     Color="#FFDAECFC" />
    <SolidColorBrush x:Key="SliderThumb.Pressed.Border"
                     Color="#FF569DE5" />
    <SolidColorBrush x:Key="SliderThumb.Disabled.Background"
                     Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="SliderThumb.Disabled.Border"
                     Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="SliderThumb.Static.Background"
                     Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="SliderThumb.Static.Border"
                     Color="#FFACACAC" />
    <SolidColorBrush x:Key="SliderThumb.Track.Border"
                     Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="SliderThumb.Track.Background"
                     Color="#FFE7EAEA" />

</ResourceDictionary>