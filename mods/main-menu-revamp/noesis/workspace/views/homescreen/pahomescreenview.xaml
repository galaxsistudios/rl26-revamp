<controls:paUserControlView x:Class="Workspace.Views.HomeScreen.paHomeScreenView"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                            xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                            xmlns:paEx="clr-namespace:paNoesisExtensions"
                            xmlns:controls="clr-namespace:Workspace.Controls"
                            xmlns:GenericControls="clr-namespace:Workspace.GenericControls"
                            xmlns:local="clr-namespace:Workspace.Views.HomeScreen"
                            xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
                            xmlns:vm="clr-namespace:Workspace.ViewModels"
                            mc:Ignorable="d"
                            d:DesignHeight="1080"
                            d:DesignWidth="1920"
                            d:DataContext="{d:DesignInstance {x:Type vm:NVMHomeScreen}, IsDesignTimeCreatable=True}"
                            FocusElementIdentifier="{Binding FocusElementIdentifier}"
    >
    <!--main-menu-revamp: generated by mods/main-menu-revamp/make_xaml.py - edit that, not this.-->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\..\GenericControls\PromotionalBannerTemplates.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/paTabControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--<ImageSource x:Key="URCTexture">../../Images/textures/urc_tile_background.png</ImageSource>
            <ImageSource x:Key="TileBackgroundMLR">../../Images/textures/mlr_tile_background.png</ImageSource>
            <ImageSource x:Key="SixNationsLogo">../../Images/logos_competition/128/six_nations.png</ImageSource>
            <ImageSource x:Key="TileBackgroundM6N">../../Images/textures/m6n_tile_background.png</ImageSource>
            <ImageSource x:Key="TileBackgroundW6N">../../Images/textures/w6n_tile_background.png</ImageSource>
            <ImageSource x:Key="LogoW6N">../../Images/logos_competition/128/womens_six_nations.png</ImageSource>
            <ImageSource x:Key="TileBackgroundSRP">../../Images/textures/super_rugby_tile_background.png</ImageSource>
            <ImageSource x:Key="SuperRugbyLogo">../../Images/logos_competition/128/super_rugby_pacific.png</ImageSource>
            <ImageSource x:Key="NoisyTexture">../../Images/textures/top14_noisy_texture_square.png</ImageSource>
            <ImageSource x:Key="LogoEPR">../../Images/logos_competition/128/english_premiership.png</ImageSource>
            <ImageSource x:Key="TileBackgroundEPR">../../Images/textures/premiership_tile_background.png</ImageSource>-->

            <paEx:paAdditionConverter x:Key="AdditionConverter" />

            <!--Button-->
            <DataTemplate DataType="{x:Type vm:paNVMButton}">
                <controls:paButton Content="{Binding Title}"
                                   ToolTip="{Binding ToolTip}"
                                   Command="{Binding Command}"
                                   Loaded="paButton_Loaded" />

            </DataTemplate>

            <!--Accordion-->
            <DataTemplate DataType="{x:Type vm:paNVMAccordionButton}">
                <controls:paAccordionButton Content="{Binding Title}"
                                            ToolTip="{Binding ToolTip}"
                                            ItemsSource="{Binding SubButtonVmCollection}"
                                            Loaded="paButton_Loaded" />

            </DataTemplate>

            <!--main-menu-revamp: menu box (see mods/main-menu-revamp/make_xaml.py)-->
            <ControlTemplate x:Key="MenuBoxButtonTemplate"
                             TargetType="{x:Type controls:paButton}">
                <Grid x:Name="RootGrid"
                      Width="440"
                      Height="50"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <TranslateTransform X="0" />
                    </Grid.RenderTransform>

                    <Border x:Name="BackgroundBorder"
                            BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource RLBlack70Col}" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#303030" />
                        </Border.BorderBrush>
                    </Border>

                    <Rectangle x:Name="AccentBar"
                               Width="5"
                               HorizontalAlignment="Left"
                               Fill="{StaticResource RLGreen}"
                               Opacity="0.4" />

                    <Grid Margin="20,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Viewbox x:Name="PathViewbox"
                                 Width="24"
                                 Height="24"
                                 VerticalAlignment="Center">
                            <Path x:Name="Path">
                                <Path.Fill>
                                    <SolidColorBrush Color="{StaticResource RLWhite70Col}" />
                                </Path.Fill>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Command.IsActive}"
                                                         Value="True">
                                                <Setter Property="Data"
                                                        Value="{Binding RelativeSource={RelativeSource AncestorType=controls:paButtonBase}, Path=PathData}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Command.IsActive}"
                                                         Value="False">
                                                <Setter Property="Data"
                                                        Value="M5.1 52.6c-1.4 0-2.6-.5-3.5-1.5-1-1-1.5-2.1-1.5-3.5v-25c0-1.4.5-2.6 1.5-3.5.9-1 2.1-1.5 3.5-1.5H7.6v-5c0-3.5 1.2-6.4 3.7-8.8C13.7 1.3 16.6.1 20.1.1s6.4 1.2 8.8 3.7c2.5 2.4 3.7 5.3 3.7 8.8v5h2.5c1.4 0 2.6.5 3.5 1.5 1 .9 1.5 2.1 1.5 3.5v25c0 1.4-.5 2.6-1.5 3.5-1 1-2.1 1.5-3.5 1.5H5.1Zm15-12.5c1.4 0 2.6-.5 3.5-1.5 1-1 1.5-2.1 1.5-3.5s-.5-2.6-1.5-3.5c-1-1-2.1-1.5-3.5-1.5-1.4 0-2.6.5-3.5 1.5-1 .9-1.5 2.1-1.5 3.5s.5 2.6 1.5 3.5c.9 1 2.1 1.5 3.5 1.5ZM12.6 17.6h15v-5c0-2.1-.7-3.9-2.2-5.3-1.4-1.5-3.2-2.2-5.3-2.2-2.1 0-3.9.7-5.3 2.2-1.5 1.4-2.2 3.2-2.2 5.3v5Z" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>

                        <TextBlock x:Name="ButtonTextBlock"
                                   Grid.Column="1"
                                   Margin="14,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Row_M}"
                                   FontSize="20"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding RelativeSource={RelativeSource AncestorType=controls:paButton}, Path=Title, Converter={StaticResource UppercaseConverter}}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{StaticResource RLWhite70Col}" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>

                    <Ellipse x:Name="UnreadIndicator"
                             Visibility="{Binding HasUnread, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                             Fill="{StaticResource RLGradientH}"
                             Width="15"
                             Height="15"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="-4"
                             Stroke="{StaticResource RLDarkGreen}" />

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="NormalVisualState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="{StaticResource RLBlack70Col}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" To="#303030" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)" To="{StaticResource RLWhite70Col}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="Path" Storyboard.TargetProperty="Fill.(SolidColorBrush.Color)" To="{StaticResource RLWhite70Col}" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="(TextBlock.FontWeight)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                            <DiscreteObjectKeyFrame.Value>
                                                <FontWeight>Normal</FontWeight>
                                            </DiscreteObjectKeyFrame.Value>
                                        </DiscreteObjectKeyFrame>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="IsFocusedVisualState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="{StaticResource RLWhiteCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" To="{StaticResource RLGreenCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)" To="{StaticResource RLBlackCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="Path" Storyboard.TargetProperty="Fill.(SolidColorBrush.Color)" To="{StaticResource RLBlackCol}" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="14" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="(TextBlock.FontWeight)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                            <DiscreteObjectKeyFrame.Value>
                                                <FontWeight>Bold</FontWeight>
                                            </DiscreteObjectKeyFrame.Value>
                                        </DiscreteObjectKeyFrame>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="IsSelectedVisualState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="{StaticResource RLBlack90Col}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" To="{StaticResource RLGreenCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)" To="{StaticResource RLWhiteCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="Path" Storyboard.TargetProperty="Fill.(SolidColorBrush.Color)" To="{StaticResource RLGreenCol}" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="14" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="(TextBlock.FontWeight)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                            <DiscreteObjectKeyFrame.Value>
                                                <FontWeight>Bold</FontWeight>
                                            </DiscreteObjectKeyFrame.Value>
                                        </DiscreteObjectKeyFrame>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>

            <!--main-menu-revamp: MainMenuTabControlTemplate (paTabControlStyles.xaml) with
                text tabs and a content row that grows with the stack (stock: 120 px).-->
            <ControlTemplate x:Key="MenuStackTabControlTemplate"
                             TargetType="{x:Type GenericControls:paTabControl}">
                <ControlTemplate.Resources>
                    <ControlTemplate x:Key="MenuTabItemTemplate"
                                     TargetType="TabItem">
                        <Grid Focusable="False"
                              Margin="0,0,6,0">
                            <Border x:Name="TabBorder"
                                    Height="40"
                                    Padding="18,0"
                                    BorderThickness="1"
                                    Background="{StaticResource RLBlack70}"
                                    BorderBrush="#303030">
                                <TextBlock x:Name="TabText"
                                           Text="{TemplateBinding Header}"
                                           Style="{StaticResource Row_M}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource RLWhite70}" />
                            </Border>

                            <Ellipse x:Name="UnreadIndicator"
                                     Fill="{StaticResource RLGradientH}"
                                     Width="12"
                                     Height="12"
                                     Margin="-4"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Stroke="{StaticResource RLDarkGreen}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnread}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{StaticResource RLGreen}" />
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource RLGreen}" />
                                <Setter TargetName="TabText"
                                        Property="Foreground"
                                        Value="{StaticResource RLBlack}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>

                    <Style TargetType="TabItem">
                        <Setter Property="Template"
                                Value="{StaticResource MenuTabItemTemplate}" />
                    </Style>

                    <Style TargetType="{x:Type controls:paNoesisTabItem}"
                           BasedOn="{StaticResource {x:Type TabItem}}" />
                </ControlTemplate.Resources>

                <Grid Focusable="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--Fades while a sub-menu is open, like the stock tab strip.-->
                    <StackPanel x:Name="TabMenu"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding subMenuOpen}"
                                                 Value="True">
                                        <Setter Property="Opacity"
                                                Value="0.35" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Viewbox Height="20"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center">
                            <controls:paTextBlock FormattedText="|L1|" />
                        </Viewbox>

                        <TabPanel IsItemsHost="True"
                                  Focusable="False"
                                  VerticalAlignment="Center" />

                        <Viewbox Height="20"
                                 Margin="4,0,0,0"
                                 VerticalAlignment="Center">
                            <controls:paTextBlock FormattedText="|R1|" />
                        </Viewbox>
                    </StackPanel>

                    <Border Grid.Row="2"
                            x:Name="ContentBorder">
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <Style>
            <Setter Property="local:paHomeScreenView.MenuBannerStoryboardCompleteCommand" Value="{Binding MenuBannerStoryboardCompleteCommand}"/>
        </Style>
    </UserControl.Style>
    <controls:baScreenControl>

        <Grid>
            <!--Stock promo banner, hidden: the right half belongs to the 3D player.-->
            <Grid x:Name="FeaturedBanner"
              Visibility="Collapsed" Margin="-24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GenericControls:paTabControl x:Name="PromoBannerTabControl"
                                              Style="{StaticResource NonContentedHeaderedDotsTemplate}"
                                              ShowHeading="False"
                                              Focusable="False"
                                              Grid.Row="2"
                                              Grid.Column="1"
                                              SelectedIndex="{Binding BannerIndex}"
                                              Foreground="{StaticResource RLGreen}"
                                              HorizontalAlignment="Center"
                                              d:ItemsSource="{d:SampleData ItemCount=5}"
                                              TabRightTooltipString="|RIGHTSTICKLEFTRIGHT|"
                                              ItemsSource="{Binding BannerItemsSource}"/>
                <Border Grid.Column="1" ClipToBounds="True" Height="528">
                    
                    <ContentControl DataContext="{Binding HomescreenBanner}"
                                Content="{Binding BannerTemplate}"
                                Focusable="False"
                                Grid.Column="1"
                                ContentTemplateSelector="{StaticResource PromotionalBannerTemplateSelector}">

                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>

                    <ContentControl.Resources>
                        <Storyboard x:Key="TileEnter"
                                        Completed="MenuBannerLoopComplete">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(ContentControl.RenderTransform).(TranslateTransform.X)">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                                        Value="100" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.2"
                                                      Value="0">

                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <QuadraticEase EasingMode="EaseInOut" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>

                                <DiscreteDoubleKeyFrame KeyTime="0:0:5"
                                                        Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:5.2"
                                                      Value="-70">

                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <QuadraticEase EasingMode="EaseInOut" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>

                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                                        Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.2"
                                                      Value="1">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <QuadraticEase EasingMode="EaseInOut" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>

                                <DiscreteDoubleKeyFrame KeyTime="0:0:5"
                                                        Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:5.2"
                                                      Value="0">

                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <QuadraticEase EasingMode="EaseInOut" />
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </ContentControl.Resources>

                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="Loaded">
                                <b:Interaction.Behaviors>
                                    <b:ConditionBehavior>
                                        <b:ConditionalExpression>
                                            <b:ComparisonCondition LeftOperand="{Binding Path=ItemsSource.Count, ElementName=PromoBannerTabControl}"
                                                                   RightOperand="1"
                                                                   Operator="GreaterThan" />
                                        </b:ConditionalExpression>
                                    </b:ConditionBehavior>
                                </b:Interaction.Behaviors>
                                <b:ControlStoryboardAction Storyboard="{StaticResource TileEnter}"
                                                           ControlStoryboardOption="Play" />
                            </b:EventTrigger>
                            <b:DataTrigger Binding="{Binding Path=ItemsSource.Count, ElementName=PromoBannerTabControl}" Value="1" Comparison="GreaterThan">
                                <b:ControlStoryboardAction Storyboard="{StaticResource TileEnter}" ControlStoryboardOption="Play" />
                            </b:DataTrigger>
                            <b:DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:paHomeScreenView}, Path=DataContext.ForceStoryboardReset}"
                                           Value="True">
                                <b:ControlStoryboardAction Storyboard="{StaticResource TileEnter}"
                                                           ControlStoryboardOption="Stop"/>
                                <b:ControlStoryboardAction Storyboard="{StaticResource TileEnter}"
                                                           ControlStoryboardOption="Play" />
                            </b:DataTrigger>
                        </b:Interaction.Triggers>

                    <!--<ContentControl.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource TileEnter}" />
                        </EventTrigger>
                    </ContentControl.Triggers>-->
                </ContentControl>
                </Border>

                <Rectangle Width="2"
                           Fill="{StaticResource RLGreen}"
                           HorizontalAlignment="Right" />

                <Grid  Height="20"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Left">
                    <Grid.LayoutTransform>
                        <RotateTransform Angle="270" />
                    </Grid.LayoutTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Path Fill="{StaticResource RLGreen}"
                          Data="M0 1 L1 0 V1 Z"
                          Height="20"
                          Width="16"
                          Stretch="Fill" />

                    <Path Fill="{StaticResource RLGreen}"
                          StrokeThickness="2"
                          Data="M0 20 L16 0 h-2 L-2 20Z"
                          Margin="-5, 0 0 0"
                          Height="20"
                          Width="16" />

                    <Border Background="{StaticResource RLGreen}"
                            Grid.Column="1">
                        <TextBlock Text="{Binding Converter={StaticResource UppercaseLocalise}, ConverterParameter=Featured}"
                                   Style="{StaticResource Row_S_Hover}"
                                   Foreground="{StaticResource RLBlack}"
                                   Margin="10,0" />
                    </Border>
                </Grid>
            </Grid>

            <!--Menu column: under the top-left logo of the background view, clear
                of the player on the right and the button prompts at the bottom.-->
            <Grid x:Name="ContentGrid"
                  HorizontalAlignment="Left"
                  Width="640"
                  Margin="150,172,0,130">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GenericControls:paTabControl x:Name="TabControl"
                                              Template="{StaticResource MenuStackTabControlTemplate}"
                                              Focusable="False"
                                              SelectedIndex="{Binding TabIndex, Mode=TwoWay}"
                                              InitialFocusedTab="{Binding TabIndex}"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Top">

                    <TabItem Tag="Play"
                             Header="PLAY"
                             DataContext="{Binding}"
                             IsTabStop="False">
                        <Grid HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                            <Grid.RenderTransform>
                                <TranslateTransform />
                            </Grid.RenderTransform>
                            <Grid.Resources>
                                <Storyboard x:Key="MenuStackEnter">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                                                Value="-60" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.25"
                                                              Value="0">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                                                Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.25"
                                                              Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </Grid.Resources>
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="Loaded">
                                    <b:ControlStoryboardAction Storyboard="{StaticResource MenuStackEnter}"
                                                               ControlStoryboardOption="Play" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>

                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        KeyboardNavigation.DirectionalNavigation="Cycle">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Main.Page}"
                                                         Value="Casual">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Main.Page}"
                                                         Value="Competitions">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <controls:paButton DataContext="{Binding Main.CasualGame}"
                                    Template="{StaticResource MenuBoxButtonTemplate}"
                                    Margin="0,0,0,6"
                                    HorizontalAlignment="Left"
