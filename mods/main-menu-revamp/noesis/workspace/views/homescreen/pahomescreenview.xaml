                    <b:Interaction.Triggers>

                        <!--Focus the first button, so the user doesn't have to bump movement to do it themselves.-->
                        <b:EventTrigger EventName="Loaded">
                            <noesis:SetFocusAction TargetName="TabControl" />
                        </b:EventTrigger>

                        <!--Page focus, requested by the Lua hook once a page is laid out.-->
                        <b:DataTrigger Binding="{Binding Main.FocusRequest}"
                                       Value="Casual">
                            <noesis:SetFocusAction TargetName="CasualTeamBox" />
                        </b:DataTrigger>
                        <b:DataTrigger Binding="{Binding Main.FocusRequest}"
                                       Value="Competitions">
                            <noesis:SetFocusAction TargetName="NRLBox" />
                        </b:DataTrigger>
                        <b:DataTrigger Binding="{Binding Main.FocusRequest}"
                                       Value="@Casual">
                            <noesis:SetFocusAction TargetName="CasualGameBox" />
                        </b:DataTrigger>
                        <b:DataTrigger Binding="{Binding Main.FocusRequest}"
                                       Value="@Competitions">
                            <noesis:SetFocusAction TargetName="CompetitionsBox" />
                        </b:DataTrigger>
                    </b:Interaction.Triggers>
                </GenericControls:paTabControl>

                <TextBlock Grid.Row="1"
                           Text="{Binding Description}"
                           Margin="0,10,0,0"
                           MaxWidth="560"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Style="{StaticResource Row_S}" />
            </Grid>

        </Grid>
    </controls:baScreenControl>

</controls:paUserControlView>
