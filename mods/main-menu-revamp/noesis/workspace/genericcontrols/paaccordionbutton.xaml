<local:paButtonBase x:Class="Workspace.Controls.paAccordionButton"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:paEx="clr-namespace:paNoesisExtensions"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
                    xmlns:local="clr-namespace:Workspace.Controls"
                    xmlns:vm="clr-namespace:Workspace.ViewModels"
                    mc:Ignorable="d"
                    d:DesignHeight="450"
                    d:DesignWidth="800">

    <d:paButtonBase.DataContext>
        <vm:paNVMAccordionButton IsCompetition="False" />
    </d:paButtonBase.DataContext>

    <local:paButtonBase.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Resources\Styles\Button Styles\paButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <paEx:paAdditionConverter x:Key="AdditionConverter" />
            <paEx:paTileAnimationMarginConverter x:Key="MarginConverter" />
            <paEx:paReverseBoolConverter x:Key="InverseBool" />

            <paEx:paBooleanToVisibilityConverter x:Key="paBooleanToVisibilityConverter"
                                                 TrueValue="Visible"
                                                 FalseValue="Collapsed" />

            <!--main-menu-revamp: menu box (see mods/main-menu-revamp/make_xaml.py)-->
            <ControlTemplate x:Key="MenuBoxAccordionButtonTemplate"
                             TargetType="{x:Type local:paButton}">
                <Grid x:Name="RootGrid"
                      Width="440"
                      Height="50"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <TranslateTransform X="0" />
                    </Grid.RenderTransform>

                    <Border x:Name="BackgroundBorder"
                            BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource RLBlack70Col}" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#303030" />
                        </Border.BorderBrush>
                    </Border>

                    <Rectangle x:Name="AccentBar"
                               Width="5"
                               HorizontalAlignment="Left"
                               Fill="{StaticResource RLGreen}"
                               Opacity="0.4" />

                    <Grid Margin="20,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Viewbox x:Name="PathViewbox"
                                 Width="24"
                                 Height="24"
                                 VerticalAlignment="Center">
                            <Path x:Name="Path">
                                <Path.Fill>
                                    <SolidColorBrush Color="{StaticResource RLWhite70Col}" />
                                </Path.Fill>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Command.IsActive}"
                                                         Value="True">
                                                <Setter Property="Data"
                                                        Value="{Binding RelativeSource={RelativeSource AncestorType=local:paButtonBase}, Path=PathData}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Command.IsActive}"
                                                         Value="False">
                                                <Setter Property="Data"
                                                        Value="M5.1 52.6c-1.4 0-2.6-.5-3.5-1.5-1-1-1.5-2.1-1.5-3.5v-25c0-1.4.5-2.6 1.5-3.5.9-1 2.1-1.5 3.5-1.5H7.6v-5c0-3.5 1.2-6.4 3.7-8.8C13.7 1.3 16.6.1 20.1.1s6.4 1.2 8.8 3.7c2.5 2.4 3.7 5.3 3.7 8.8v5h2.5c1.4 0 2.6.5 3.5 1.5 1 .9 1.5 2.1 1.5 3.5v25c0 1.4-.5 2.6-1.5 3.5-1 1-2.1 1.5-3.5 1.5H5.1Zm15-12.5c1.4 0 2.6-.5 3.5-1.5 1-1 1.5-2.1 1.5-3.5s-.5-2.6-1.5-3.5c-1-1-2.1-1.5-3.5-1.5-1.4 0-2.6.5-3.5 1.5-1 .9-1.5 2.1-1.5 3.5s.5 2.6 1.5 3.5c.9 1 2.1 1.5 3.5 1.5ZM12.6 17.6h15v-5c0-2.1-.7-3.9-2.2-5.3-1.4-1.5-3.2-2.2-5.3-2.2-2.1 0-3.9.7-5.3 2.2-1.5 1.4-2.2 3.2-2.2 5.3v5Z" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>

                        <TextBlock x:Name="ButtonTextBlock"
                                   Grid.Column="1"
                                   Margin="14,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Row_M}"
                                   FontSize="20"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding RelativeSource={RelativeSource AncestorType=local:paButton}, Path=Title, Converter={StaticResource UppercaseConverter}}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{StaticResource RLWhite70Col}" />
                            </TextBlock.Foreground>
                        </TextBlock>
                        <Path x:Name="Chevron"
                              Grid.Column="2"
                              Width="9"
                              Height="15"
                              Stretch="Fill"
                              Data="M0,0 L8,8 L0,16"
                              StrokeThickness="2.5"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.Stroke>
                                <SolidColorBrush Color="{StaticResource RLWhite70Col}" />
                            </Path.Stroke>
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>

                    <Ellipse x:Name="UnreadIndicator"
                             Visibility="{Binding HasUnread, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                             Fill="{StaticResource RLGradientH}"
                             Width="15"
                             Height="15"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="-4"
                             Stroke="{StaticResource RLDarkGreen}" />

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="NormalVisualState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="{StaticResource RLBlack70Col}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" To="#303030" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)" To="{StaticResource RLWhite70Col}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="Path" Storyboard.TargetProperty="Fill.(SolidColorBrush.Color)" To="{StaticResource RLWhite70Col}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Stroke.(SolidColorBrush.Color)" To="{StaticResource RLWhite70Col}" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.15" />
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="(TextBlock.FontWeight)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                            <DiscreteObjectKeyFrame.Value>
                                                <FontWeight>Normal</FontWeight>
                                            </DiscreteObjectKeyFrame.Value>
                                        </DiscreteObjectKeyFrame>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="IsFocusedVisualState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="{StaticResource RLWhiteCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" To="{StaticResource RLGreenCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)" To="{StaticResource RLBlackCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="Path" Storyboard.TargetProperty="Fill.(SolidColorBrush.Color)" To="{StaticResource RLBlackCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Stroke.(SolidColorBrush.Color)" To="{StaticResource RLBlackCol}" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="14" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.15" />
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="(TextBlock.FontWeight)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                            <DiscreteObjectKeyFrame.Value>
                                                <FontWeight>Bold</FontWeight>
                                            </DiscreteObjectKeyFrame.Value>
                                        </DiscreteObjectKeyFrame>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="IsSelectedVisualState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="{StaticResource RLBlack90Col}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="BackgroundBorder" Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" To="{StaticResource RLGreenCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)" To="{StaticResource RLWhiteCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="Path" Storyboard.TargetProperty="Fill.(SolidColorBrush.Color)" To="{StaticResource RLGreenCol}" Duration="0:0:0.15" />
                                    <ColorAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="Stroke.(SolidColorBrush.Color)" To="{StaticResource RLGreenCol}" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="14" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="90" Duration="0:0:0.15" />
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonTextBlock" Storyboard.TargetProperty="(TextBlock.FontWeight)">
                                        <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                            <DiscreteObjectKeyFrame.Value>
                                                <FontWeight>Bold</FontWeight>
                                            </DiscreteObjectKeyFrame.Value>
                                        </DiscreteObjectKeyFrame>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="AccordionTemplate"
                             TargetType="{x:Type local:paAccordionButton}">


                <Grid x:Name="RootStackPanel"
                      PreviewLostKeyboardFocus="paAccordionButton_PreviewLostKeyboardFocus">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>

                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:paAccordionButton}, Path=IsCompetition}"
                                             Value="True">
                                    <Setter Property="Width"
                                            Value="173" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>

                            <VisualState x:Name="NormalVisualState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="FocusHelperBorder"
                                                    Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)"
                                                    To="Gray"
                                                    Duration="0:0:0.2500" />
                                </Storyboard>
                            </VisualState>

                            <VisualState x:Name="IsFocusedVisualState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="FocusHelperBorder"
                                                    Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)"
                                                    To="Blue"
                                                    Duration="0:0:0.2500" />
                                </Storyboard>
                            </VisualState>

                            <VisualState x:Name="IsExpandedVisualState">
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="FocusHelperBorder"
                                                    Completed="IsExpandedStoryboard_Completed"
                                                    Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)"
                                                    To="Red"
                                                    Duration="0:0:0.0100" />
                                </Storyboard>

                            </VisualState>

                            <VisualState x:Name="IsSelectedVisualState">
                            </VisualState>

                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <!--<Canvas Width="330"
                            Height="{Binding ElementName=AccordionItemsControl, Path=ActualHeight}">-->

                    <!--The sub-buttons, or tiles, that pop up-->
                    <Canvas Width="270"
                            HorizontalAlignment="Left">


                        <ItemsControl x:Name="AccordionItemsControl"
                                      Canvas.Bottom="105"
                                      VirtualizingPanel.IsVirtualizing="False"
                                      noesis:Element.IsFocusEngagementEnabled="True"
                                      noesis:Element.IsFocusEngaged="{TemplateBinding IsExpanded}"
                                      KeyboardNavigation.DirectionalNavigation="Cycle"
                                      Focusable="False"
                                      RenderTransformOrigin="0.5,1"
                                      d:ItemsSource="{d:SampleData ItemCount=3}"
                                      ItemsSource="{TemplateBinding ItemsSource}"
                                      Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsExpanded, Converter={StaticResource paBooleanToVisibilityConverter}}"
                                      d:Visibility="Visible"
                                      Width="270">
                            <ItemsControl.RenderTransform>
                                <TranslateTransform Y="0" />
                            </ItemsControl.RenderTransform>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:paAccordionButton}, Path=IsCompetition}"
                                                     Value="True">
                                            <Setter Property="Margin"
                                                    Value="0,0,-157,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsExpanded}"
                                                     Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Duration="0:0:0.1"
                                                                         From="0"
                                                                         To="1"
                                                                         Storyboard.TargetProperty="Opacity" />
                                                        <DoubleAnimation Duration="0:0:0.2"
                                                                         From="200"
                                                                         To="0"
                                                                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>

                            <!--Warning: 16 Jan 2023: Noesis has a bug. We cannot use converters with a template binding -->
                            <!--Visibility="{TemplateBinding IsExpanded, Converter={StaticResource paBooleanToVisibilityConverter}}">-->

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:paSubButton MaxHeight="64"
                                                       Title="{Binding Title}"
                                                       Loaded="paSubButton_Loaded"
                                                       ToolTip="{Binding ToolTip}"
                                                       Command="{Binding Command}"
                                                       HighlightCommand="{Binding HighlightCommand}"
                                                       IsActive="{Binding Command.IsActive}" />
                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                        </ItemsControl>

                    </Canvas>
                    <!--</Canvas>-->
                    <!--Adjust the thickness of this border, to visually display the visual states as colors.-->
                    <Border x:Name="FocusHelperBorder"
                            Margin="0"
                            BorderThickness="0"
                            BorderBrush="Black"
                            Focusable="False">


                        <!--The "main" button, that we click to expose our sub-buttons-->
                        <local:paButton x:Name="InternalButton"
                                        Style="{DynamicResource CompetitionAccordion}"
                                        Focusable="False"
                                        Title="{TemplateBinding Title}"
                                        IsActive="{Binding IsActive, RelativeSource={RelativeSource TemplatedParent}}"
                                        PathData="{Binding RelativeSource={RelativeSource AncestorType=local:paAccordionButton}, Path=PathData}"
                                        ToolTip="{TemplateBinding ToolTip}">

                        </local:paButton>

                    </Border>

                    <b:Interaction.Triggers>
                        <noesis:GamepadTrigger FiredOn="ButtonUp"
                                               Button="Cancel">
                            <b:InvokeCommandAction Command="{Binding CancelCommand,  RelativeSource={RelativeSource TemplatedParent}}" />
                        </noesis:GamepadTrigger>

                        <b:KeyTrigger Key="Esc">
                            <b:InvokeCommandAction Command="{Binding CancelCommand,  RelativeSource={RelativeSource TemplatedParent}}" />
                        </b:KeyTrigger>

                        <b:EventTrigger EventName="Loaded">
                            <b:GoToStateAction StateName="NormalVisualState" />
                        </b:EventTrigger>

                    </b:Interaction.Triggers>

                </Grid>

                <ControlTemplate.Triggers>

                    <Trigger Property="IsExpanded"
                             Value="True">
                        <Setter Property="noesis:Element.IsFocusEngaged"
                                Value="True" />
                        <Setter TargetName="InternalButton"
                                Property="IsSelected"
                                Value="true" />
                    </Trigger>
                    <!--main-menu-revamp: home screen menu boxes. Box look for the main
                        button; the sub-menu flies out to the right of the box.-->
                    <Trigger Property="Tag"
                             Value="MenuBox">
                        <Setter TargetName="InternalButton"
                                Property="Template"
                                Value="{StaticResource MenuBoxAccordionButtonTemplate}" />
                        <Setter TargetName="AccordionItemsControl"
                                Property="Canvas.Top"
                                Value="0" />
                        <Setter TargetName="AccordionItemsControl"
                                Property="Canvas.Left"
                                Value="466" />
                        <Setter TargetName="AccordionItemsControl"
                                Property="Width"
                                Value="310" />
                    </Trigger>
                </ControlTemplate.Triggers>

            </ControlTemplate>

            <Style TargetType="{x:Type local:paAccordionButton}">
                <Setter Property="Template"
                        Value="{StaticResource AccordionTemplate}" />
                <Setter Property="Margin"
                        Value="7.5,0" />
                <Setter Property="Command"
                        Value="{Binding Command}" />
                <Setter Property="Title"
                        Value="{Binding Title}" />
                <Setter Property="ItemsSource"
                        Value="{Binding SubButtonVmCollection}" />
                <Setter Property="ClickSoundKey"
                        Value="{Binding ClickCustomSoundKey}" />
                <Setter Property="HighlightCommand"
                        Value="{Binding HighlightCommand}" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="NavigationTag"
                        Value="{Binding NavigationTag}" />
                <Setter Property="IsExpanded"
                        Value="{Binding IsExpandedForced}" />
                <Setter Property="ForceIndex"
                        Value="{Binding ForceIndex, Mode=TwoWay}" />
                <Setter Property="CloseCommand"
                        Value="{Binding CloseCommand}" />
                <Setter Property="noesis:StyleInteraction.Triggers">
                    <Setter.Value>
                        <noesis:StyleTriggerCollection>
                            <b:EventTrigger EventName="GotFocus">
                                <b:PlaySoundAction Source="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:paButtonBase}}, Path=FocusSoundKey}"
                                                   IsEnabled="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:paAccordionButton}}, Path=IsExpanded, Converter={StaticResource InverseBool}}" />
                            </b:EventTrigger>
                            <b:EventTrigger EventName="Click">
                                <b:PlaySoundAction Source="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:paButtonBase}}, Path=ClickSoundKey}" />
                            </b:EventTrigger>
                        </noesis:StyleTriggerCollection>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsCompetition}"
                                 Value="True">
                        <Setter Property="Width"
                                Value="173" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}"
                                 Value="{x:Null}">
                        <d:Setter Property="Visibility"
                                  Value="Visible" />
                        <Setter Property="Visibility"
                                Value="Collapsed" d:Value="{x:Static Visibility.Visible}"/>
                    </DataTrigger>
                    <!--main-menu-revamp: home screen menu boxes-->
                    <Trigger Property="Tag"
                             Value="MenuBox">
                        <Setter Property="Margin"
                                Value="0,0,0,6" />
                        <Setter Property="HorizontalAlignment"
                                Value="Left" />
                        <Setter Property="VerticalAlignment"
                                Value="Top" />
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </local:paButtonBase.Resources>


    <d:Grid>
        <ContentPresenter>
            <local:paAccordionButton ToolTip="wooooo"
                                     Content="Weeeee"
                                     
                                     ItemsSource="{Binding SubButtonVmCollection}" />
        </ContentPresenter>
    </d:Grid>

</local:paButtonBase>
