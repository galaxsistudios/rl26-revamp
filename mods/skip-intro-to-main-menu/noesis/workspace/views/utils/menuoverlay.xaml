<UserControl x:Class="Workspace.Views.Utils.MenuOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Workspace.Views.Utils"
             mc:Ignorable="d"
             d:Background="#FF8EA28A"
             xmlns:vm="clr-namespace:Workspace.ViewModels.Util"
             xmlns:controls="clr-namespace:Workspace.Controls"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             d:DesignHeight="1080"
             d:DesignWidth="1920"
             d:DataContext="{d:DesignInstance {x:Type vm:paNVMMenuOverlayControl}, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <Storyboard x:Key="NotificationAnimation"
                    Completed="Storyboard_Completed">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="00:00:00"
                                      Value="437.333" />
                <EasingDoubleKeyFrame KeyTime="00:00:01.5000000"
                                      Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuinticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <!--<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PathViewbox"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="00:00:00"
                                      Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:00.4000000"
                                      Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:01.2000000"
                                      Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PathViewbox"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00"
                                      Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:00.4000000"
                                      Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:01.2000000"
                                      Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>-->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="notificationText"
                                           Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="00:00:00"
                                      Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000"
                                      Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:00.7000000"
                                      Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border"
                                           Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="00:00:00000000"
                                      Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:0.800000"
                                      Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="notificationText"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="00:00:00"
                                      Value="12" />
                <EasingDoubleKeyFrame KeyTime="00:00:00.3000000"
                                      Value="12" />
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000"
                                      Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="NotificationDuration_Storyboard"
                    Duration="0:0:1.5000"
                    Completed="Storyboard_Completed_Duration">
        </Storyboard>

        <Storyboard x:Key="NotificationOutro_Storyboard"
                    Completed="Storyboard_Completed_Outro">
            <!--<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PathViewbox"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="00:00:00"
                                      Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:01"
                                      Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PathViewbox"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00"
                                      Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:01"
                                      Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>-->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.6000000"
                                      Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:01.6000000"
                                      Value="450">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuinticEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border"
                                           Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000"
                                      Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:01.2000000"
                                      Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="notificationText"
                                           Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000"
                                      Value="1" />
                <EasingDoubleKeyFrame KeyTime="00:00:01.2000000"
                                      Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="notificationText"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.8000000"
                                      Value="0" />
                <EasingDoubleKeyFrame KeyTime="00:00:01.2000000"
                                      Value="-15" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="ImpersonateUser_Storyboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">
            <ColorAnimation Storyboard.TargetName="UserId"
                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                            To="Red"
                            From="White" />
            <ColorAnimation Storyboard.TargetName="UserId"
                            Storyboard.TargetProperty="(TextBlock.Background).(SolidColorBrush.Color)"
                            To="White"
                            From="Red" />
            <DoubleAnimation Storyboard.TargetName="UserId"
                             Storyboard.TargetProperty="(TextBlock.FontSize)"
                             To="64" />

        </Storyboard>


        <Style TargetType="{x:Type controls:paTextBlock}"
               BasedOn="{StaticResource Body}"
               x:Key="FlipTextStyle" />
    </UserControl.Resources>

    <b:Interaction.Triggers>
        <b:DataTrigger Binding="{Binding ImpersonateUser}"
                       Value="True">
            <b:ControlStoryboardAction Storyboard="{StaticResource ImpersonateUser_Storyboard}"
                                       ControlStoryboardOption="Play" />
            
        </b:DataTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="9*" />
            <RowDefinition Height="0.5*" />

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"
                              x:Name="LeftPadding" />
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="0.5*" />
        </Grid.ColumnDefinitions>

        <d:Button Content="Trigger notification"
                  Width="300"
                  Height="100"
                  VerticalAlignment="Bottom"
                  Grid.Row="2"
                  Grid.Column="1"
                  Click="Notification_Trigger" />

        <!--<Rectangle Fill="Red" />

        <Rectangle Fill="Aquamarine"
                   Opacity="0.3" 
                   Grid.Row="1"/>-->

        <!--<Rectangle Fill="HotPink"
                   Opacity="0.2"
                   Grid.Row="3" />-->
        <d:Grid>

            <!--<controls:baResolutionScaledViewbox DisableWidthScaling="True"
                                            Grid.ColumnSpan="2"
                                            Grid.Row="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="0,60"
                                            Visibility="Collapsed">

            -->
            <!--<local:paNowPlayingControl />-->
            <!--
            
        </controls:baResolutionScaledViewbox>-->
        </d:Grid>

        <controls:baResolutionScaledViewbox x:Name="NameScaleViewbox"
                                            DisableWidthScaling="True"
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0">


            <Grid MinWidth="340"
                  MinHeight="50"
                  Visibility="{Binding IsNamePlateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="1" />
                </Grid.RowDefinitions>

                <Rectangle Fill="White"
                           Grid.Row="1" />

                <TextBlock x:Name="UserId"
                           Background="Transparent"
                           Text="{Binding Name}"
                           d:Text="aaaaaaaaaaaaaaaaaaaaaaaaaa"
                           Margin="20,20,120,20"
                           Opacity="0.8"
                           Style="{StaticResource Body}"
                           VerticalAlignment="Center">
                    
                </TextBlock>
            </Grid>

        </controls:baResolutionScaledViewbox>

        <controls:baResolutionScaledViewbox x:Name="VersionScaleViewbox"
                                            HorizontalAlignment="Right"
                                            Grid.Row="1"
                                            VerticalAlignment="Bottom"
                                            Grid.Column="1"
                                            Margin="20,0">
            <StackPanel Visibility="{Binding IsVersionTextVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Version}"
                           HorizontalAlignment="Right"
                           Style="{StaticResource Body}"
                           Opacity="0.6" />
                <TextBlock Text="RL26 Revamped Mod v1.0"
                           HorizontalAlignment="Right"
                           Style="{StaticResource Body}"
                           Foreground="White" />
            </StackPanel>
        </controls:baResolutionScaledViewbox>


        <controls:baResolutionScaledViewbox  x:Name="NotificationViewbox"
                                             DisableWidthScaling="True"
                                             Visibility="{Binding IsNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             RenderTransformOrigin="0.5,0.5"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             HorizontalAlignment="Right"
                                             Grid.ColumnSpan="2"
                                             VerticalAlignment="Top"
                                             Margin="{Binding NotificationMargin}">
            <controls:baResolutionScaledViewbox.RenderTransform>
                <TranslateTransform Y="75" />
            </controls:baResolutionScaledViewbox.RenderTransform>


            <controls:baResolutionScaledViewbox.Style>
                <Style TargetType="{x:Type controls:baResolutionScaledViewbox}">

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding InGame}"
                                     Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="150" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:baResolutionScaledViewbox.Style>

            <Border BorderThickness="0,0,0,1"
                    BorderBrush="White"
                    Grid.ColumnSpan="2"
                    Grid.Row="1"
                    Height="60"
                    MinWidth="340"
                    MinHeight="60"
                    x:Name="Border">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>

                <Grid x:Name="grid"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>



                    <Grid  ClipToBounds="True"
                           Grid.Column="2">
                        <Viewbox x:Name="PathViewbox"
                                 Margin="5"
                                 RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <ScaleTransform />
                            </Viewbox.RenderTransform>

                            <Path Data="M164 1C74 1 1 74 1 164s73 163 163 163 163-73 163-163S254 1 164 1ZM136 39s1-1 3-1h50c1 0 2 0 3 1s1 1 1 3l-5 154c0 2-2 4-4 4h-40c-2 0-4-2-4-4l-5-154c0-1 0-2 1-3Zm28 251c-17 0-31-14-31-31s14-31 31-31 31 14 31 31-14 31-31 31Z"
                                  StrokeThickness="10">
                                <Path.Stroke>
                                    <SolidColorBrush Color="White" />
                                </Path.Stroke>
                            </Path>
                        </Viewbox>
                    </Grid>

                    <StackPanel x:Name="notificationText"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Grid.Column="0"
                                RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <SkewTransform />
                                <RotateTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </StackPanel.RenderTransform>

                        <controls:paTextBlock FormattedText="{Binding NotificationTopText}"
                                              x:Name="topTextBlock"
                                              HorizontalAlignment="Left"
                                              Margin="20,0"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5"
                                              Style="{StaticResource FlipTextStyle}">

                            <TextBlock.Foreground>
                                <SolidColorBrush Color="White"
                                                 Opacity="100" />
                            </TextBlock.Foreground>
                        </controls:paTextBlock>

                        <controls:paTextBlock FormattedText="{Binding NotificationBottomText}"
                                              x:Name="bottomTextBlock"
                                              Margin="20,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5"
                                              Visibility="{Binding NotificationBottomTextIsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Style="{StaticResource FlipTextStyle}">

                            <TextBlock.Foreground>
                                <SolidColorBrush Color="White"
                                                 Opacity="100" />
                            </TextBlock.Foreground>
                        </controls:paTextBlock>
                    </StackPanel>

                </Grid>
            </Border>
        </controls:baResolutionScaledViewbox>

        <d:Label Content="{Binding ElementName=textBlock, Path=Opacity}"
                 Grid.Row="2"
                 Grid.Column="1"
                 Width="200"
                 Height="200" />

        <b:Interaction.Triggers>
            <b:DataTrigger Binding="{Binding NotificationIsActive}"
                           Value="True">
                <b:InvokeCommandAction Command="{Binding RelativeSource={RelativeSource AncestorType=local:MenuOverlay}, Path=InvokeBeginStoryboardCommand}" />
            </b:DataTrigger>
            <b:DataTrigger Binding="{Binding NotificationIsActive}"
                           Value="False">
                <b:InvokeCommandAction Command="{Binding RelativeSource={RelativeSource AncestorType=local:MenuOverlay}, Path=InvokeEndStoryboardCommand}" />
            </b:DataTrigger>
        </b:Interaction.Triggers>
    </Grid>
</UserControl>
