                  noesis:Element.PPAAIn="0.1"/>
            <!-- Had to decrease PPAA-In value as the default value (0.25) was causing glitches when shrinking down for lower resolutions (Known issue with this type of anti-aliasing)-->
            <!-- If problems persist just set value to 0, should avoid lowering PPAA-out value (or turning off AA) however as that could cause jagged lines on higher resolutions-->
            <Grid x:Name="CreditsLayout" 
                Margin="150,190,0,190"
                HorizontalAlignment="Left"
                Width="1150">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="White" Offset="0.05" />
                        <GradientStop Color="White" Offset="0.95" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <!--Opacity mask is ignoring total size and instead positioning relative to the area that has renderable pixels - add this invisible border to force the opacity mask to start at the edges-->
                <Border x:Name ="HACKforcefill01" Background="#00000000"/>
                <Controls:paNCCScrollingControl ItemsSource="{Binding Credits}"
                                            Focusable="True"
                                            HorizontalAlignment="Left"
                                            IsPlaying="{Binding IsPlaying}"
                                            Foreground="{DynamicResource Brush.Foreground.Normal}"
                                            AutoStartDelay="0:0:1"
                                            PixelsPerSecond="{Binding Speed}">
                    <Controls:paNCCScrollingControl.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter HorizontalAlignment="Center" Content="{Binding}"/>
                        </DataTemplate>
                    </Controls:paNCCScrollingControl.ItemTemplate>
                </Controls:paNCCScrollingControl>
            </Grid>
        </Grid>
    </Controls:baScreenControl>
</Grid>