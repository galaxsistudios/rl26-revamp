<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:Controls="clr-namespace:Workspace.Controls"
    xmlns:ViewModels="clr-namespace:Workspace.ViewModels"
    xmlns:Extensions="clr-namespace:paNoesisExtensions"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d"
    x:Name="RootGrid"
    d:DesignHeight="1080" d:DesignWidth="1920"
    d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type={x:Type ViewModels:paNVMCredits}}"
    >
    <!-- about-rl26-revamped: generated by make_logos.py from views/credits/credits.xaml for the About page.
         Same view, with the Big Ant watermark replaced by the Galaxsi Studios logo. -->
    <Grid.Resources>
		
        <Storyboard x:Key="Outro">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="ContainerGrid">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.05"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" Storyboard.TargetName="ContainerGrid">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.05"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="Intro">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" Storyboard.TargetName="ContainerGrid">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.05"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" Storyboard.TargetName="ContainerGrid">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.05"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <DataTemplate DataType="{x:Type ViewModels:paNVMHeaderCredit}">
            <TextBlock Text="{Binding Text}" 
                       Style="{StaticResource Display_L}"
                       TextWrapping="Wrap"
                       TextAlignment="Left"
                       Width="1150"
                       />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:paNVMHeaderCreditDouble}">
            <Grid Width="1150">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text1}" 
                           Style="{StaticResource Display_M}"
                           Grid.Column="0"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
                <TextBlock Text="{Binding Text2}" 
                           Style="{StaticResource Display_M}"
                           Grid.Column="2"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:paNVMHeaderCreditTriple}">
            <Grid Width="1150" HorizontalAlignment="Center" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text1}" 
                           Style="{StaticResource Display_M}"
                           Grid.Column="0"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
                <TextBlock Text="{Binding Text2}" 
                           Style="{StaticResource Display_M}"
                           Grid.Column="2"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
                <TextBlock Text="{Binding Text3}" 
                           Style="{StaticResource Display_M}"
                           Grid.Column="4"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:paNVMSubheaderCredit}">
            <TextBlock Width="1150" Margin="0,5"
                       Text="{Binding Text}" 
                       Style="{StaticResource Display_S}"
                       TextWrapping="Wrap"
                       TextAlignment="Left"
                       />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:paNVMSubheaderCreditDouble}">
            <Grid Width="1150" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text1}" 
                           Style="{StaticResource Display_S}"
                           Grid.Column="0"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
                <TextBlock Text="{Binding Text2}" 
                           Style="{StaticResource Display_S}"
                           Grid.Column="2"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:paNVMSubheaderCreditTriple}">
            <Grid Width="1150" HorizontalAlignment="Center" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text1}" 
                           Style="{StaticResource Display_S}"
                           Grid.Column="0"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
                <TextBlock Text="{Binding Text2}" 
                           Style="{StaticResource Display_S}"
                           Grid.Column="2"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
                <TextBlock Text="{Binding Text3}" 
                           Style="{StaticResource Display_S}"
                           Grid.Column="4"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:paNVMTextCredit}">
            <TextBlock Width="1150" Margin="0,2.5"
                       Text="{Binding Text}" 
                       Style="{StaticResource Body}"
                       TextWrapping="Wrap"
                       TextAlignment="Left"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:paNVMTextCreditDouble}">
            <Grid Width="1150" Margin="0,2.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text1}" 
                           Style="{StaticResource Body}"
                           Grid.Column="0"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
                <TextBlock Text="{Binding Text2}" 
                           Style="{StaticResource Body}"
                           Grid.Column="2"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:paNVMTextCreditTriple}">
            <Grid Width="1150" HorizontalAlignment="Center" Margin="0,2.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text1}" 
                           Style="{StaticResource Body}"
                           Grid.Column="0"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
                <TextBlock Text="{Binding Text2}" 
                           Style="{StaticResource Body}"
                           Grid.Column="2"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
                <TextBlock Text="{Binding Text3}" 
                           Style="{StaticResource Body}"
                           Grid.Column="4"
                           TextWrapping="Wrap"
                           TextAlignment="Left"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:paNVMSpacingCredit}">
            <Border Height="{Binding Height}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:paNVMImageCredit}">
            <Image Width="1150" Source="{Binding Path=Source}" Stretch="Uniform" Height="{Binding Path=Height, FallbackValue=100}" HorizontalAlignment="Left"/>
        </DataTemplate>

    </Grid.Resources>
    <Grid.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <!-- <BeginStoryboard Storyboard="{StaticResource Intro}"/> -->
        </EventTrigger>
    </Grid.Triggers>

    <Controls:baFillControl>
        <Grid>
            <Border x:Name ="Darkenning" Margin="0,0,2,0">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.6,0.4" Center="0.6,0.4">
                        <GradientStop Color="#7F000000" Offset="0.983"/>
                        <GradientStop Offset="0.078" Color="#00000000"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

        </Grid>
    </Controls:baFillControl>

    <Controls:baScreenControl IntroStoryboard="{StaticResource Intro}">
        <Grid>
            <Path Height="308"
                  Width="640"
                  Opacity="0.1"
                  HorizontalAlignment="Right"
                  Margin="0,0,140,101"
                  VerticalAlignment="Center"
                  Fill="White"
                  Stretch="Uniform"
                  Data="F0 M639.5 1027.3C582.7 1026.9 500.5 1025 487 1024C457 1021.5 399.3 1007.1 354.2 990.9C310.6 975.1 275.8 957.1 229.5 926.2C205 909.9 188.5 896.8 167 876.8C114.1 827.5 80.8 783.2 50.6 721.5C24.2 667.8 9.9 618 2.3 553.5C0.2 535.2 -0.1 494.5 1.9 476C4.9 446.9 10.8 412.6 16.7 389.5C33.5 323.7 71.7 252.4 120.4 196C140.8 172.4 170.2 144 194.4 124.6C233.1 93.6 293 59.7 347 38.2C393.5 19.7 459.1 5.2 506.5 3C561 0.4 1124.7 -0.6 1161 1.9L1170.5 2.5L1158.5 12.5C1144.3 24.3 1096.8 62.1 976.1 157.8L887.8 227.7L713.6 228.5C617.9 228.8 530.3 229.5 519 230C503.2 230.6 495.8 231.4 486.5 233.4C427.7 246 378.8 272.8 337.4 315.1C311.8 341.3 292.9 368.6 279.5 398.8C270.1 420.2 260.6 452.6 257.8 473.2C256.1 486.4 256.3 534.3 258.2 548.5C263.9 590.8 280.7 635.3 304.4 671C322.6 698.5 356.1 731.2 387.5 752.2C400.5 760.9 425.8 773.9 442 780.3C454.3 785.2 477.1 791.6 493.8 795C511.3 798.5 532.3 799.1 658.8 799.7L781 800.2L781 716.6L781 633L750.8 633L720.5 633L706 616.8C680.6 588.4 640.7 544.7 602 503C565.5 463.5 527 421.7 519.7 413.4L516.1 409.3L546.2 408.7C562.8 408.3 669.4 408 783.1 408L989.8 408L1002.3 433.2C1009.2 447.1 1018.4 464.7 1022.9 472.2L1030.9 485.9L1030 677.2C1029.5 782.4 1029 877.5 1029 888.5L1029 908.6L976.8 938.5C948 955 901.6 981.9 873.5 998.2L822.6 1028L746 1027.8C703.9 1027.6 656 1027.4 639.5 1027.3ZM995.3 1027.1C938 1026.8 890.9 1026.2 890.5 1025.8C889.2 1024.6 939.5 995.4 1160 869.8L1278.5 802.3L1360.5 801.6C1405.6 801.2 1496.7 800.5 1563 800C1693.1 798.9 1737.9 797.9 1750.6 795.6C1760.1 794 1765.8 791.3 1776.6 783.2C1793.2 770.9 1803.1 753.4 1807.5 728.5C1810.8 709.7 1804.9 684.7 1793.2 667.5C1786.4 657.7 1777.8 650.8 1759.9 641.3L1744.5 633L1637 633C1502.5 632.9 1333.4 631.4 1308.9 630C1254.1 627 1198.1 612.6 1158.1 591.3C1142.4 583 1127.4 573.8 1119.2 567.7C1090.6 546.2 1058.5 513.5 1038.6 485.6C1017 455.4 996.6 409.6 989.6 375.8C984.1 349 981.4 296.9 984 267.1C985.2 253.6 989.3 235.6 995.7 216.5C1007.6 180.2 1020.5 153.5 1030.7 143.9C1032.8 141