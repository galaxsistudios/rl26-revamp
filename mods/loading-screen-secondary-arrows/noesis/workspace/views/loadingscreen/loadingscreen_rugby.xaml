                    <LinearDoubleKeyFrame KeyTime="0:0:0.3"
                                          Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.4"
                                          Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.8"
