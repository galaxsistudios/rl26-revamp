                                                  Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00"
                                             Value="0,0,380,0" />
                    <EasingThicknessKeyFrame KeyTime="00:00:01"
                                             Value="0,0,470,0" />
                </ThicknessAnimationUsingKeyFrames>

                <!--Left lines thickness-->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LL1"
                                               Storyboard.TargetProperty="StrokeThickness">
                    <EasingDoubleKeyFrame KeyTime="00:00:00"
                                          Value="0" />
                    <EasingDoubleKeyFrame KeyTime="00:00:01"
                                          Value="6" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LL2"
                                               Storyboard.TargetProperty="StrokeThickness">
                    <EasingDoubleKeyFrame KeyTime="00:00:00"
                                          Value="6" />
                    <EasingDoubleKeyFrame KeyTime="00:00:01"
                                          Value="12" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LL3"
                                               Storyboard.TargetProperty="StrokeThickness">
                    <EasingDoubleKeyFrame KeyTime="00:00:00"
                                          Value="12" />
                    <EasingDoubleKeyFrame KeyTime="00:00:01"
                                          Value="24" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LL4"
                                               Storyboard.TargetProperty="StrokeThickness">
                    <EasingDoubleKeyFrame KeyTime="00:00:00"
                                          Value="24" />
                    <EasingDoubleKeyFrame KeyTime="00:00:01"
                                          Value="36" />
