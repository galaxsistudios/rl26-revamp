<!--
    replay-team-stinger: the try-replay stinger. Repurposes the unused Views/Tests/MatchIntro
    view (build.py can't add files). Bound to NVMTeamStinger (base/transition/logotransition_hud.lua):
      StingerState  "hidden" | "in" | "out"
      Team          the scoring side's NVMTeam (PrimaryColour, SecondaryColour, TeamLogo)

    Two skewed panels sweep right to left: a secondary-colour band leads in and trails out, the
    primary-colour panel covers the screen, the crest pops in on top. StingerIn and StingerOut
    each take 0.46s; TeamStingerCoverTime/OutTime in the Lua (0.5s) must stay at or above that.

    Panel maths (1920x1080 design space): 2400x1200 rects at (-240,-60) with AngleX -15 about
    their centre lean 161px each way, so at X=0 they cover the screen, at X=2500 they're fully off
    the right edge and at X=-2700 fully off the left.
-->
<Grid
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
      mc:Ignorable="d"
      x:Name="TeamStingerRoot"
      Focusable="False"
      IsHitTestVisible="False"
      d:DesignHeight="1080" d:DesignWidth="1920">

    <Grid.Resources>
        <ResourceDictionary>
            <Storyboard x:Key="StingerIn" FillBehavior="HoldEnd">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Stinger" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>

                <!--Secondary band leads-->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SecondaryPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="2500"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>

                <!--Primary panel covers-->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PrimaryPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="2500"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="2500"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.46" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>

                <!--Crest lands-->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Crest" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.26" Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Crest" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.3"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.26" Value="1.3"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.46" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Crest" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.3"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.26" Value="1.3"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.46" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!--No start keyframes: each part leaves from wherever it is, so an early release
                (stinger still sliding in) doesn't jump.-->
            <Storyboard x:Key="StingerOut" FillBehavior="HoldEnd">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Crest" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Crest" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="0.9"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Crest" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="0.9"/>
                </DoubleAnimationUsingKeyFrames>

                <!--Primary panel leaves first-->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PrimaryPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="-2700">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseIn"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>

                <!--Secondary band trails-->
                <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.08" Storyboard.TargetName="SecondaryPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="-2700">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseIn"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="StingerHidden" FillBehavior="HoldEnd">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Stinger" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SecondaryPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="2500"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PrimaryPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="2500"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Crest" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </Grid.Resources>

    <i:Interaction.Triggers>
        <ei:DataTrigger Binding="{Binding StingerState}" Value="in">
            <ei:ControlStoryboardAction Storyboard="{StaticResource StingerIn}" ControlStoryboardOption="Play"/>
        </ei:DataTrigger>
        <ei:DataTrigger Binding="{Binding StingerState}" Value="out">
            <ei:ControlStoryboardAction Storyboard="{StaticResource StingerOut}" ControlStoryboardOption="Play"/>
        </ei:DataTrigger>
        <ei:DataTrigger Binding="{Binding StingerState}" Value="hidden">
            <ei:ControlStoryboardAction Storyboard="{StaticResource StingerHidden}" ControlStoryboardOption="Play"/>
        </ei:DataTrigger>
    </i:Interaction.Triggers>

    <Viewbox Stretch="UniformToFill" VerticalAlignment="Center">
        <Grid x:Name="Stinger" Width="1920" Height="1080" Visibility="Collapsed">
            <Canvas>
                <Rectangle x:Name="SecondaryPanel"
                           Canvas.Left="-240" Canvas.Top="-60" Width="2400" Height="1200"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{Binding Team.SecondaryColour}" d:Color="#FFD200"/>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-15"/>
                            <TranslateTransform X="2500"/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Rectangle x:Name="PrimaryPanel"
                           Canvas.Left="-240" Canvas.Top="-60" Width="2400" Height="1200"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{Binding Team.PrimaryColour}" d:Color="#470F6D"/>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-15"/>
                            <TranslateTransform X="2500"/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>

            <Image x:Name="Crest"
                   Source="{Binding Team.TeamLogo}"
                   Width="560" Height="560" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                </Image.RenderTransform>
            </Image>
        </Grid>
    </Viewbox>
</Grid>
