<UserControl x:Class="Workspace.Views.HUD.Rugby.paPenaltyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Workspace.Views.HUD.Rugby"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:paEx="clr-namespace:paNoesisExtensions"
             xmlns:vm="clr-namespace:Workspace.ViewModels.HUD.Rugby"
             xmlns:controls="clr-namespace:Workspace.Controls"
             mc:Ignorable="d"
             Visibility="{Binding isVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
             d:DesignHeight="1080"
             d:DesignWidth="1920">

    <!--nrl-broadcast-scoreboard: penalty choice restyled as a horizontal lower third matching the
        player plate - crest in the slanted team-colour box, dark card with PENALTY and the options
        side by side, green underline. Sits bottom centre (defence-tactics-hud's
        pagameplayhudcontrol.xaml). RevealKey -> intro (box pops, card slides out, options pop in
        one by one); HideKey -> outro, the intro reversed (nvm_penaltyhud.lua holds the bar up for
        var_0_outro_time). Styles are local: this view loads under every HUD theme.-->

    <d:UserControl.DataContext>
        <vm:paNVMPenalty />
    </d:UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>

            <SolidColorBrush x:Key="PenCard" Color="#12171E" />
            <!--Not RLGreen: rl26-revamp-branding recolours that to the Revamp blue-->
            <SolidColorBrush x:Key="PenGreen" Color="#FF24DB61" />

            <Style x:Key="PenMaison" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FontFamily_ScoreMaison}" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--One option: button glyph (ToolTip) + label (Content)-->
            <ControlTemplate TargetType="ContentControl"
                             x:Key="PenaltyOption">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,22,0"
                            VerticalAlignment="Center">
                    <Viewbox Height="20"
                             VerticalAlignment="Center">
                        <controls:paTextBlock FormattedText="{TemplateBinding ToolTip}" />
                    </Viewbox>
                    <TextBlock Text="{TemplateBinding Content}"
                               Style="{StaticResource HUD_SemiBold}"
                               FontSize="14"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </ControlTemplate>

            <ControlTemplate x:Key="PenaltyControlTemplate"
                             TargetType="local:paPenaltyControl">

                <controls:baResolutionScaledViewbox>

                    <Grid x:Name="RootGrid"
                          Height="46"
                          HorizontalAlignment="Center">

                        <!--Card: clipped from the middle of the box so it emerges from behind it-->
                        <Grid Margin="30,0,0,0"
                              ClipToBounds="True">
                            <Grid x:Name="Card">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Grid.RenderTransform>

                                <Border Background="{StaticResource PenCard}" />

                                <StackPanel Orientation="Horizontal"
                                            Margin="42,0,0,3"
                                            VerticalAlignment="Center">

                                    <!--scrum-feed-control: IsScrumPrompt swaps the title and the three
                                        option slots for the scrum prompt (SCRUM | LEFT MIDDLE RIGHT,
                                        or SCRUM | FEED), set by nvm_penaltyhud.lua setScrumPrompt-->
                                    <TextBlock x:Name="Title"
                                               d:Text="PENALTY"
                                               FontSize="20">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource PenMaison}">
                                                <Setter Property="Text"
                                                        Value="{Binding Converter={StaticResource UppercaseLocalise}, ConverterParameter=Penalty}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScrumPrompt}" Value="True">
                                                        <Setter Property="Text" Value="{Binding ScrumTitle}" />
                                                    </DataTrigger>
                                                    <!--scrum clock: last 3 seconds / OFFSIDE-->
                                                    <DataTrigger Binding="{Binding ScrumUrgent}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFE63232" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Rectangle x:Name="Divider"
                                               Width="1"
                                               Height="22"
                                               Margin="18,0"
                                               Fill="#40FFFFFF" />

                                    <ContentControl x:Name="OptGoal"
                                                    Template="{StaticResource PenaltyOption}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ToolTip" Value="|CIRCLE|" />
                                                <Setter Property="Content"
                                                        Value="{Binding Converter={StaticResource UppercaseLocalise}, ConverterParameter=PenaltyGoal, FallbackValue=''}" />
                                                <Setter Property="Visibility"
                                                        Value="{Binding ShowPenaltyGoal, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScrumPrompt}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding ScrumOpt1Glyph}" />
                                                        <Setter Property="Content" Value="{Binding ScrumOpt1Text}" />
                                                        <Setter Property="Visibility"
                                                                Value="{Binding ScrumOpt1Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                        <ContentControl.RenderTransform>
                                            <TranslateTransform X="0" />
                                        </ContentControl.RenderTransform>
                                    </ContentControl>
                                    <ContentControl x:Name="OptTap"
                                                    Template="{StaticResource PenaltyOption}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ToolTip" Value="|SQUARE|" />
                                                <Setter Property="Content"
                                                        Value="{Binding Converter={StaticResource UppercaseLocalise}, ConverterParameter=TapRestart, FallbackValue=''}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScrumPrompt}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding ScrumOpt2Glyph}" />
                                                        <Setter Property="Content" Value="{Binding ScrumOpt2Text}" />
                                                        <Setter Property="Visibility"
                                                                Value="{Binding ScrumOpt2Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                        <ContentControl.RenderTransform>
                                            <TranslateTransform X="0" />
                                        </ContentControl.RenderTransform>
                                    </ContentControl>
                                    <ContentControl x:Name="OptTouch"
                                                    Template="{StaticResource PenaltyOption}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ToolTip" Value="|TRIANGLE|" />
                                                <Setter Property="Content"
                                                        Value="{Binding Converter={StaticResource UppercaseLocalise}, ConverterParameter=KickToTouch, FallbackValue=''}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScrumPrompt}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding ScrumOpt3Glyph}" />
                                                        <Setter Property="Content" Value="{Binding ScrumOpt3Text}" />
                                                        <Setter Property="Visibility"
                                                                Value="{Binding ScrumOpt3Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                        <ContentControl.RenderTransform>
                                            <TranslateTransform X="0" />
                                        </ContentControl.RenderTransform>
                                    </ContentControl>
                                    <!--scrum-feed-control: pack the scrum again, only on the penalty choice
                                        after an offside penalty off a scrum (ShowPenaltyScrum)-->
                                    <ContentControl x:Name="OptScrum"
                                                    Template="{StaticResource PenaltyOption}"
                                                    ToolTip="|CROSS|"
                                                    Content="SCRUM"
                                                    Visibility="{Binding ShowPenaltyScrum, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <Rectangle Height="3"
                                           VerticalAlignment="Bottom"
                                           Fill="{StaticResource PenGreen}" />
                            </Grid>
                        </Grid>

                        <!--Crest box-->
                        <Grid x:Name="CrestBox"
                              Width="62"
                              HorizontalAlignment="Left"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <Path Data="M 10,0 L 62,0 L 52,46 L 0,46 Z"
                                  Stretch="None"
                                  Fill="{Binding TeamColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                  d:Fill="#1F6B45" />
                            <Path Data="M 10,0 L 62,0 L 52,46 L 0,46 Z"
                                  Stretch="None">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1AFFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#33000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Image Source="{Binding TeamLogo}"
                                   d:Source="/Images/Club_Logos/256/custom.png"
                                   Margin="12,5" />
                        </Grid>

                        <b:Interaction.Triggers>

                            <!--Intro-->
                            <b:PropertyChangedTrigger Binding="{Binding RevealKey}">
                                <b:ControlStoryboardAction>
                                    <b:ControlStoryboardAction.Storyboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CrestBox"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="CrestBox"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="0.4" To="1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CrestBox"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="0.4" To="1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Card"
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-900" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="-900" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuinticEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>

                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Title"
                                                                           Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Divider"
                                                                           Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>

                                            <!--Options pop in one after another-->
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OptGoal"
                                                                           Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OptGoal"
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-16" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="-16" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuinticEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OptTap"
                                                                           Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.53" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OptTap"
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-16" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.53" Value="-16" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuinticEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OptTouch"
                                                                           Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.61" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OptTouch"
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-16" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.61" Value="-16" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.86" Value="0">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuinticEase EasingMode="EaseOut" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </b:ControlStoryboardAction.Storyboard>
                                </b:ControlStoryboardAction>
                            </b:PropertyChangedTrigger>

                            <!--Outro: the intro reversed, 0.35s (var_0_outro_time in nvm_penaltyhud.lua)-->
                            <b:PropertyChangedTrigger Binding="{Binding HideKey}">
                                <b:ControlStoryboardAction>
                                    <b:ControlStoryboardAction.Storyboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OptTouch"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="OptTap"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" BeginTime="0:0:0.03" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="OptGoal"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" BeginTime="0:0:0.06" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Divider"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="Title"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" BeginTime="0:0:0.04" Duration="0:0:0.1" />
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Card"
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="-900">
                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                        <QuinticEase EasingMode="EaseIn" />
                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="CrestBox"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="1" To="0.4" BeginTime="0:0:0.18" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseIn" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CrestBox"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="1" To="0.4" BeginTime="0:0:0.18" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseIn" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CrestBox"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" BeginTime="0:0:0.24" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </b:ControlStoryboardAction.Storyboard>
                                </b:ControlStoryboardAction>
                            </b:PropertyChangedTrigger>
                        </b:Interaction.Triggers>
                    </Grid>

                </controls:baResolutionScaledViewbox>

            </ControlTemplate>

            <Style TargetType="local:paPenaltyControl">
                <Setter Property="Template"
                        Value="{StaticResource PenaltyControlTemplate}" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <d:Grid>

        <ContentPresenter>
            <local:paPenaltyControl />
        </ContentPresenter>

    </d:Grid>

</UserControl>
