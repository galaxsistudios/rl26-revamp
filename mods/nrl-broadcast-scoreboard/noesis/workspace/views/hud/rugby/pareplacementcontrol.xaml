<UserControl x:Class="Workspace.Views.HUD.Rugby.paReplacementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Workspace.Views.HUD.Rugby"
             mc:Ignorable="d"
             Visibility="{Binding isSubstitutionHudVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=False}"
             xmlns:controls="clr-namespace:Workspace.Controls"
             xmlns:paEx="clr-namespace:paNoesisExtensions"
             xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
             xmlns:enums="clr-namespace:Workspace.Enums"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:Workspace.ViewModels.HUD.Rugby">

    <!--nrl-broadcast-scoreboard: quick interchange restyled to match the player plate
        (PlayerPlateTemplate in defaulthudresources.xaml) and the same 400 width.
        Everything is defined locally because this view loads under every HUD theme.
        Animations: isSubstitutionHudVisible -> intro, ManagingInterchange -> player lists in,
        IsClosing -> outro (nvm_substitutionhud.lua holds the panel up for var_0_outro_time).-->

    <d:UserControl.DataContext>
        <vm:paNVMReplacement ManagingInterchange="True" />
    </d:UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>

            <StreamGeometry x:Key="InjuryIcon">
                m27.45 13.3-14.14 14.14c-2.93 2.93-7.68 2.93-10.61 0-2.93-2.93-2.93-7.68 0-10.61L16.84 2.7c2.93-2.93 7.68-2.93 10.61 0s2.93 7.68 0 10.61zM4.46 15.07l10.61 10.61m10.61-10.61L15.07 4.46m-5.3 9.55c-.59.59-.59 1.54 0 2.12s1.54.59 2.12 0 .59-1.54 0-2.12-1.54-.59-2.12 0zm4.24-4.24c-.59.59-.59 1.54 0 2.12s1.54.59 2.12 0 .59-1.54 0-2.12-1.54-.59-2.12 0zm4.24 4.24c-.59.59-.59 1.54 0 2.12s1.54.59 2.12 0 .59-1.54 0-2.12-1.54-.59-2.12 0zm-4.24 4.24c-.59.59-.59 1.54 0 2.12s1.54.59 2.12 0 .59-1.54 0-2.12-1.54-.59-2.12 0z
            </StreamGeometry>

            <!--Not RLGreen: rl26-revamp-branding recolours that to the Revamp blue-->
            <SolidColorBrush x:Key="SubGreen" Color="#FF24DB61" />
            <SolidColorBrush x:Key="SubCard" Color="#12171E" />
            <SolidColorBrush x:Key="SubCardSelected" Color="#26303C" />
            <SolidColorBrush x:Key="SubPosition" Color="#8FA39A" />

            <Style x:Key="SubMaison" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FontFamily_ScoreMaison}" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--StaminaLevel (nvm_substitutionhud.lua): 0 >=60%, 1 >=40%, 2 >=20%, 3 below - same as the plate-->
            <Style x:Key="SubStaminaText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HUD_Bold}">
                <Setter Property="Foreground" Value="{StaticResource SubGreen}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StaminaLevel}" Value="1">
                        <Setter Property="Foreground" Value="#FFF2D21B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StaminaLevel}" Value="2">
                        <Setter Property="Foreground" Value="#FFFF8A1F" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StaminaLevel}" Value="3">
                        <Setter Property="Foreground" Value="#FFE63232" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SubStaminaBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Foreground" Value="{StaticResource SubGreen}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StaminaLevel}" Value="1">
                        <Setter Property="Foreground" Value="#FFF2D21B" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StaminaLevel}" Value="2">
                        <Setter Property="Foreground" Value="#FFFF8A1F" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StaminaLevel}" Value="3">
                        <Setter Property="Foreground" Value="#FFE63232" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--Row backing: dark card, selected row lifts and gets a white outline-->
            <Style TargetType="{x:Type controls:paListBoxItem}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:paListBoxItem}">
                            <Grid Height="34" Margin="0,1">
                                <Border x:Name="RowBack" Background="{StaticResource SubCard}" />
                                <ContentPresenter />
                                <Border x:Name="RowOutline"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        Opacity="0" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBack" Property="Background" Value="{StaticResource SubCardSelected}" />
                                    <Setter TargetName="RowOutline" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--Player row: mini plate - number box, name over position, stamina-->
            <DataTemplate DataType="{x:Type vm:NVMInterchangePlayer}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>

                    <Path Data="M 6,0 L 28,0 L 22,34 L 0,34 Z"
                          Stretch="None"
                          Fill="{Binding DataContext.Team.PrimaryColour, RelativeSource={RelativeSource AncestorType=local:paReplacementControl}, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                          d:Fill="#1F6B45" />
                    <TextBlock Text="{Binding Number}"
                               d:Text="14"
                               Style="{StaticResource SubMaison}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{Binding DataContext.Team.HudTextColour, RelativeSource={RelativeSource AncestorType=local:paReplacementControl}, Converter={StaticResource ColorToSolidColorBrushConverter}}" />

                    <StackPanel Grid.Column="1"
                                Margin="7,0,4,2"
                                VerticalAlignment="Center">
                        <Viewbox StretchDirection="DownOnly"
                                 HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ShortName, Converter={StaticResource UppercaseConverter}}"
                                       d:Text="J. GRAY"
                                       Style="{StaticResource SubMaison}"
                                       FontSize="12" />
                        </Viewbox>
                        <TextBlock Text="{Binding Position, Converter={StaticResource UppercaseConverter}}"
                                   d:Text="WINGER LEFT"
                                   Style="{StaticResource HUD_SemiBold}"
                                   FontSize="9"
                                   Margin="1,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource SubPosition}" />
                    </StackPanel>

                    <Viewbox Grid.Column="2"
                             Height="13"
                             Margin="2,0"
                             Visibility="{Binding IsInjured, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Path Data="{StaticResource InjuryIcon}"
                              Stroke="#FFE63232"
                              StrokeThickness="2.5" />
                    </Viewbox>

                    <TextBlock Grid.Column="3"
                               Text="{Binding Stamina}"
                               d:Text="74%"
                               FontSize="12"
                               Margin="0,0,7,2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource SubStaminaText}" />

                    <ProgressBar Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="2"
                                 Value="{Binding StaminaValue}"
                                 VerticalAlignment="Bottom"
                                 Background="#26FFFFFF"
                                 BorderThickness="0"
                                 Style="{StaticResource SubStaminaBar}"
                                 d:Value="74" />
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NVMNotification}">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,14,0"
                            Height="26">
                    <Viewbox Width="14">
                        <controls:paTextBlock FormattedText="{Binding SecondMessage}" />
                    </Viewbox>
                    <TextBlock Text="{Binding Message, Converter={StaticResource UppercaseConverter}}"
                               Style="{StaticResource HUD_SemiBold}"
                               FontSize="11"
                               Margin="6,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource RLWhite}" />
                </StackPanel>
            </DataTemplate>

            <Style x:Key="SubColumnHeading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HUD_SemiBold}">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource SubPosition}" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <!--Stock viewbox (DisableHeightScaling) gives the same height scale as the player plate; a plain
        one shrinks the whole panel to fit. PanelRoot is a fixed 400 wide (the plate's width) - with
        only HorizontalAlignment it sized to its text and drew ~0.64x the plate's width.-->
    <controls:baResolutionScaledViewbox DisableHeightScaling="True">

        <Grid Width="400">

            <Grid x:Name="PanelRoot"
                  Width="400"
                  HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=local:paReplacementControl}, Path=HorizontalContentAlignment}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--Header plate-->
                <Grid Margin="30,0,0,0"
                      ClipToBounds="True">
                    <Grid x:Name="HeaderCard">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0" />
                        </Grid.RenderTransform>

                        <Border Background="{StaticResource SubCard}" />

                        <Grid x:Name="HeaderText"
                              Margin="40,0,14,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Converter={StaticResource UppercaseLocalise}, ConverterParameter=Interchange}"
                                           Style="{StaticResource SubMaison}"
                                           FontSize="18" />
                                <TextBlock Text="{Binding ReplacementHeading, Converter={StaticResource UppercaseConverter}}"
                                           d:Text="FORWARDS"
                                           Style="{StaticResource HUD_SemiBold}"
                                           FontSize="11"
                                           Margin="1,-1,0,0"
                                           Foreground="{StaticResource SubPosition}"
                                           Visibility="{Binding ManagingInterchange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding SubsRemainingDisplay}"
                                       d:Text="8"
                                       Style="{StaticResource SubMaison}"
                                       FontSize="16"
                                       Visibility="{Binding ManagingInterchange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <Rectangle Height="3"
                                   VerticalAlignment="Bottom"
                                   Fill="{StaticResource SubGreen}" />
                    </Grid>
                </Grid>

                <!--Crest box-->
                <Grid x:Name="HeaderBox"
                      Width="62"
                      HorizontalAlignment="Left"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>

                    <Path Data="M 10,0 L 62,0 L 52,46 L 0,46 Z"
                          Stretch="None"
                          Fill="{Binding Team.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                          d:Fill="#1F6B45" />
                    <Path Data="M 10,0 L 62,0 L 52,46 L 0,46 Z"
                          Stretch="None">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1AFFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.5" />
                                <GradientStop Color="#33000000" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Image Source="{Binding Team.TeamLogo}"
                           d:Source="/Images/Club_Logos/256/custom.png"
                           Margin="12,5" />
                </Grid>

                <!--Player lists: off on the left, bench on the right; the side not being picked dims-->
                <Grid x:Name="Lists"
                      Grid.Row="1"
                      Margin="0,2,0,0"
                      Visibility="{Binding ManagingInterchange, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="0" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="2" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChoosingBench}" Value="True">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Height="20" Background="{StaticResource SubCard}">
                            <TextBlock Text="{Binding ReplacementHeading, Converter={StaticResource UppercaseConverter}}"
                                       d:Text="FORWARDS"
                                       Style="{StaticResource SubColumnHeading}" />
                        </Border>
                        <controls:paListBox Focusable="False"
                                            SelectedIndex="{Binding SelectedOnFieldPlayer}"
                                            ItemsSource="{Binding OnFieldPlayers}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChoosingBench}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Height="20" Background="{StaticResource SubCard}">
                            <TextBlock Text="{Binding Converter={StaticResource UppercaseLocalise}, ConverterParameter=Bench}"
                                       Style="{StaticResource SubColumnHeading}" />
                        </Border>
                        <controls:paListBox Focusable="False"
                                            SelectedIndex="{Binding SelectedBenchPlayer}"
                                            ItemsSource="{Binding BenchPlayers}" />
                    </StackPanel>
                </Grid>

                <!--Button hints-->
                <Border x:Name="Hints"
                        Grid.Row="2"
                        Margin="0,2,0,0"
                        Height="28"
                        Background="#E612171E">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0" />
                    </Border.RenderTransform>
                    <ItemsControl ItemsSource="{Binding TooltipList}"
                                  Margin="10,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <b:Interaction.Triggers>

                    <!--Intro: crest box pops in, card slides out from behind it, hints drop in-->
                    <b:DataTrigger Binding="{Binding isSubstitutionHudVisible}" Value="True">
                        <b:ControlStoryboardAction>
                            <b:ControlStoryboardAction.Storyboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HeaderBox"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="HeaderBox"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0.4" To="1" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="HeaderBox"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0.4" To="1" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeaderCard"
                                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-370" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="-370" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="0">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeaderText"
                                                                   Storyboard.TargetProperty="Opacity">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hints"
                                                                   Storyboard.TargetProperty="Opacity">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Hints"
                                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-10" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="-10" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimation Storyboard.TargetName="Lists"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0" />
                                </Storyboard>
                            </b:ControlStoryboardAction.Storyboard>
                        </b:ControlStoryboardAction>
                    </b:DataTrigger>

                    <!--Forwards/backs picked: lists slide down out of the header-->
                    <b:DataTrigger Binding="{Binding ManagingInterchange}" Value="True">
                        <b:ControlStoryboardAction>
                            <b:ControlStoryboardAction.Storyboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Lists"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="Lists"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     From="-14" To="0" Duration="0:0:0.3">
                                        <DoubleAnimation.EasingFunction>
                                            <QuinticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </b:ControlStoryboardAction.Storyboard>
                        </b:ControlStoryboardAction>
                    </b:DataTrigger>

                    <!--Outro: the intro reversed, 0.35s (var_0_outro_time in nvm_substitutionhud.lua)-->
                    <b:DataTrigger Binding="{Binding IsClosing}" Value="True">
                        <b:ControlStoryboardAction>
                            <b:ControlStoryboardAction.Storyboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Lists"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="Hints"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="HeaderText"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.1" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeaderCard"
                                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="-370">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <QuinticEase EasingMode="EaseIn" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimation Storyboard.TargetName="HeaderBox"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="1" To="0.4" BeginTime="0:0:0.18" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseIn" Amplitude="0.4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="HeaderBox"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="1" To="0.4" BeginTime="0:0:0.18" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseIn" Amplitude="0.4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="HeaderBox"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0" BeginTime="0:0:0.24" Duration="0:0:0.1" />
                                </Storyboard>
                            </b:ControlStoryboardAction.Storyboard>
                        </b:ControlStoryboardAction>
                    </b:DataTrigger>
                </b:Interaction.Triggers>
            </Grid>
        </Grid>
    </controls:baResolutionScaledViewbox>

</UserControl>
