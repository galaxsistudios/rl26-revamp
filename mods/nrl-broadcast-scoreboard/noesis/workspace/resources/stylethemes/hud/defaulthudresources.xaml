<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:local="clr-namespace:Workspace.Views.HUD.Rugby"
                    xmlns:vm="clr-namespace:Workspace.ViewModels.HUD.Rugby"
                    xmlns:e="clr-namespace:Workspace.Views.Events"
                    xmlns:paEx="clr-namespace:paNoesisExtensions"
                    xmlns:controls="clr-namespace:Workspace.Controls"
                    mc:Ignorable="d">

    <LinearGradientBrush x:Key="OverlayGradient"
                         StartPoint="0,0.5"
                         EndPoint="1,0.5">
        <GradientStop Color="#00000000"
                      Offset="0" />
        <GradientStop Color="#72000000"
                      Offset="1" />
    </LinearGradientBrush>


    <!--ooooooooooooooooooooooooooooo-->
    <!--DEFAULT SCORE CARD (nrl-broadcast-scoreboard) -->
    <!--ooooooooooooooooooooooooooooo-->
    <SolidColorBrush x:Key="ScoreBoardBlack" Color="#000000" />
    <SolidColorBrush x:Key="ScoreBoardDivider" Color="#E6E6E6" />
    <SolidColorBrush x:Key="ScoreBoardTackle" Color="#A6EB4E" />

    <Style x:Key="ScoreBoardJoyride" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily_ScoreJoyride}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ScoreBoardMaison" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily_ScoreMaison}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--hud_score crest when the club has one (ScoreLogo), otherwise the regular TeamLogo.
        Full bar height, width follows the texture's aspect ratio.-->
    <Style x:Key="ScoreBoardCrest" TargetType="Image">
        <Setter Property="Height" Value="45" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ScoreBoardHomeFallbackLogo" TargetType="Image">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HomeTeam.ScoreLogo}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScoreBoardAwayFallbackLogo" TargetType="Image">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding AwayTeam.ScoreLogo}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="ScoreCardTemplate"
                     TargetType="local:paScoreCardControl">

        <ControlTemplate.Resources>

            <DataTemplate x:Key="Cards">
                <Rectangle Fill="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Background}"
                           Margin="2.5,0"
                           MaxWidth="25">
                    <Rectangle.RenderTransform>
                        <TranslateTransform Y="0"
                                            d:Y="-8" />
                    </Rectangle.RenderTransform>

                    <Rectangle.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)"
                                                     From="0"
                                                     To="-8"
                                                     Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <QuinticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Rectangle.Triggers>
                </Rectangle>
            </DataTemplate>
        </ControlTemplate.Resources>

        <controls:baResolutionScaledViewbox>

            <Grid x:Name="RootGrid"
                  Width="580"
                  Height="45">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!--0 home crest (sized by its texture)-->
                    <ColumnDefinition Width="*" />    <!--1 home name-->
                    <ColumnDefinition Width="62" />  <!--2 home score-->
                    <ColumnDefinition Width="2" />   <!--3 divider-->
                    <ColumnDefinition Width="62" />  <!--4 away score-->
                    <ColumnDefinition Width="*" />    <!--5 away name-->
                    <ColumnDefinition Width="Auto" /> <!--6 away crest (sized by its texture)-->
                    <ColumnDefinition Width="96" />  <!--7 clock-->
                    <ColumnDefinition Width="4" />   <!--8 gap-->
                    <ColumnDefinition Width="54" />  <!--9 tackle count-->
                </Grid.ColumnDefinitions>

                <!--Try confirmed banner (slides out from under the bar)-->
                <Grid Height="30" VerticalAlignment="Top" Grid.ColumnSpan="7" ClipToBounds="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A1A1A" Offset="0"/>
                            <GradientStop Color="#000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Grid.RenderTransform>

                    <Path x:Name="ArrowsL" Fill="#4CFFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Data="M18 11L7 22H0L11 11L0 0H7L18 11ZM34 11L23 22H16L27 11L16 0H23L34 11ZM50 11L39 22H32L43 11L32 0H39L50 11ZM66 11L55 22H48L59 11L48 0H55L66 11ZM82 11L71 22H64L75 11L64 0H71L82 11ZM98 11L87 22H80L91 11L80 0H87L98 11ZM103 0L114 11L103 22H96L107 11L96 0H103Z">
                        <Path.RenderTransform>
                            <TranslateTransform X="-100"/>
                        </Path.RenderTransform>
                    </Path>

                    <Path x:Name="ArrowsR" Fill="#4CFFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Data="M96 11L107 22H114L103 11L114 0H107L96 11ZM80 11L91 22H98L87 11L98 0H91L80 11ZM64 11L75 22H82L71 11L82 0H75L64 11ZM48 11L59 22H66L55 11L66 0H59L48 11ZM32 11L43 22H50L39 11L50 0H43L32 11ZM16 11L27 22H34L23 11L34 0H27L16 11ZM11 0L0 11L11 22H18L7 11L18 0H11Z">
                        <Path.RenderTransform>
                            <TranslateTransform X="100"/>
                        </Path.RenderTransform>
                    </Path>

                    <TextBlock Text="{Binding ConverterParameter=TryConfirmed, Converter={StaticResource localise}, Mode=OneWay}" Style="{StaticResource ScoreBoardJoyride}" FontSize="16"/>
                    <b:Interaction.Triggers>
                        <b:DataTrigger Binding="{Binding ShowTryConfirmed}" Value="True">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="0" To="45" Duration="0:0:0.5" BeginTime="0:0:1">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <!--Arrow Anims-->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArrowsL" Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.X)" RepeatBehavior="Forever" BeginTime="0:0:1">
                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-120"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:01.5" Value="120"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:02" Value="120"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="ArrowsL" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" RepeatBehavior="Forever" BeginTime="0:0:1">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#4CFFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:00.4" Value="#4CFFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:00.8" Value="#00FFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:02" Value="#00FFFFFF"/>
                                        </ColorAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArrowsR" Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.X)" RepeatBehavior="Forever" BeginTime="0:0:1">
                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="120"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:01.5" Value="-120"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:02" Value="-120"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="ArrowsR" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" RepeatBehavior="Forever" BeginTime="0:0:1">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#4CFFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:00.4" Value="#4CFFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:00.8" Value="#00FFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:02" Value="#00FFFFFF"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                        <b:DataTrigger Binding="{Binding ShowTryConfirmed}" Value="False">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="45" To="0" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                    </b:Interaction.Triggers>
                </Grid>

                <!--On report banner (mods/referee-on-report): slides out from under the bar like the
                    try confirmed banner, no arrows. MatchStateMessage/ShowMatchState are set by
                    sim/hud/gameplayscore_hud.lua; the stock game never uses them.-->
                <Grid Height="30" VerticalAlignment="Top" Grid.ColumnSpan="7" ClipToBounds="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A1A1A" Offset="0"/>
                            <GradientStop Color="#000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Grid.RenderTransform>

                    <TextBlock Text="{Binding MatchStateMessage}" d:Text="MUNSTER ON REPORT" Style="{StaticResource ScoreBoardJoyride}" FontSize="16"/>
                    <b:Interaction.Triggers>
                        <b:DataTrigger Binding="{Binding ShowMatchState}" Value="True">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="0" To="45" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                        <b:DataTrigger Binding="{Binding ShowMatchState}" Value="False">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="45" To="0" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                    </b:Interaction.Triggers>
                </Grid>

                <!--Interchange banner: slides out from under the bar when a queued interchange is made.
                    Red left arrow + OFF row, green right arrow + ON row, team-colour edge on the left.
                    Interchange* / ShowInterchange are set by NVMScoreCard.showInterchange
                    (app/noesis/hud/nvm_scorecard.lua) from sim/hud/gameplayscore_hud.lua.
                    62 tall, parked 17 up so nothing peeks out under the 45 bar while hidden.
                    Spans crest to clock (not the tackle count, which hides when empty).
                    The -17 bottom margin grows its layout slot to 62: RootGrid is 45 tall and a
                    taller child gets layout-clipped to the slot.-->
                <Grid x:Name="InterchangeBanner"
                      Height="62"
                      Margin="0,0,0,-17"
                      VerticalAlignment="Top"
                      Grid.ColumnSpan="8"
                      Opacity="0"
                      d:Opacity="1">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A1A1A" Offset="0"/>
                            <GradientStop Color="#000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RenderTransform>
                        <TranslateTransform Y="-17"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />  <!--team colour-->
                        <ColumnDefinition Width="34" /> <!--arrow-->
                        <ColumnDefinition Width="58" /> <!--OFF / ON-->
                        <ColumnDefinition Width="40" /> <!--number-->
                        <ColumnDefinition Width="*" />  <!--surname-->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Rectangle Grid.RowSpan="2"
                               Fill="{Binding InterchangeTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                               d:Fill="#2E7D46" />

                    <!--Light team-colour glow at the right end (fill masked, so no binding inside the brush)-->
                    <Rectangle Grid.RowSpan="2"
                               Grid.Column="4"
                               Width="220"
                               HorizontalAlignment="Right"
                               Fill="{Binding InterchangeTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                               d:Fill="#2E7D46">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#99000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <Path Grid.Column="1"
                          Data="M 0,6 L 7,0 L 7,4 L 14,4 L 14,8 L 7,8 L 7,12 Z"
                          Fill="#FFE63232"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="OFF"
                               Style="{StaticResource ScoreBoardJoyride}"
                               FontSize="15"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding InterchangeOffNumber}"
                               d:Text="2"
                               Style="{StaticResource ScoreBoardMaison}"
                               FontSize="15"
                               HorizontalAlignment="Left" />
                    <Viewbox Grid.Column="4"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Left"
                             Margin="0,0,8,0">
                        <TextBlock Text="{Binding InterchangeOffName}"
                                   d:Text="JENNINGS"
                                   Style="{StaticResource ScoreBoardMaison}"
                                   FontSize="15" />
                    </Viewbox>

                    <Path Grid.Row="1"
                          Grid.Column="1"
                          Data="M 14,6 L 7,0 L 7,4 L 0,4 L 0,8 L 7,8 L 7,12 Z"
                          Fill="#FF24DB61"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Text="ON"
                               Style="{StaticResource ScoreBoardJoyride}"
                               FontSize="15"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="3"
                               Text="{Binding InterchangeOnNumber}"
                               d:Text="18"
                               Style="{StaticResource ScoreBoardMaison}"
                               FontSize="15"
                               HorizontalAlignment="Left" />
                    <Viewbox Grid.Row="1"
                             Grid.Column="4"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Left"
                             Margin="0,0,8,0">
                        <TextBlock Text="{Binding InterchangeOnName}"
                                   d:Text="GRAY"
                                   Style="{StaticResource ScoreBoardMaison}"
                                   FontSize="15" />
                    </Viewbox>

                    <b:Interaction.Triggers>
                        <b:DataTrigger Binding="{Binding ShowInterchange}" Value="True">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="-17" To="45" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                        <b:DataTrigger Binding="{Binding ShowInterchange}" Value="False">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="45" To="-17" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.5" Duration="0:0:0" />
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                    </b:Interaction.Triggers>
                </Grid>

                <!--Home name-->
                <Grid x:Name="HomeTeam"
                      Grid.Column="1">
                    <Canvas x:Name="HomeTeamYellowCards"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">

                            <ItemsControl x:Name="HomeYellowCardIC"
                                          ItemsSource="{Binding HomeTeam.YellowCards}"
                                          Width="60"
                                          Height="8"
                                          ItemTemplate="{StaticResource Cards}"
                                          Background="Goldenrod"
                                          d:ItemsSource="{d:SampleData ItemCount=2}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                            </ItemsControl>

                            <ItemsControl x:Name="HomeRedCardIC"
                                          ItemsSource="{Binding HomeTeam.RedCards}"
                                          Width="60"
                                          Height="8"
                                          ItemTemplate="{StaticResource Cards}"
                                          Background="Red"
                                          d:ItemsSource="{d:SampleData ItemCount=1}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                            </ItemsControl>
                        </StackPanel>
                    </Canvas>

                    <Border x:Name="HomeTeamBG"
                            Margin="-1,0,0,0"
                            Background="{Binding HomeTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                            d:Background="#6B1E32" />

                    <Viewbox StretchDirection="DownOnly"
                             Margin="4,0">
                        <TextBlock x:Name="HomeTeamName"
                                   d:Text="MAN"
                                   Text="{Binding HomeTeam.HudName}"
                                   Foreground="{Binding HomeTeam.HudTextColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                   Style="{StaticResource ScoreBoardJoyride}" />
                    </Viewbox>

                </Grid>

                <!--Home crest-->
                <Border x:Name="HomeTeamLogoBG"
                        Grid.Column="0"
                        ClipToBounds="True"
                        Background="{Binding HomeTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                        d:Background="#6B1E32">
                    <Grid>
                        <Image x:Name="HomeTeamLogo"
                               Source="{Binding HomeTeam.TeamLogo}"
                               d:Source="/Images/Club_Logos/256/custom.png"
                               Style="{StaticResource ScoreBoardHomeFallbackLogo}"
                               Width="45"
                               Margin="4" />
                        <Image x:Name="HomeTeamCrest"
                               Source="{Binding HomeTeam.ScoreLogo}"
                               Style="{StaticResource ScoreBoardCrest}" />
                    </Grid>
                </Border>

                <!--Home score-->
                <Border x:Name="HomeTeamScoreBG"
                        Background="{StaticResource ScoreBoardBlack}"
                        Grid.Column="2">
                    <TextBlock x:Name="HomeTeamScoreTB"
                               Style="{StaticResource ScoreBoardJoyride}"
                               FontSize="28"
                               Text="{Binding HomeScore}"
                               d:Text="0" />
                </Border>

                <!--Divider-->
                <Border Grid.Column="3"
                        Background="{StaticResource ScoreBoardBlack}">
                    <Rectangle Fill="{StaticResource ScoreBoardDivider}"
                               Width="2"
                               Margin="0,5" />
                </Border>

                <!--Away score-->
                <Border x:Name="AwayTeamScoreBG"
                        Background="{StaticResource ScoreBoardBlack}"
                        Grid.Column="4">
                    <TextBlock x:Name="AwayTeamScoreTB"
                               Style="{StaticResource ScoreBoardJoyride}"
                               FontSize="28"
                               Text="{Binding AwayScore}"
                               d:Text="0" />
                </Border>

                <!--Away name-->
                <Grid x:Name="AwayTeam"
                      Grid.Column="5">
                    <Canvas x:Name="AwayTeamYellowCards"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">

                            <ItemsControl x:Name="AwayYellowCardIC"
                                      ItemsSource="{Binding AwayTeam.YellowCards}"
                                      Width="60"
                                      Height="8"
                                      Background="Goldenrod"
                                      ItemTemplate="{StaticResource Cards}"
                                      d:ItemsSource="{d:SampleData ItemCount=3}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                            </ItemsControl>
                            <ItemsControl x:Name="AwayRedCardIC"
                                      ItemsSource="{Binding AwayTeam.RedCards}"
                                      Width="60"
                                      Background="Red"
                                      Height="8"
                                      ItemTemplate="{StaticResource Cards}"
                                      d:ItemsSource="{d:SampleData ItemCount=1}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                            </ItemsControl>
                        </StackPanel>
                    </Canvas>

                    <Border x:Name="AwayTeamBG"
                            Margin="0,0,-1,0"
                            Background="{Binding AwayTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                            d:Background="#2E7D46" />

                    <Viewbox StretchDirection="DownOnly"
                             Margin="4,0">
                        <TextBlock x:Name="AwayTeamName"
                                   d:Text="SOU"
                                   Text="{Binding AwayTeam.HudName}"
                                   Foreground="{Binding AwayTeam.HudTextColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                   Style="{StaticResource ScoreBoardJoyride}" />
                    </Viewbox>

                </Grid>

                <!--Away crest-->
                <Border x:Name="AwayTeamLogoBG"
                        Grid.Column="6"
                        ClipToBounds="True"
                        Background="{Binding AwayTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                        d:Background="#2E7D46">
                    <Grid>
                        <Image x:Name="AwayTeamLogo"
                               Source="{Binding AwayTeam.TeamLogo}"
                               d:Source="/Images/Club_Logos/256/custom.png"
                               Style="{StaticResource ScoreBoardAwayFallbackLogo}"
                               Width="45"
                               Margin="4" />
                        <Image x:Name="AwayTeamCrest"
                               Source="{Binding AwayTeam.ScoreLogo}"
                               Style="{StaticResource ScoreBoardCrest}" />
                    </Grid>
                </Border>


                <!--TEMP crest diagnostics (nrl-broadcast-scoreboard): visible only while the fallback logo is shown-->
                <Canvas Grid.Column="0" ClipToBounds="False">
                    <TextBlock Canvas.Top="-20" Text="{Binding HomeTeam.ScoreDebug}" Visibility="{Binding Visibility, ElementName=HomeTeamLogo}"
                               FontSize="11" Foreground="White" Background="#CC000000" Padding="4,1" />
                </Canvas>
                <Canvas Grid.Column="0" ClipToBounds="False">
                    <TextBlock Canvas.Top="48" Text="{Binding AwayTeam.ScoreDebug}" Visibility="{Binding Visibility, ElementName=AwayTeamLogo}"
                               FontSize="11" Foreground="White" Background="#CC000000" Padding="4,1" />
                </Canvas>

                <!--Timer Border-->
                <Border x:Name="TimerBorder"
                        Background="{StaticResource ScoreBoardBlack}"
                        Grid.Column="7">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="HalfTB"
                                   d:Text="1ST HALF"
                                   FontSize="11"
                                   Margin="0,0,0,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource ScoreBoardJoyride}">
                                    <Setter Property="Text"
                                            Value="{Binding HalfAbbr}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HalfAbbr}" Value="H1">
                                            <Setter Property="Text" Value="1ST HALF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HalfAbbr}" Value="1ST">
                                            <Setter Property="Text" Value="1ST HALF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HalfAbbr}" Value="H2">
                                            <Setter Property="Text" Value="2ND HALF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HalfAbbr}" Value="2ND">
                                            <Setter Property="Text" Value="2ND HALF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock x:Name="TimerTB"
                                   Text="{Binding ElapsedSeconds, Converter={StaticResource SecondsToTimeStringConverter}}"
                                   d:Text="01:11"
                                   Style="{StaticResource ScoreBoardMaison}"
                                   FontSize="20" />
                    </StackPanel>
                </Border>

                <!--Tackle Count Border-->
                <Border x:Name="TackleCountBorder"
                        Grid.Column="9"
                        Visibility="{Binding TackleCountVisiblity, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="{StaticResource ScoreBoardTackle}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FadeOutTackleRed}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="#FFE63232" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Viewbox StretchDirection="DownOnly"
                             Margin="3,0">
                        <TextBlock x:Name="TackleCountTB"
                                   Text="{Binding TackleCounter}"
                                   d:Text="1ST"
                                   FontSize="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource ScoreBoardMaison}">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource ScoreBoardBlack}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FadeOutTackleRed}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Viewbox>
                </Border>

                <!--Score / event notifications slide over the team + score section-->
                <Grid x:Name="ScoreGridParent"
                      Grid.Column="0"
                      Grid.ColumnSpan="7">
                    <e:EventView x:Name="EventView"
                                 DataContext="{Binding EventViewDC}"
                                 d:Opacity="0"
                                 HorizontalAlignment="Left" />
                </Grid>
            </Grid>
        </controls:baResolutionScaledViewbox>

    </ControlTemplate>


    <!--ooooooooooooooooooooooooooooo-->
    <!--DEFAULT PLAYER PLATE - LEFT ALIGNED-->
    <!--ooooooooooooooooooooooooooooo-->

    <ControlTemplate x:Key="PlayerPlateTemplate"
                     TargetType="local:paPlayerPlateControl">

        <controls:baResolutionScaledViewbox>

            <Grid Width="350"
                  Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LogoGrid">

                    <Border x:Name="TeamBG"
                            Background="{Binding Team.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                            d:Background="PeachPuff"
                            BorderBrush="{Binding Team.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                            d:BorderBrush="PeachPuff"
                            BorderThickness="0,1">
                        <Rectangle x:Name="TeamOverlay"
                                   Fill="{StaticResource OverlayGradient}" />
                    </Border>

                    <Image x:Name="Logo"
                           Source="{Binding Team.TeamLogo}"
                           d:Source="/Images/Club_logos/256/custom.png"
                           Margin="2.5" />

                </Grid>

                <Border Grid.Column="1"
                        Background="{StaticResource RLWhite}">
                    <TextBlock Style="{StaticResource HUD_ExtraBold}"
                               FontSize="22"
                               Margin="0,-2,0,0"
                               Text="{Binding PlayerNumber}"
                               d:Text="43"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource RLBlack}" />
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource RLBlack}"
                        BorderThickness="0,1">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0.5"
                                             EndPoint="1,0.5">
                            <GradientStop Color="{Binding Team.PrimaryColour}"
                                          d:Color="PeachPuff"
                                          Offset="0" />
                            <GradientStop Color="{StaticResource RLBlackCol}"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Viewbox StretchDirection="DownOnly"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Margin="12,-2,12,0">
                        <TextBlock Text="{Binding PlayerName, Converter={StaticResource UppercaseConverter}}"
                                   d:Text="LASTNAME"
                                   FontSize="22"
                                   Style="{StaticResource HUD_Medium}" />
                    </Viewbox>
                </Border>
                <ProgressBar  Grid.Column="2"
                              Minimum="0"
                              Height="3"
                              Maximum="100"
                              Value="{Binding Stamina}"
                              VerticalAlignment="Bottom"
                              Foreground="{StaticResource RLGreen}"
                              d:Value="50" />
            </Grid>
        </controls:baResolutionScaledViewbox>
    </ControlTemplate>


    <!--ooooooooooooooooooooooooooooo-->
    <!--DEFAULT PLAYER STATISTICS-->
    <!--ooooooooooooooooooooooooooooo-->

    <ControlTemplate TargetType="{x:Type local:PlayerStatisticsControl}"
                     x:Key="PlayerStatisticsTemplate">

        <controls:baResolutionScaledViewbox DisableHeightScaling="True">
            <Grid Width="350"
                  VerticalAlignment="Center" d:DataContext="{d:DesignInstance Type={x:Type vm:paNVMPlayerPlate}, IsDesignTimeCreatable=True}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="LogoGrid">

                        <Border x:Name="TeamBG"
                                Background="{Binding Team.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                d:Background="PeachPuff"
                                BorderBrush="{Binding Team.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                d:BorderBrush="PeachPuff"
                                BorderThickness="0,1">
                            <Rectangle x:Name="TeamOverlay"
                                       Fill="{StaticResource OverlayGradient}" />
                        </Border>

                        <Image x:Name="Logo"
                               Source="{Binding Team.TeamLogo}"
                               d:Source="/Images/Club_logos/256/custom.png"
                               Margin="2.5" />

                    </Grid>

                    <Border Grid.Column="1"
                            Background="{StaticResource RLWhite}">
                        <TextBlock Style="{StaticResource HUD_ExtraBold}"
                                   FontSize="22"
                                   Margin="0,-2,0,0"
                                   Text="{Binding PlayerNumber, Mode=TwoWay, FallbackValue=''}"
                                   d:Text="43"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource RLBlack}" />
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource RLBlack80}"
                            BorderThickness="0,1">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0.5"
                                                 EndPoint="1,0.5">
                                <GradientStop Color="{Binding Team.PrimaryColour}"
                                              d:Color="PeachPuff"
                                              Offset="0" />
                                <GradientStop Color="{StaticResource RLBlackCol}"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Viewbox StretchDirection="DownOnly"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="12,-2,12,0">
                            <TextBlock Text="{Binding PlayerName, Converter={StaticResource UppercaseConverter}}"
                                       FontSize="22"
                                       Style="{StaticResource HUD_Medium}" />
                        </Viewbox>
                    </Border>
                </Grid>

                <Border Background="{StaticResource RLBlack80}"
                        BorderBrush="{StaticResource ButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Grid.Row="1"
                        Height="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <TextBlock Text="{Binding PlayerPosition, Mode=TwoWay, Converter={StaticResource UppercaseConverter}, FallbackValue=''}"
                                   d:Text="POSITION"
                                   Margin="10,5"
                                   FontSize="18"
                                   Style="{StaticResource HUD_Bold}" />


                        <ItemsControl ItemsSource="{Binding PlayerStatsHud}"
                                      d:ItemsSource="{d:SampleData ItemCount=3}"
                                      Grid.Row="1"
                                      Margin="-1,0,-1,5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3.5"
                                            Height="27"
                                            BorderBrush="{StaticResource ButtonBorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Background="#161616">

                                        <Grid ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="0.4*" />
                                            </Grid.ColumnDefinitions>

                                            <Rectangle Fill="#202020">
                                                <Rectangle.Effect>
                                                    <DropShadowEffect ShadowDepth="4"
                                                                      Color="Black"
                                                                      Opacity="0.3"
                                                                      BlurRadius="5"
                                                                      Direction="0" />
                                                </Rectangle.Effect>
                                            </Rectangle>
                                            <TextBlock Style="{StaticResource HUD_Medium}"
                                                       Text="{Binding Message, Mode=TwoWay, Converter={StaticResource UppercaseConverter}}"
                                                       Margin="10,0"
                                                       FontSize="18"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource  HUD_Bold}"
                                                       Text="{Binding SecondMessage, Mode=TwoWay, Converter={StaticResource UppercaseConverter}}"
                                                       FontSize="18"
                                                       d:Text="1995"
                                                       Margin="10,0"
                                                       Grid.Column="2"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                </Border>


            </Grid>

        </controls:baResolutionScaledViewbox>
    </ControlTemplate>




</ResourceDictionary>