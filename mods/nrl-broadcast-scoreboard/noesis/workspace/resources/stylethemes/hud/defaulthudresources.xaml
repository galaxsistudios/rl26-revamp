<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:local="clr-namespace:Workspace.Views.HUD.Rugby"
                    xmlns:vm="clr-namespace:Workspace.ViewModels.HUD.Rugby"
                    xmlns:e="clr-namespace:Workspace.Views.Events"
                    xmlns:paEx="clr-namespace:paNoesisExtensions"
                    xmlns:controls="clr-namespace:Workspace.Controls"
                    mc:Ignorable="d">

    <LinearGradientBrush x:Key="OverlayGradient"
                         StartPoint="0,0.5"
                         EndPoint="1,0.5">
        <GradientStop Color="#00000000"
                      Offset="0" />
        <GradientStop Color="#72000000"
                      Offset="1" />
    </LinearGradientBrush>


    <!--ooooooooooooooooooooooooooooo-->
    <!--DEFAULT SCORE CARD (nrl-broadcast-scoreboard) -->
    <!--ooooooooooooooooooooooooooooo-->
    <SolidColorBrush x:Key="ScoreBoardBlack" Color="#000000" />
    <SolidColorBrush x:Key="ScoreBoardDivider" Color="#E6E6E6" />
    <SolidColorBrush x:Key="ScoreBoardTackle" Color="#A6EB4E" />

    <Style x:Key="ScoreBoardJoyride" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily_ScoreJoyride}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ScoreBoardMaison" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily_ScoreMaison}" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--hud_score crest when the club has one (ScoreLogo), otherwise the regular TeamLogo.
        Full bar height, width follows the texture's aspect ratio.-->
    <Style x:Key="ScoreBoardCrest" TargetType="Image">
        <Setter Property="Height" Value="45" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ScoreBoardHomeFallbackLogo" TargetType="Image">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HomeTeam.ScoreLogo}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScoreBoardAwayFallbackLogo" TargetType="Image">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding AwayTeam.ScoreLogo}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="ScoreCardTemplate"
                     TargetType="local:paScoreCardControl">

        <ControlTemplate.Resources>

            <DataTemplate x:Key="Cards">
                <Rectangle Fill="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Background}"
                           Margin="2.5,0"
                           MaxWidth="25">
                    <Rectangle.RenderTransform>
                        <TranslateTransform Y="0"
                                            d:Y="-8" />
                    </Rectangle.RenderTransform>

                    <Rectangle.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(Rectangle.RenderTransform).(TranslateTransform.Y)"
                                                     From="0"
                                                     To="-8"
                                                     Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <QuinticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Rectangle.Triggers>
                </Rectangle>
            </DataTemplate>
        </ControlTemplate.Resources>

        <controls:baResolutionScaledViewbox>

            <Grid x:Name="RootGrid"
                  Width="580"
                  Height="45">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!--0 home crest (sized by its texture)-->
                    <ColumnDefinition Width="*" />    <!--1 home name-->
                    <ColumnDefinition Width="62" />  <!--2 home score-->
                    <ColumnDefinition Width="2" />   <!--3 divider-->
                    <ColumnDefinition Width="62" />  <!--4 away score-->
                    <ColumnDefinition Width="*" />    <!--5 away name-->
                    <ColumnDefinition Width="Auto" /> <!--6 away crest (sized by its texture)-->
                    <ColumnDefinition Width="96" />  <!--7 clock-->
                    <ColumnDefinition Width="4" />   <!--8 gap-->
                    <ColumnDefinition Width="54" />  <!--9 tackle count-->
                </Grid.ColumnDefinitions>

                <!--Try confirmed banner (slides out from under the bar)-->
                <Grid Height="30" VerticalAlignment="Top" Grid.ColumnSpan="7" ClipToBounds="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A1A1A" Offset="0"/>
                            <GradientStop Color="#000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Grid.RenderTransform>

                    <Path x:Name="ArrowsL" Fill="#4CFFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Data="M18 11L7 22H0L11 11L0 0H7L18 11ZM34 11L23 22H16L27 11L16 0H23L34 11ZM50 11L39 22H32L43 11L32 0H39L50 11ZM66 11L55 22H48L59 11L48 0H55L66 11ZM82 11L71 22H64L75 11L64 0H71L82 11ZM98 11L87 22H80L91 11L80 0H87L98 11ZM103 0L114 11L103 22H96L107 11L96 0H103Z">
                        <Path.RenderTransform>
                            <TranslateTransform X="-100"/>
                        </Path.RenderTransform>
                    </Path>

                    <Path x:Name="ArrowsR" Fill="#4CFFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Data="M96 11L107 22H114L103 11L114 0H107L96 11ZM80 11L91 22H98L87 11L98 0H91L80 11ZM64 11L75 22H82L71 11L82 0H75L64 11ZM48 11L59 22H66L55 11L66 0H59L48 11ZM32 11L43 22H50L39 11L50 0H43L32 11ZM16 11L27 22H34L23 11L34 0H27L16 11ZM11 0L0 11L11 22H18L7 11L18 0H11Z">
                        <Path.RenderTransform>
                            <TranslateTransform X="100"/>
                        </Path.RenderTransform>
                    </Path>

                    <TextBlock Text="{Binding ConverterParameter=TryConfirmed, Converter={StaticResource localise}, Mode=OneWay}" Style="{StaticResource ScoreBoardJoyride}" FontSize="16"/>
                    <b:Interaction.Triggers>
                        <b:DataTrigger Binding="{Binding ShowTryConfirmed}" Value="True">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="0" To="45" Duration="0:0:0.5" BeginTime="0:0:1">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <!--Arrow Anims-->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArrowsL" Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.X)" RepeatBehavior="Forever" BeginTime="0:0:1">
                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="-120"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:01.5" Value="120"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:02" Value="120"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="ArrowsL" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" RepeatBehavior="Forever" BeginTime="0:0:1">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#4CFFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:00.4" Value="#4CFFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:00.8" Value="#00FFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:02" Value="#00FFFFFF"/>
                                        </ColorAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ArrowsR" Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.X)" RepeatBehavior="Forever" BeginTime="0:0:1">
                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="120"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:01.5" Value="-120"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:02" Value="-120"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="ArrowsR" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" RepeatBehavior="Forever" BeginTime="0:0:1">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#4CFFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:00.4" Value="#4CFFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:00.8" Value="#00FFFFFF"/>
                                            <EasingColorKeyFrame KeyTime="00:00:02" Value="#00FFFFFF"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                        <b:DataTrigger Binding="{Binding ShowTryConfirmed}" Value="False">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="45" To="0" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                    </b:Interaction.Triggers>
                </Grid>

                <!--On report banner (mods/referee-on-report): slides out from under the bar like the
                    try confirmed banner, no arrows. MatchStateMessage/ShowMatchState are set by
                    sim/hud/gameplayscore_hud.lua; the stock game never uses them.-->
                <Grid Height="30" VerticalAlignment="Top" Grid.ColumnSpan="7" ClipToBounds="True">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A1A1A" Offset="0"/>
                            <GradientStop Color="#000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Grid.RenderTransform>

                    <TextBlock Text="{Binding MatchStateMessage}" d:Text="MUNSTER ON REPORT" Style="{StaticResource ScoreBoardJoyride}" FontSize="16"/>
                    <b:Interaction.Triggers>
                        <b:DataTrigger Binding="{Binding ShowMatchState}" Value="True">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="0" To="45" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                        <b:DataTrigger Binding="{Binding ShowMatchState}" Value="False">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="45" To="0" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                    </b:Interaction.Triggers>
                </Grid>

                <!--Interchange banner: slides out from under the bar when a queued interchange is made.
                    Red left arrow + OFF row, green right arrow + ON row, team-colour edge on the left.
                    Interchange* / ShowInterchange are set by NVMScoreCard.showInterchange
                    (app/noesis/hud/nvm_scorecard.lua) from sim/hud/gameplayscore_hud.lua.
                    62 tall, parked 17 up so nothing peeks out under the 45 bar while hidden.
                    Spans crest to clock (not the tackle count, which hides when empty).
                    The -17 bottom margin grows its layout slot to 62: RootGrid is 45 tall and a
                    taller child gets layout-clipped to the slot.-->
                <Grid x:Name="InterchangeBanner"
                      Height="62"
                      Margin="0,0,0,-17"
                      VerticalAlignment="Top"
                      Grid.ColumnSpan="8"
                      Opacity="0"
                      d:Opacity="1">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A1A1A" Offset="0"/>
                            <GradientStop Color="#000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RenderTransform>
                        <TranslateTransform Y="-17"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />  <!--team colour-->
                        <ColumnDefinition Width="34" /> <!--arrow-->
                        <ColumnDefinition Width="58" /> <!--OFF / ON-->
                        <ColumnDefinition Width="40" /> <!--number-->
                        <ColumnDefinition Width="*" />  <!--surname-->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Rectangle Grid.RowSpan="2"
                               Fill="{Binding InterchangeTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                               d:Fill="#2E7D46" />

                    <!--Light team-colour glow at the right end (fill masked, so no binding inside the brush)-->
                    <Rectangle Grid.RowSpan="2"
                               Grid.Column="4"
                               Width="220"
                               HorizontalAlignment="Right"
                               Fill="{Binding InterchangeTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                               d:Fill="#2E7D46">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#99000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <Path Grid.Column="1"
                          Data="M 0,6 L 7,0 L 7,4 L 14,4 L 14,8 L 7,8 L 7,12 Z"
                          Fill="#FFE63232"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="OFF"
                               Style="{StaticResource ScoreBoardJoyride}"
                               FontSize="15"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding InterchangeOffNumber}"
                               d:Text="2"
                               Style="{StaticResource ScoreBoardMaison}"
                               FontSize="15"
                               HorizontalAlignment="Left" />
                    <Viewbox Grid.Column="4"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Left"
                             Margin="0,0,8,0">
                        <TextBlock Text="{Binding InterchangeOffName}"
                                   d:Text="JENNINGS"
                                   Style="{StaticResource ScoreBoardMaison}"
                                   FontSize="15" />
                    </Viewbox>

                    <Path Grid.Row="1"
                          Grid.Column="1"
                          Data="M 14,6 L 7,0 L 7,4 L 0,4 L 0,8 L 7,8 L 7,12 Z"
                          Fill="#FF24DB61"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Text="ON"
                               Style="{StaticResource ScoreBoardJoyride}"
                               FontSize="15"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="3"
                               Text="{Binding InterchangeOnNumber}"
                               d:Text="18"
                               Style="{StaticResource ScoreBoardMaison}"
                               FontSize="15"
                               HorizontalAlignment="Left" />
                    <Viewbox Grid.Row="1"
                             Grid.Column="4"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Left"
                             Margin="0,0,8,0">
                        <TextBlock Text="{Binding InterchangeOnName}"
                                   d:Text="GRAY"
                                   Style="{StaticResource ScoreBoardMaison}"
                                   FontSize="15" />
                    </Viewbox>

                    <b:Interaction.Triggers>
                        <b:DataTrigger Binding="{Binding ShowInterchange}" Value="True">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="-17" To="45" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                        <b:DataTrigger Binding="{Binding ShowInterchange}" Value="False">
                            <b:ControlStoryboardAction>
                                <b:ControlStoryboardAction.Storyboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="45" To="-17" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.5" Duration="0:0:0" />
                                    </Storyboard>
                                </b:ControlStoryboardAction.Storyboard>
                            </b:ControlStoryboardAction>
                        </b:DataTrigger>
                    </b:Interaction.Triggers>
                </Grid>

                <!--Home name-->
                <Grid x:Name="HomeTeam"
                      Grid.Column="1">
                    <Canvas x:Name="HomeTeamYellowCards"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">

                            <ItemsControl x:Name="HomeYellowCardIC"
                                          ItemsSource="{Binding HomeTeam.YellowCards}"
                                          Width="60"
                                          Height="8"
                                          ItemTemplate="{StaticResource Cards}"
                                          Background="Goldenrod"
                                          d:ItemsSource="{d:SampleData ItemCount=2}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                            </ItemsControl>

                            <ItemsControl x:Name="HomeRedCardIC"
                                          ItemsSource="{Binding HomeTeam.RedCards}"
                                          Width="60"
                                          Height="8"
                                          ItemTemplate="{StaticResource Cards}"
                                          Background="Red"
                                          d:ItemsSource="{d:SampleData ItemCount=1}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                            </ItemsControl>
                        </StackPanel>
                    </Canvas>

                    <Border x:Name="HomeTeamBG"
                            Margin="-1,0,0,0"
                            Background="{Binding HomeTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                            d:Background="#6B1E32" />

                    <Viewbox StretchDirection="DownOnly"
                             Margin="4,0">
                        <TextBlock x:Name="HomeTeamName"
                                   d:Text="MAN"
                                   Text="{Binding HomeTeam.HudName}"
                                   Foreground="{Binding HomeTeam.HudTextColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                   Style="{StaticResource ScoreBoardJoyride}" />
                    </Viewbox>

                </Grid>

                <!--Home crest-->
                <Border x:Name="HomeTeamLogoBG"
                        Grid.Column="0"
                        ClipToBounds="True"
                        Background="{Binding HomeTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                        d:Background="#6B1E32">
                    <Grid>
                        <Image x:Name="HomeTeamLogo"
                               Source="{Binding HomeTeam.TeamLogo}"
                               d:Source="/Images/Club_Logos/256/custom.png"
                               Style="{StaticResource ScoreBoardHomeFallbackLogo}"
                               Width="45"
                               Margin="4" />
                        <Image x:Name="HomeTeamCrest"
                               Source="{Binding HomeTeam.ScoreLogo}"
                               Style="{StaticResource ScoreBoardCrest}" />
                    </Grid>
                </Border>

                <!--Home score-->
                <Border x:Name="HomeTeamScoreBG"
                        Background="{StaticResource ScoreBoardBlack}"
                        Grid.Column="2">
                    <TextBlock x:Name="HomeTeamScoreTB"
                               Style="{StaticResource ScoreBoardJoyride}"
                               FontSize="28"
                               Text="{Binding HomeScore}"
                               d:Text="0" />
                </Border>

                <!--Divider-->
                <Border Grid.Column="3"
                        Background="{StaticResource ScoreBoardBlack}">
                    <Rectangle Fill="{StaticResource ScoreBoardDivider}"
                               Width="2"
                               Margin="0,5" />
                </Border>

                <!--Away score-->
                <Border x:Name="AwayTeamScoreBG"
                        Background="{StaticResource ScoreBoardBlack}"
                        Grid.Column="4">
                    <TextBlock x:Name="AwayTeamScoreTB"
                               Style="{StaticResource ScoreBoardJoyride}"
                               FontSize="28"
                               Text="{Binding AwayScore}"
                               d:Text="0" />
                </Border>

                <!--Away name-->
                <Grid x:Name="AwayTeam"
                      Grid.Column="5">
                    <Canvas x:Name="AwayTeamYellowCards"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">

                            <ItemsControl x:Name="AwayYellowCardIC"
                                      ItemsSource="{Binding AwayTeam.YellowCards}"
                                      Width="60"
                                      Height="8"
                                      Background="Goldenrod"
                                      ItemTemplate="{StaticResource Cards}"
                                      d:ItemsSource="{d:SampleData ItemCount=3}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                            </ItemsControl>
                            <ItemsControl x:Name="AwayRedCardIC"
                                      ItemsSource="{Binding AwayTeam.RedCards}"
                                      Width="60"
                                      Background="Red"
                                      Height="8"
                                      ItemTemplate="{StaticResource Cards}"
                                      d:ItemsSource="{d:SampleData ItemCount=1}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                            </ItemsControl>
                        </StackPanel>
                    </Canvas>

                    <Border x:Name="AwayTeamBG"
                            Margin="0,0,-1,0"
                            Background="{Binding AwayTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                            d:Background="#2E7D46" />

                    <Viewbox StretchDirection="DownOnly"
                             Margin="4,0">
                        <TextBlock x:Name="AwayTeamName"
                                   d:Text="SOU"
                                   Text="{Binding AwayTeam.HudName}"
                                   Foreground="{Binding AwayTeam.HudTextColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                   Style="{StaticResource ScoreBoardJoyride}" />
                    </Viewbox>

                </Grid>

                <!--Away crest-->
                <Border x:Name="AwayTeamLogoBG"
                        Grid.Column="6"
                        ClipToBounds="True"
                        Background="{Binding AwayTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                        d:Background="#2E7D46">
                    <Grid>
                        <Image x:Name="AwayTeamLogo"
                               Source="{Binding AwayTeam.TeamLogo}"
                               d:Source="/Images/Club_Logos/256/custom.png"
                               Style="{StaticResource ScoreBoardAwayFallbackLogo}"
                               Width="45"
                               Margin="4" />
                        <Image x:Name="AwayTeamCrest"
                               Source="{Binding AwayTeam.ScoreLogo}"
                               Style="{StaticResource ScoreBoardCrest}" />
                    </Grid>
                </Border>


                <!--TEMP crest diagnostics (nrl-broadcast-scoreboard): visible only while the fallback logo is shown-->
                <Canvas Grid.Column="0" ClipToBounds="False">
                    <TextBlock Canvas.Top="-20" Text="{Binding HomeTeam.ScoreDebug}" Visibility="{Binding Visibility, ElementName=HomeTeamLogo}"
                               FontSize="11" Foreground="White" Background="#CC000000" Padding="4,1" />
                </Canvas>
                <Canvas Grid.Column="0" ClipToBounds="False">
                    <TextBlock Canvas.Top="48" Text="{Binding AwayTeam.ScoreDebug}" Visibility="{Binding Visibility, ElementName=AwayTeamLogo}"
                               FontSize="11" Foreground="White" Background="#CC000000" Padding="4,1" />
                </Canvas>

                <!--Timer Border-->
                <Border x:Name="TimerBorder"
                        Background="{StaticResource ScoreBoardBlack}"
                        Grid.Column="7">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="HalfTB"
                                   d:Text="1ST HALF"
                                   FontSize="11"
                                   Margin="0,0,0,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource ScoreBoardJoyride}">
                                    <Setter Property="Text"
                                            Value="{Binding HalfAbbr}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HalfAbbr}" Value="H1">
                                            <Setter Property="Text" Value="1ST HALF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HalfAbbr}" Value="1ST">
                                            <Setter Property="Text" Value="1ST HALF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HalfAbbr}" Value="H2">
                                            <Setter Property="Text" Value="2ND HALF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HalfAbbr}" Value="2ND">
                                            <Setter Property="Text" Value="2ND HALF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock x:Name="TimerTB"
                                   Text="{Binding ElapsedSeconds, Converter={StaticResource SecondsToTimeStringConverter}}"
                                   d:Text="01:11"
                                   Style="{StaticResource ScoreBoardMaison}"
                                   FontSize="20" />
                    </StackPanel>
                </Border>

                <!--Tackle Count Border-->
                <Border x:Name="TackleCountBorder"
                        Grid.Column="9"
                        Visibility="{Binding TackleCountVisiblity, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="{StaticResource ScoreBoardTackle}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FadeOutTackleRed}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="#FFE63232" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Viewbox StretchDirection="DownOnly"
                             Margin="3,0">
                        <TextBlock x:Name="TackleCountTB"
                                   Text="{Binding TackleCounter}"
                                   d:Text="1ST"
                                   FontSize="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource ScoreBoardMaison}">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource ScoreBoardBlack}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FadeOutTackleRed}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Viewbox>
                </Border>

                <!--Score / event notifications slide over the team + score section-->
                <Grid x:Name="ScoreGridParent"
                      Grid.Column="0"
                      Grid.ColumnSpan="7">
                    <e:EventView x:Name="EventView"
                                 DataContext="{Binding EventViewDC}"
                                 d:Opacity="0"
                                 HorizontalAlignment="Left" />
                </Grid>
            </Grid>
        </controls:baResolutionScaledViewbox>

    </ControlTemplate>


    <!--ooooooooooooooooooooooooooooo-->
    <!--DEFAULT PLAYER PLATE (nrl-broadcast-scoreboard)-->
    <!--Slanted team-colour number box, dark card with name + position, stamina underline.
        RevealKey (sim/hud/playerinfo_hud.lua) changes whenever a different player is shown or
        the plate reappears: the box pops in, then the card slides out from behind it.-->
    <!--ooooooooooooooooooooooooooooo-->

    <SolidColorBrush x:Key="PlayerPlateCard" Color="#12171E" />
    <SolidColorBrush x:Key="PlayerPlatePosition" Color="#8FA39A" />

    <ControlTemplate x:Key="PlayerPlateTemplate"
                     TargetType="local:paPlayerPlateControl">

        <controls:baResolutionScaledViewbox>

            <Grid x:Name="PlateRoot"
                  Width="400"
                  Height="46">

                <!--Card: clipped from the middle of the box so it emerges from behind it-->
                <Grid Margin="30,0,0,0"
                      ClipToBounds="True">
                    <Grid x:Name="Card">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0" />
                        </Grid.RenderTransform>

                        <Border Background="{StaticResource PlayerPlateCard}" />

                        <StackPanel x:Name="CardText"
                                    Margin="40,0,24,3"
                                    VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform X="0" />
                            </StackPanel.RenderTransform>
                            <Viewbox StretchDirection="DownOnly"
                                     HorizontalAlignment="Left">
                                <TextBlock Text="{Binding PlayerName, Converter={StaticResource UppercaseConverter}}"
                                           d:Text="JYE GRAY"
                                           Style="{StaticResource ScoreBoardMaison}"
                                           FontSize="20"
                                           HorizontalAlignment="Left" />
                            </Viewbox>
                            <TextBlock Text="{Binding PlayerPosition, Converter={StaticResource UppercaseConverter}}"
                                       d:Text="FULLBACK"
                                       Style="{StaticResource HUD_SemiBold}"
                                       FontSize="11"
                                       Margin="1,-1,0,0"
                                       Foreground="{StaticResource PlayerPlatePosition}" />
                        </StackPanel>

                        <!--RATTLED tag (discipline-meter): a short personal slump after being
                            penalised, fended or big-hit-->
                        <TextBlock Text="RATTLED"
                                   FontSize="11"
                                   Foreground="#FFE63232"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,24,9">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource HUD_SemiBold}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRattled}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--Stamina underline-->
                        <ProgressBar x:Name="StaminaBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="3"
                                     RenderTransformOrigin="0,0.5"
                                     Value="{Binding Stamina}"
                                     VerticalAlignment="Bottom"
                                     Background="#33FFFFFF"
                                     BorderThickness="0"
                                     d:Value="80">
                            <!--StaminaLevel (nvm_playerplate.lua): 0 >=60%, 1 >=40%, 2 >=20%, 3 below-->
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar"
                                       BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <!--Not RLGreen: rl26-revamp-branding recolours that to blue-->
                                    <Setter Property="Foreground"
                                            Value="#FF24DB61" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StaminaLevel}"
                                                     Value="1">
                                            <Setter Property="Foreground"
                                                    Value="#FFF2D21B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StaminaLevel}"
                                                     Value="2">
                                            <Setter Property="Foreground"
                                                    Value="#FFFF8A1F" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StaminaLevel}"
                                                     Value="3">
                                            <Setter Property="Foreground"
                                                    Value="#FFE63232" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                            <ProgressBar.RenderTransform>
                                <ScaleTransform ScaleX="1" />
                            </ProgressBar.RenderTransform>
                        </ProgressBar>

                        <!--Discipline bar (discipline-meter, HasDiscipline false = hidden): vertical,
                            on the right edge of the card, fills from the bottom. The fill height is
                            set in px by nvm_playerplate.lua (DisciplineFill, track = 34px, keep
                            var_0_discipline_bar_height in step). Ice blue when settled, then the
                            stamina bands: yellow, orange, red-->
                        <Grid x:Name="DisciplineBar"
                              Width="5"
                              Height="34"
                              Margin="0,0,10,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,1">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDiscipline}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleY="1" />
                            </Grid.RenderTransform>

                            <Border Background="#33FFFFFF" />
                            <Border Height="{Binding DisciplineFill}"
                                    d:Height="20"
                                    VerticalAlignment="Bottom">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"
                                                Value="#FF5AC8FA" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DisciplineLevel}"
                                                         Value="1">
                                                <Setter Property="Background"
                                                        Value="#FFF2D21B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DisciplineLevel}"
                                                         Value="2">
                                                <Setter Property="Background"
                                                        Value="#FFFF8A1F" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DisciplineLevel}"
                                                         Value="3">
                                                <Setter Property="Background"
                                                        Value="#FFE63232" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!--Number box-->
                <Grid x:Name="NumberBox"
                      Width="62"
                      HorizontalAlignment="Left"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="1"
                                        ScaleY="1" />
                    </Grid.RenderTransform>

                    <Path Data="M 10,0 L 62,0 L 52,46 L 0,46 Z"
                          Stretch="None"
                          Fill="{Binding Team.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                          d:Fill="#1F6B45" />
                    <Path Data="M 10,0 L 62,0 L 52,46 L 0,46 Z"
                          Stretch="None">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                <GradientStop Color="#1AFFFFFF"
                                              Offset="0" />
                                <GradientStop Color="#00FFFFFF"
                                              Offset="0.5" />
                                <GradientStop Color="#33000000"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <TextBlock Text="{Binding PlayerNumber}"
                               d:Text="1"
                               Style="{StaticResource ScoreBoardMaison}"
                               FontSize="24"
                               Margin="0,-1,0,0"
                               Foreground="{Binding Team.HudTextColour, Converter={StaticResource ColorToSolidColorBrushConverter}}" />
                </Grid>

                <b:Interaction.Triggers>
                    <b:PropertyChangedTrigger Binding="{Binding RevealKey}">
                        <b:ControlStoryboardAction>
                            <b:ControlStoryboardAction.Storyboard>
                                <Storyboard>
                                    <!--Box pops in-->
                                    <DoubleAnimation Storyboard.TargetName="NumberBox"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0"
                                                     To="1"
                                                     Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="NumberBox"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0.4"
                                                     To="1"
                                                     Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut"
                                                      Amplitude="0.4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="NumberBox"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0.4"
                                                     To="1"
                                                     Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut"
                                                      Amplitude="0.4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>

                                    <!--Card slides out from behind the box-->
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Card"
                                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                                                Value="-370" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.18"
                                                              Value="-370" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.55"
                                                              Value="0">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>

                                    <!--Text fades up as the card lands-->
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardText"
                                                                   Storyboard.TargetProperty="Opacity">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0"
                                                                Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.3"
                                                              Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.55"
                                                              Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </b:ControlStoryboardAction.Storyboard>
                        </b:ControlStoryboardAction>
                    </b:PropertyChangedTrigger>

                    <!--Outro = the intro reversed: text fades, card slides back behind the box,
                        then the box shrinks away. HideKey is bumped by nvm_playerplate.lua, which
                        keeps the plate visible for 0.45s (var_0_outro_time) - keep them in step.-->
                    <b:PropertyChangedTrigger Binding="{Binding HideKey}">
                        <b:ControlStoryboardAction>
                            <b:ControlStoryboardAction.Storyboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardText"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="0:0:0.12" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Card"
                                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0"
                                                              Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.3"
                                                              Value="-370">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <QuinticEase EasingMode="EaseIn" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimation Storyboard.TargetName="NumberBox"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="1"
                                                     To="0.4"
                                                     BeginTime="0:0:0.25"
                                                     Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseIn"
                                                      Amplitude="0.4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="NumberBox"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="1"
                                                     To="0.4"
                                                     BeginTime="0:0:0.25"
                                                     Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseIn"
                                                      Amplitude="0.4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="NumberBox"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="1"
                                                     To="0"
                                                     BeginTime="0:0:0.33"
                                                     Duration="0:0:0.12" />
                                </Storyboard>
                            </b:ControlStoryboardAction.Storyboard>
                        </b:ControlStoryboardAction>
                    </b:PropertyChangedTrigger>

                    <!--Player switch on a plate that's already up: box and card stay put,
                        the name/position slide in and the stamina bar wipes across-->
                    <b:PropertyChangedTrigger Binding="{Binding SwitchKey}">
                        <b:ControlStoryboardAction>
                            <b:ControlStoryboardAction.Storyboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardText"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0"
                                                     To="1"
                                                     Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="CardText"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-24"
                                                     To="0"
                                                     Duration="0:0:0.3">
                                        <DoubleAnimation.EasingFunction>
                                            <QuinticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="StaminaBar"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0"
                                                     To="1"
                                                     Duration="0:0:0.35">
                                        <DoubleAnimation.EasingFunction>
                                            <QuinticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="DisciplineBar"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0"
                                                     To="1"
                                                     BeginTime="0:0:0.06"
                                                     Duration="0:0:0.35">
                                        <DoubleAnimation.EasingFunction>
                                            <QuinticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </b:ControlStoryboardAction.Storyboard>
                        </b:ControlStoryboardAction>
                    </b:PropertyChangedTrigger>
                </b:Interaction.Triggers>
            </Grid>
        </controls:baResolutionScaledViewbox>
    </ControlTemplate>


    <!--ooooooooooooooooooooooooooooo-->
    <!--DEFAULT PLAYER STATISTICS (nrl-broadcast-scoreboard)-->
    <!--Player plate look: number in the slanted team-colour box, name over position, crest at
        the right, green underline, then the stat rows. Binds the Shown* copies that
        nvm_playerstatisticshud.lua takes in show(), so the card keeps its data while animating
        out. RevealKey -> intro (box pops, card slides, rows drop in), HideKey -> 0.3s outro.-->
    <!--ooooooooooooooooooooooooooooo-->

    <ControlTemplate TargetType="{x:Type local:PlayerStatisticsControl}"
                     x:Key="PlayerStatisticsTemplate">

        <controls:baResolutionScaledViewbox DisableHeightScaling="True">
            <Grid x:Name="StatsRoot"
                  Width="400"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--Header plate-->
                <Grid Margin="30,0,0,0"
                      ClipToBounds="True">
                    <Grid x:Name="StatsCard">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0" />
                        </Grid.RenderTransform>

                        <Border Background="{StaticResource PlayerPlateCard}" />

                        <Image Source="{Binding ShownTeam.TeamLogo}"
                               HorizontalAlignment="Right"
                               Height="34"
                               Margin="0,0,8,3"
                               Opacity="0.9" />

                        <StackPanel x:Name="StatsHeaderText"
                                    Margin="40,0,56,3"
                                    VerticalAlignment="Center">
                            <Viewbox StretchDirection="DownOnly"
                                     HorizontalAlignment="Left">
                                <TextBlock Text="{Binding ShownName, Converter={StaticResource UppercaseConverter}}"
                                           d:Text="S. CRICHTON"
                                           Style="{StaticResource ScoreBoardMaison}"
                                           FontSize="20"
                                           HorizontalAlignment="Left" />
                            </Viewbox>
                            <TextBlock Text="{Binding ShownPosition, Converter={StaticResource UppercaseConverter}}"
                                       d:Text="FIVE-EIGHTH"
                                       Style="{StaticResource HUD_SemiBold}"
                                       FontSize="11"
                                       Margin="1,-1,0,0"
                                       Foreground="{StaticResource PlayerPlatePosition}" />
                        </StackPanel>

                        <Rectangle Height="3"
                                   VerticalAlignment="Bottom"
                                   Fill="#FF24DB61" />
                    </Grid>
                </Grid>

                <!--Number box-->
                <Grid x:Name="StatsNumberBox"
                      Width="62"
                      HorizontalAlignment="Left"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>

                    <Path Data="M 10,0 L 62,0 L 52,46 L 0,46 Z"
                          Stretch="None"
                          Fill="{Binding ShownTeam.PrimaryColour, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                          d:Fill="#1F6B45" />
                    <Path Data="M 10,0 L 62,0 L 52,46 L 0,46 Z"
                          Stretch="None">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1AFFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.5" />
                                <GradientStop Color="#33000000" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <TextBlock Text="{Binding ShownNumber}"
                               d:Text="6"
                               Style="{StaticResource ScoreBoardMaison}"
                               FontSize="24"
                               Margin="0,-1,0,0"
                               Foreground="{Binding ShownTeam.HudTextColour, Converter={StaticResource ColorToSolidColorBrushConverter}}" />
                </Grid>

                <!--Stat rows-->
                <ItemsControl x:Name="StatsRows"
                              Grid.Row="1"
                              Margin="0,2,0,0"
                              ItemsSource="{Binding ShownStats}"
                              d:ItemsSource="{d:SampleData ItemCount=2}">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform Y="0" />
                    </ItemsControl.RenderTransform>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32"
                                  Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.ColumnSpan="2"
                                        Background="{StaticResource PlayerPlateCard}" />
                                <Border Grid.Column="1"
                                        Background="#0B0F14" />
                                <Rectangle Width="3"
                                           HorizontalAlignment="Left"
                                           Fill="{Binding DataContext.ShownTeam.PrimaryColour, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ColorToSolidColorBrushConverter}}" />

                                <TextBlock Text="{Binding Message, Converter={StaticResource UppercaseConverter}}"
                                           d:Text="CONVERSIONS"
                                           Style="{StaticResource HUD_SemiBold}"
                                           FontSize="14"
                                           Margin="14,0,8,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SecondMessage, Converter={StaticResource UppercaseConverter}}"
                                           d:Text="1"
                                           Style="{StaticResource ScoreBoardMaison}"
                                           FontSize="18" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <b:Interaction.Triggers>

                    <!--Intro: same timing as the player plate, then the rows drop in-->
                    <b:PropertyChangedTrigger Binding="{Binding RevealKey}">
                        <b:ControlStoryboardAction>
                            <b:ControlStoryboardAction.Storyboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="StatsNumberBox"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="StatsNumberBox"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0.4" To="1" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="StatsNumberBox"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0.4" To="1" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StatsCard"
                                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-370" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="-370" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="0">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StatsHeaderText"
                                                                   Storyboard.TargetProperty="Opacity">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StatsRows"
                                                                   Storyboard.TargetProperty="Opacity">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="0" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StatsRows"
                                                                   Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-14" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="-14" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.75" Value="0">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </b:ControlStoryboardAction.Storyboard>
                        </b:ControlStoryboardAction>
                    </b:PropertyChangedTrigger>

                    <!--Outro, 0.3s (var_0_outro_time in nvm_playerstatisticshud.lua): rows go first,
