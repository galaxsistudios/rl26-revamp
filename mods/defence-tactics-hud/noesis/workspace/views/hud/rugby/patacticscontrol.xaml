<UserControl x:Class="Workspace.Views.HUD.Rugby.paTacticsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Workspace.Views.HUD.Rugby"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:paEx="clr-namespace:paNoesisExtensions"
             xmlns:vm="clr-namespace:Workspace.ViewModels.HUD.Rugby"
             xmlns:controls="clr-namespace:Workspace.Controls"
             Visibility="{Binding TacticsVisibility, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
             mc:Ignorable="d">

    <d:UserControl.DataContext>
        <vm:NVMTactics />
    </d:UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Resources/TacticsIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="controls:paListBoxItem"
                   x:Key="TacticsListBoxItem">
                <Setter Property="Focusable" Value="False"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:paListBoxItem">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"
                                                Value="{StaticResource RLBlack80}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=controls:paListBoxItem}}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource RLWhite}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Confirmed}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource RLGreen}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemCommand"
                        Value="{Binding Command}" />
                <Setter Property="HighlightCommand"
                        Value="{Binding HighlightedCommand}" />
            </Style>


            <DataTemplate DataType="{x:Type vm:NVMForesightItem}">
                <Grid Width="63">
                    <Viewbox Width="40"
                             Height="40"
                             StretchDirection="DownOnly">

                        <ContentControl Style="{StaticResource ForesightSelector}" Focusable="False"/>
                    </Viewbox>
                </Grid>
            </DataTemplate>


            <DataTemplate DataType="{x:Type vm:NVMTacticItem}">
                <Grid>
                    <Viewbox Width="63">
                        <Path Data="{StaticResource FieldGeo}"
                              Style="{StaticResource PS}"
                              Fill="Transparent"
                              StrokeThickness="5"
                              Opacity="0.1" />
                    </Viewbox>

                    <Viewbox Width="53"
                             StretchDirection="DownOnly">
                        <ContentControl Style="{StaticResource TacticSelector}" Focusable="False"/>
                    </Viewbox>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>


    <controls:baResolutionScaledViewbox DisableWidthScaling="True">

        <!-- defence-tactics-hud: same design width as the player plate (Width 350 in PlayerPlateTemplate) -->
        <Border Background="{StaticResource RLBlack}"
                Width="350"
                Height="100"
                BorderBrush="{StaticResource ButtonBorderBrush}"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="1"
                           Text="{Binding Header, Mode=TwoWay, Converter={StaticResource UppercaseConverter}}"
                           Style="{StaticResource HUD_Bold}"
                           FontSize="18"
                           Margin="0,5,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />


                <Grid Margin="5"
                      Grid.Row="1"
                      ClipToBounds="True">
                    <Border BorderBrush="{StaticResource ButtonBorderBrush}"
                            BorderThickness="0.5">

                        <Border Background="{StaticResource RLWhite05}"
                                BorderBrush="{StaticResource RLWhite30}"
                                BorderThickness="3">
                            <Border.Effect>
                                <BlurEffect Radius="15" />
                            </Border.Effect>
                        </Border>
                    </Border>

                    <controls:paListBox ItemContainerStyle="{StaticResource TacticsListBoxItem}"
                                        ItemsSource="{Binding Items}"
                                        SelectedIndex="{Binding Index}" Focusable="False">
                        <controls:paListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </controls:paListBox.ItemsPanel>
                    </controls:paListBox>


                </Grid>
            </Grid>
        </Border>

    </controls:baResolutionScaledViewbox>
</UserControl>
