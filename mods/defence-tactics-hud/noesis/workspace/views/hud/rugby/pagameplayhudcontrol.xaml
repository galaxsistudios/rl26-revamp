<UserControl x:Class="Workspace.Views.HUD.Rugby.paGameplayHudControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
             xmlns:paEx="clr-namespace:paNoesisExtensions"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:enums="clr-namespace:Workspace.Enums"
             xmlns:controls="clr-namespace:Workspace.Controls"
             xmlns:views="clr-namespace:Workspace.Views.HUD.Rugby"
             xmlns:vm="clr-namespace:Workspace.ViewModels.HUD.Rugby"
             mc:Ignorable="d"
             x:Name="GameplayHudGrid"
             Focusable="False"
             Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverterHidden}}"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             d:DataContext="{d:DesignInstance Type={x:Type vm:paNVMGameplayHud}, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="../../../Resources/StyleThemes/HUD/SuperLeagueHUDResources.xaml" />-->
                <!--<ResourceDictionary Source="../../../Resources/StyleThemes/HUD/StateOfOriginHUDResources.xaml" />-->
                <!--<ResourceDictionary Source="../../../Resources/StyleThemes/HUD/QLDCupHUDResources.xaml" />-->
                <!--<d:ResourceDictionary Source="../../../Resources/StyleThemes/HUD/DefaultHUDResources.xaml" />-->
                <d:ResourceDictionary Source="../../../Resources/StyleThemes/HUD/RLWC26HUDResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ImageSource x:Key="SmallOverlay">../../../Images/textures/RLWC_HudOverlay_Large.png</ImageSource>
            <ImageSource x:Key="LargeOverlay">../../../Images/textures/RLWC_HudOverlay_Large.png</ImageSource>

            <Color x:Key="NeedAResourceForTheming">#800813</Color>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">

        <Grid.Resources>

            <ResourceDictionary>
                <!--Jarryd: Dump these animations?-->
                <Storyboard x:Key="Intro">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                   Storyboard.TargetName="BigAntScreenRoot">
                        <EasingDoubleKeyFrame KeyTime="0"
                                              Value="0" />
                        <EasingDoubleKeyFrame KeyTime="0:0:1"
                                              Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>

                <Storyboard x:Key="Outro">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                   Storyboard.TargetName="BigAntScreenRoot">
                        <EasingDoubleKeyFrame KeyTime="0"
                                              Value="1" />
                        <EasingDoubleKeyFrame KeyTime="0:0:1"
                                              Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>

                <sys:Double x:Key="SafeAreaPercentSingle">0.05</sys:Double>

                <!--For Debug Buttons Only-->
                <d:Style TargetType="{x:Type Button}">
                    <Setter Property="Width"
                            Value="128" />
                    <Setter Property="Height"
                            Value="32" />
                    <Setter Property="Margin"
                            Value="4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="DebugBorder"
                                        BorderThickness="2"
                                        BorderBrush="Black"
                                        Background="AliceBlue">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               FontSize="12"
                                               Foreground="Black"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </d:Style>

            </ResourceDictionary>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Source={StaticResource SafeAreaPercentSingle}, Converter={StaticResource GridLengthConverter} }" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{Binding Source={StaticResource SafeAreaPercentSingle}, Converter={StaticResource GridLengthConverter} }" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={StaticResource SafeAreaPercentSingle}, Converter={StaticResource GridLengthConverter} }" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{Binding Source={StaticResource SafeAreaPercentSingle}, Converter={StaticResource GridLengthConverter} }" />
        </Grid.RowDefinitions>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <!--This is a good place to initiate some animations-->
                <!-- <BeginStoryboard Storyboard="{StaticResource Intro}"/> -->
            </EventTrigger>
        </Grid.Triggers>




        <Grid Grid.Row="1"
              Grid.Column="1"
              Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="GridSizeGroup" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"
                                  SharedSizeGroup="GridSizeGroup" />
            </Grid.ColumnDefinitions>

            <!--score hud-->
            <Grid HorizontalAlignment="Left"
                  VerticalAlignment="top"
                  x:Name="ScoreCardGrid"
                  Height="Auto"
                  Width="Auto">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!--ThemeOption="{Binding ThemeOption}"-->
                <views:paScoreCardControl x:Name="ScoreCardControl"
                                          ShowMatchState="{Binding ShowMatchState}"
                                          isFemale="{Binding RelativeSource={RelativeSource AncestorType=views:paGameplayHudControl}, Path=DataContext.isFemale}"
                                          d:ThemeOption="Count"
                                          MatchStateMessage="{Binding MatchStateMessage}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          DataContext="{Binding ScoreCardDC}"
                                          Template="{DynamicResource ScoreCardTemplate}">

                </views:paScoreCardControl>


            </Grid>


            <views:paCaptainsChallengeControl Grid.Column="0"
                                              Grid.Row="1"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top" 
                                              DataContext="{Binding CaptainsChallengeDC}"/>

            <!--positioning of lineout control is done in the control itself, using a style-->

            <!--<views:paPreLineoutDecisionControl Grid.Row="2"
                                               DataContext="{Binding LineOutDecisionDC}"
                                               isLeftAligned="{Binding isLeftAligned}"
                                               d:Template="{StaticResource LeftAlignedTemplate}"
                                               d:isLeftAligned="True"
                                               d:Margin="50,0,0,20"
                                               d:HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />-->
            <Grid Grid.Column="1">
                <Border x:Name="ClockBorder" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <controls:baResolutionScaledViewbox>
                        <views:paClockControl TimeInSeconds="{Binding TimeInSeconds}"
                              HorizontalAlignment="Center"
                              DataContext="{Binding ClockDC}">

                        </views:paClockControl>
                    </controls:baResolutionScaledViewbox>
                </Border>
            </Grid>

            <!--Referee-->
            <Grid x:Name="RefereeCallGrid"
                  Grid.Row="3"
                  Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <views:paPenaltyControl Width="Auto"
                            Height="Auto"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            DataContext="{Binding PenaltySelectDC}" />

                <!--<views:paRefereeCallControl Width="Auto"
                                            Height="Auto"
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            DataContext="{Binding RefereeHudDC}" />-->   

            </Grid>


            <!--Replacements-->





            <!--Left HUD stack grid-->
            <Grid Grid.Row="1"
                  x:Name="LeftHUDElements"
                  HorizontalAlignment="Left">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <views:paMatchReportAlertControl HorizontalAlignment="Center" 
                                                 Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                 Grid.Row="1" 
                                                 Margin="0,25"
                                                 DataContext="{Binding MatchReportAlertDC}"
                                                 d:DataContext="{d:DesignInstance Type={x:Type vm:NVMMatchReportAlert}, IsDesignTimeCreatable=True}" />

                <Grid Grid.Row="2"
                      Margin="0,25"
                      MinWidth="{Binding ElementName=LeftPlayerPlateGrid, Path=ActualWidth}"
                      HorizontalAlignment="Left">

                    <views:PlayerStatisticsControl x:Name="HomePlayerStatisticsControl"
                                                   DataContext="{Binding HomePlayerStatisticsDC}"
                                                   Template="{DynamicResource PlayerStatisticsTemplate}"/>

                    <views:paReplacementControl x:Name="HomeSubstitutionHud"
                                                Grid.Row="2"
                                                Margin="0,25"
                                                HorizontalContentAlignment="Left"
                                                DataContext="{Binding HomeSubstitutionHudDC}"
                                                d:DataContext="{d:DesignInstance Type=vm:paNVMReplacement, IsDesignTimeCreatable=True}" />
                </Grid>


                <StackPanel Grid.Row="3"
                            d:Visibility="Visible">

                    <views:paInputHintStackControl HorizontalAlignment="Left"
                                                   VerticalAlignment="Bottom"
                                                   d:Visibility="Collapsed"
                                                   DataContext="{Binding HomeInputHintStackDC}" />

                    <!--<Grid x:Name="LeftGamepadGrid"
                          HorizontalAlignment="Left"
                          Grid.Row="2"
                          Visibility="{Binding HomeGamepadFaceHintDC.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Width="{Binding ElementName=LeftPlayerPlateGrid, Path=ActualWidth}"
                          Height="{Binding ElementName=LeftGamepadControl, Path=ActualHeight}">

                        <Canvas Width="{Binding ElementName=LeftGamepadControl, Path=ActualWidth}"
                                Height="{Binding ElementName=LeftGamepadControl, Path=ActualHeight}"
                                HorizontalAlignment="Center"
                                d:Width="470"
                                d:Height="160">

                            <views:paGamepadFaceButtonHintControl x:Name="LeftGamepadControl"
                                                                  IsTopActive="{Binding IsTopActive}"
                                                                  IsRightActive="{Binding IsRightActive}"
                                                                  IsBottomActive="{Binding IsBottomActive}"
                                                                  IsLeftActive="{Binding IsLeftActive}"
                                                                  HintTop="{Binding HintTop}"
                                                                  HintRight="{Binding HintRight}"
                                                                  HintBottom="{Binding HintBottom}"
                                                                  HintLeft="{Binding HintLeft}"
                                                                  isLeftAligned="True"
                                                                  HorizontalAlignment="Center"
                                                                  DataContext="{Binding HomeGamepadFaceHintDC}"
                                                                  d:IsLeftActive="True"
                                                                  d:IsRightActive="True"
                                                                  d:IsBottomActive="True"
                                                                  d:IsTopActive="True" />
                        </Canvas>

                    </Grid>-->
                </StackPanel>

                <StackPanel Grid.Row="4" d:Visibility="Collapsed"
                      HorizontalAlignment="Left"
                      >
                    <views:paTacticsControl DataContext="{Binding HomeTacticsDC}"
                                            HorizontalAlignment="Left"
                                            Margin="0,25" />
                    <!-- defence-tactics-hud: defence tactic label just above the player plate (human-controlled side, while defending in live play) -->
                    <controls:baResolutionScaledViewbox HorizontalAlignment="Left"
                                                        Margin="0,0,0,8"
                                                        DataContext="{Binding HomeTacticsDC}">
                        <!-- Same design width as the tactics window and the player plate (350) -->
                        <Border Width="350"
                                CornerRadius="3">
                            <!-- Faded in while this side is defending in live play, out otherwise -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DefenceTacticVisible}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Duration="0:0:0.25" To="1" Storyboard.TargetProperty="Opacity" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Duration="0:0:0.25" To="0" Storyboard.TargetProperty="Opacity" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Border Background="{StaticResource RLBlack80}" CornerRadius="3" />
                                <!-- Last-tackle warning: red layer flashing in and out -->
                                <Border Background="#D62828" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefenceTacticAlert}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Duration="0:0:0.45" From="1" To="0.25" Storyboard.TargetProperty="Opacity" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Grid Margin="8,4,12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- D-pad: the lit arm is the button for the active tactic (Down during the warning) -->
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <Rectangle Width="6" Height="6" Fill="{StaticResource RLWhite30}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Rectangle Width="6" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="1" RadiusY="1">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource RLWhite30}" />
                                                    <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefenceTacticKey}" Value="Compress">
                                                        <Setter Property="Fill" Value="{StaticResource RLWhite}" />
                                                    </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Rectangle Width="6" Height="7" HorizontalAlignment="Center" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource RLWhite30}" />
                                                    <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefenceTacticKey}" Value="DropWings">
                                                        <Setter Property="Fill" Value="{StaticResource RLWhite}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DefenceTacticAlert}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource RLWhite}" />
                                                    </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Rectangle Width="7" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" RadiusX="1" RadiusY="1">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource RLWhite30}" />
                                                    <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefenceTacticKey}" Value="SlideLeft">
                                                        <Setter Property="Fill" Value="{StaticResource RLWhite}" />
                                                    </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Rectangle Width="7" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" RadiusX="1" RadiusY="1">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource RLWhite30}" />
                                                    <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefenceTacticKey}" Value="SlideRight">
                                                        <Setter Property="Fill" Value="{StaticResource RLWhite}" />
                                                    </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DefenceTacticText, Converter={StaticResource UppercaseConverter}}"
                                               Foreground="{StaticResource RLWhite}"
                                               FontSize="16"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HUD_Bold}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefenceTacticAlert}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Viewbox Grid.Column="1"
                                             StretchDirection="DownOnly"
                                             HorizontalAlignment="Left"
                                             Margin="8,0,0,0"
                                             Visibility="{Binding DefenceTacticAlert, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                        <TextBlock Text="LAST TACKLE: PRESS DOWN TO SEND WINGERS BACK"
                                                   Style="{StaticResource HUD_Bold}"
                                                   Foreground="{StaticResource RLWhite}"
                                                   FontSize="16"
                                                   VerticalAlignment="Center" />
                                    </Viewbox>
                                </Grid>
                            </Grid>
                        </Border>
                    </controls:baResolutionScaledViewbox>
                </StackPanel>


                <Grid x:Name="LeftPlayerPlateGrid"
                      Grid.Row="5"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <views:paPlayerPlateControl x:Name="TopLeftPlayerPlate"
                                                VerticalAlignment="Top"
                                                IsOnBottom="False"
                                                d:Visibility="collapsed"
                                                Template="{DynamicResource PlayerPlateTemplate}"
                                                DataContext="{Binding PlayerPlateHomeTopDC}">

                    </views:paPlayerPlateControl>

                    <controls:baResolutionScaledViewbox x:Name="LeftSpacer"
                                                        MinHeight="15"
                                                        Grid.Row="1">
                        <Rectangle />
                    </controls:baResolutionScaledViewbox>

                    <views:paPlayerPlateControl x:Name="BottomLeftPlayerPlate"
                                                VerticalAlignment="Bottom"
                                                IsOnBottom="True"
                                                Template="{DynamicResource PlayerPlateTemplate}"
                                                Grid.Row="2"
                                                DataContext="{Binding PlayerPlateHomeBotDC}">
                    </views:paPlayerPlateControl>

                </Grid>
            </Grid>



            <!--Right HUD stack grid-->
            <Grid Grid.Row="1"
                  Grid.Column="2"
                  x:Name="RightHUDElements"
                  HorizontalAlignment="Right">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <views:paMatchReportAlertControl HorizontalAlignment="Center"
                                                 Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityInvertedConverter}, FallbackValue=Collapsed}"
                                                 Grid.Row="1"
                                                 Margin="0,25"
                                                 DataContext="{Binding MatchReportAlertDC}"
                                                 d:DataContext="{d:DesignInstance Type={x:Type vm:NVMMatchReportAlert}, IsDesignTimeCreatable=True}" />

                <Grid Grid.Row="2"
                      Margin="0,25"
                      MinWidth="{Binding ElementName=LeftPlayerPlateGrid, Path=ActualWidth}"
                      HorizontalAlignment="Right">

                    <views:PlayerStatisticsControl x:Name="AwayPlayerStatisticsControl"
                                                   DataContext="{Binding AwayPlayerStatisticsDC}"
                                                   Template="{DynamicResource PlayerStatisticsTemplate}" />

                    <views:paReplacementControl x:Name="AwaySubstitutionHud"
                                                Grid.Row="2"
                                                Margin="0,25"
                                                d:Visibility="Visible"
                                                Grid.Column="2"
                                                HorizontalContentAlignment="Right"
                                                DataContext="{Binding AwaySubstitutionHudDC}"
                                                d:DataContext="{d:DesignInstance Type=vm:paNVMReplacement, IsDesignTimeCreatable=True}" />

                </Grid>

                <StackPanel Grid.Row="4" 
                      HorizontalAlignment="Right" d:Visibility="Collapsed">
                    <views:paTacticsControl DataContext="{Binding AwayTacticsDC}"
                                            HorizontalAlignment="Right"
                                            Margin="0,25" />
                    <!-- defence-tactics-hud: defence tactic label just above the player plate (human-controlled side, while defending in live play) -->
                    <controls:baResolutionScaledViewbox HorizontalAlignment="Right"
                                                        Margin="0,0,0,8"
                                                        DataContext="{Binding AwayTacticsDC}">
                        <!-- Same design width as the tactics window and the player plate (350) -->
                        <Border Width="350"
                                CornerRadius="3">
                            <!-- Faded in while this side is defending in live play, out otherwise -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DefenceTacticVisible}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Duration="0:0:0.25" To="1" Storyboard.TargetProperty="Opacity" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Duration="0:0:0.25" To="0" Storyboard.TargetProperty="Opacity" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Border Background="{StaticResource RLBlack80}" CornerRadius="3" />
                                <!-- Last-tackle warning: red layer flashing in and out -->
                                <Border Background="#D62828" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefenceTacticAlert}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Duration="0:0:0.45" From="1" To="0.25" Storyboard.TargetProperty="Opacity" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Grid Margin="8,4,12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- D-pad: the lit arm is the button for the active tactic (Down during the warning) -->
                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                        <Rectangle Width="6" Height="6" Fill="{StaticResource RLWhite30}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Rectangle Width="6" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="1" RadiusY="1">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource RLWhite30}" />
                                                    <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefenceTacticKey}" Value="Compress">
                                                        <Setter Property="Fill" Value="{StaticResource RLWhite}" />
                                                    </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Rectangle Width="6" Height="7" HorizontalAlignment="Center" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource RLWhite30}" />
                                                    <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefenceTacticKey}" Value="DropWings">
                                                        <Setter Property="Fill" Value="{StaticResource RLWhite}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DefenceTacticAlert}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource RLWhite}" />
                                                    </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Rectangle Width="7" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" RadiusX="1" RadiusY="1">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource RLWhite30}" />
                                                    <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefenceTacticKey}" Value="SlideLeft">
                                                        <Setter Property="Fill" Value="{StaticResource RLWhite}" />
                                                    </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Rectangle Width="7" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" RadiusX="1" RadiusY="1">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource RLWhite30}" />
                                                    <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefenceTacticKey}" Value="SlideRight">
                                                        <Setter Property="Fill" Value="{StaticResource RLWhite}" />
                                                    </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DefenceTacticText, Converter={StaticResource UppercaseConverter}}"
                                               Foreground="{StaticResource RLWhite}"
                                               FontSize="16"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HUD_Bold}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefenceTacticAlert}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Viewbox Grid.Column="1"
                                             StretchDirection="DownOnly"
                                             HorizontalAlignment="Left"
                                             Margin="8,0,0,0"
                                             Visibility="{Binding DefenceTacticAlert, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                        <TextBlock Text="LAST TACKLE: PRESS DOWN TO SEND WINGERS BACK"
                                                   Style="{StaticResource HUD_Bold}"
                                                   Foreground="{StaticResource RLWhite}"
                                                   FontSize="16"
                                                   VerticalAlignment="Center" />
                                    </Viewbox>
                                </Grid>
                            </Grid>
                        </Border>
                    </controls:baResolutionScaledViewbox>
                </StackPanel>

                <StackPanel Grid.Row="3"
                            d:Visibility="Visible">

                    <views:paInputHintStackControl VerticalAlignment="Bottom"
                                                   HorizontalAlignment="Right"
                                                   d:Visibility="Collapsed"
                                                   DataContext="{Binding AwayInputHintStackDC}" />

                    <!--<Grid x:Name="RightGamepadGrid"
                          HorizontalAlignment="Left"
                          Grid.Column="2"
                          Grid.Row="3"
                          Visibility="{Binding AwayGamepadFaceHintDC.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Width="{Binding ElementName=RightPlayerPlateGrid, Path=ActualWidth}"
                          Height="{Binding ElementName=RightGamepadControl, Path=ActualHeight}">

                        <Canvas Width="{Binding ElementName=RightGamepadControl, Path=ActualWidth}"
                                Height="{Binding ElementName=RightGamepadControl, Path=ActualHeight}"
                                HorizontalAlignment="Center"
                                d:Width="470"
                                d:Height="160">

                            <views:paGamepadFaceButtonHintControl x:Name="RightGamepadControl"
                                                                  IsTopActive="{Binding IsTopActive}"
                                                                  IsRightActive="{Binding IsRightActive}"
                                                                  IsBottomActive="{Binding IsBottomActive}"
                                                                  IsLeftActive="{Binding IsLeftActive}"
                                                                  d:IsLeftActive="True"
                                                                  d:IsRightActive="True"
                                                                  d:IsBottomActive="True"
                                                                  d:IsTopActive="True"
                                                                  HintTop="{Binding HintTop}"
                                                                  HintRight="{Binding HintRight}"
                                                                  HintBottom="{Binding HintBottom}"
                                                                  HintLeft="{Binding HintLeft}"
                                                                  isLeftAligned="True"
                                                                  DataContext="{Binding AwayGamepadFaceHintDC}"
                                                                  Margin="20,0,-20,0">

                            </views:paGamepadFaceButtonHintControl>

                        </Canvas>
                    </Grid>-->
                </StackPanel>


                <Grid x:Name="RightPlayerPlateGrid"
                      Grid.Row="5"
                      HorizontalAlignment="Right">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <views:paPlayerPlateControl x:Name="TopRightPlayerPlate"
                                                VerticalAlignment="Top"
                                                IsOnBottom="False"
                                                Template="{DynamicResource PlayerPlateTemplate}"
                                                DataContext="{Binding PlayerPlateAwayTopDC}"
                                                d:Visibility="collapsed">
                    </views:paPlayerPlateControl>

                    <controls:baResolutionScaledViewbox x:Name="RightSpacer"
                                                        MinHeight="15"
                                                        Grid.Row="1">
                        <Rectangle />
                    </controls:baResolutionScaledViewbox>

                    <views:paPlayerPlateControl x:Name="BottomRightPlayerPlate"
                                                VerticalAlignment="Bottom"
                                                IsOnBottom="True"
                                                Template="{DynamicResource PlayerPlateTemplate}"
                                                Grid.Row="2"
                                                DataContext="{Binding PlayerPlateAwayBotDC}">
                    </views:paPlayerPlateControl>

                </Grid>
            </Grid>



        </Grid>

        <d:StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Grid.ColumnSpan="4"
                      Grid.Row="1">
            <GroupBox Header="Score Card Debug"
                      RenderTransformOrigin="0.5,0.5">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Toggle Match State"
                            Click="BLEND_ScoreHud_Matchstate_Click" />
                    <Button Content="Small Notification"
                            Click="BLEND_ScoreHud_NotificationButton_Click1" />
                    <Button Content="Large Notification"
                            Click="BLEND_ScoreHud_NotificationButton_Click2" />
                    <Button Content="Card Notification"
                            Click="BLEND_ScoreHud_NotificationButton_Click3" />

                    <d:ComboBox x:Name="ThemeComboBox"
                                Text="Select Theme"
                                Height="32"
                                Width="256"
                                Margin="8"
                                SelectedItem="{Binding GameplayType}"
                                ItemsSource="{Binding Path=RugbyThemeOptions, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type views:paGameplayHudControl}}}"
                                SelectionChanged="Theme_Changed" />

                    <ComboBox x:Name="InGameThemeComboBox"
                              Text="Select Theme"
                              Height="32"
                              Width="256"
                              Margin="8"
                              SelectedItem="{Binding GameplayType}"
                              ItemsSource="{Binding RugbyThemeOptions}"
                              SelectionChanged="Theme_Changed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>


                    <!--SelectedItem="{Binding Path=ThemeOption, Mode=TwoWay, RelativeSource={ RelativeSource FindAncestor, AncestorType={x:Type local:paScoreCardControl}}}"
                                      ItemsSource="{Binding Path=RugbyThemeOptions, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:paScoreCardControl}}}" />-->
                </StackPanel>
                <GroupBox.RenderTransform>
                    <ScaleTransform ScaleX="0.5"
                                    ScaleY="0.5" />
                </GroupBox.RenderTransform>
            </GroupBox>

        </d:StackPanel>




    </Grid>

    <!--</Viewbox>-->
</UserControl>